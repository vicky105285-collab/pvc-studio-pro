<UserControl x:Class="PVCStudioPro.App.Controls.InteractiveCropCanvas"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006" 
             xmlns:d="http://schemas.microsoft.com/expression/blend/2008" 
             mc:Ignorable="d" 
             d:DesignHeight="600" d:DesignWidth="800"
             Background="#1E1E1E"
             ClipToBounds="True"
             Focusable="True"
             Loaded="OnLoaded"
             SizeChanged="OnSizeChanged"
             MouseWheel="OnMouseWheel"
             MouseDown="OnMouseDown"
             MouseMove="OnMouseMove"
             MouseUp="OnMouseUp"
             MouseLeave="OnMouseLeave">

    <Grid x:Name="RootGrid">
        <!-- Canvas containing the image and interactive overlay -->
        <Canvas x:Name="ViewportCanvas">
            <!-- Source Image -->
            <Image x:Name="SourceImg"
                   RenderOptions.BitmapScalingMode="HighQuality"
                   Stretch="Fill"
                   RenderTransformOrigin="0.5,0.5">
                <Image.RenderTransform>
                    <RotateTransform x:Name="SourceImgRotateTransform" Angle="0"/>
                </Image.RenderTransform>
            </Image>

            <!-- Dark Dimming Mask around crop box -->
            <Path x:Name="DimmingMaskPath"
                  Fill="#80000000"
                  IsHitTestVisible="False"/>

            <!-- Perspective Quad Polygon (when in perspective mode) -->
            <Polygon x:Name="PerspectivePolygon"
                     Stroke="#0078D4"
                     StrokeThickness="2"
                     Fill="#200078D4"
                     Visibility="Collapsed"/>

            <!-- Standard Crop Rectangle -->
            <Rectangle x:Name="CropRectVisual"
                       Stroke="#0078D4"
                       StrokeThickness="2"
                       Fill="#150078D4"
                       Cursor="SizeAll"/>

            <!-- Rule of Thirds Guide Lines -->
            <Line x:Name="GuideLineH1" Stroke="#500078D4" StrokeThickness="1" StrokeDashArray="4 2" IsHitTestVisible="False"/>
            <Line x:Name="GuideLineH2" Stroke="#500078D4" StrokeThickness="1" StrokeDashArray="4 2" IsHitTestVisible="False"/>
            <Line x:Name="GuideLineV1" Stroke="#500078D4" StrokeThickness="1" StrokeDashArray="4 2" IsHitTestVisible="False"/>
            <Line x:Name="GuideLineV2" Stroke="#500078D4" StrokeThickness="1" StrokeDashArray="4 2" IsHitTestVisible="False"/>

            <!-- 8 Drag Handles (Standard Rectangle Mode) -->
            <!-- Corners (Circles) -->
            <Ellipse x:Name="HandleNW" Width="14" Height="14" Fill="#0078D4" Stroke="White" StrokeThickness="2" Cursor="SizeNWSE"/>
            <Ellipse x:Name="HandleNE" Width="14" Height="14" Fill="#0078D4" Stroke="White" StrokeThickness="2" Cursor="SizeNESW"/>
            <Ellipse x:Name="HandleSE" Width="14" Height="14" Fill="#0078D4" Stroke="White" StrokeThickness="2" Cursor="SizeNWSE"/>
            <Ellipse x:Name="HandleSW" Width="14" Height="14" Fill="#0078D4" Stroke="White" StrokeThickness="2" Cursor="SizeNESW"/>

            <!-- Edges (Squares) -->
            <Rectangle x:Name="HandleN" Width="12" Height="12" Fill="#0078D4" Stroke="White" StrokeThickness="2" Cursor="SizeNS"/>
            <Rectangle x:Name="HandleE" Width="12" Height="12" Fill="#0078D4" Stroke="White" StrokeThickness="2" Cursor="SizeWE"/>
            <Rectangle x:Name="HandleS" Width="12" Height="12" Fill="#0078D4" Stroke="White" StrokeThickness="2" Cursor="SizeNS"/>
            <Rectangle x:Name="HandleW" Width="12" Height="12" Fill="#0078D4" Stroke="White" StrokeThickness="2" Cursor="SizeWE"/>

            <!-- 4 Perspective Quad Handles (Perspective Mode) -->
            <Ellipse x:Name="CornerHandle1" Width="16" Height="16" Fill="#FFB900" Stroke="White" StrokeThickness="2" Cursor="Cross" Visibility="Collapsed"/>
            <Ellipse x:Name="CornerHandle2" Width="16" Height="16" Fill="#FFB900" Stroke="White" StrokeThickness="2" Cursor="Cross" Visibility="Collapsed"/>
            <Ellipse x:Name="CornerHandle3" Width="16" Height="16" Fill="#FFB900" Stroke="White" StrokeThickness="2" Cursor="Cross" Visibility="Collapsed"/>
            <Ellipse x:Name="CornerHandle4" Width="16" Height="16" Fill="#FFB900" Stroke="White" StrokeThickness="2" Cursor="Cross" Visibility="Collapsed"/>
        </Canvas>

        <!-- Floating HUD overlay for Zoom and Sub-pixel Coordinates -->
        <Border HorizontalAlignment="Right" VerticalAlignment="Bottom"
                Background="#CC000000" CornerRadius="4" Padding="8,4" Margin="12"
                IsHitTestVisible="False">
            <StackPanel Orientation="Horizontal">
                <TextBlock x:Name="CoordsHudText" Text="X: 0 Y: 0 | 0 x 0 px" Foreground="White" FontSize="11" FontFamily="Consolas" Margin="0,0,12,0"/>
                <TextBlock x:Name="ZoomHudText" Text="100%" Foreground="#00B0FF" FontSize="11" FontWeight="Bold"/>
            </StackPanel>
        </Border>

        <!-- Interactive Live Cursor Magnifier Loupe (Auto-zooms where cursor is placed) -->
        <Border x:Name="MagnifierLoupe"
                Width="120" Height="120"
                CornerRadius="60"
                BorderBrush="#0078D4"
                BorderThickness="2.5"
                HorizontalAlignment="Left" VerticalAlignment="Top"
                IsHitTestVisible="False"
                Visibility="Collapsed"
                ClipToBounds="True">
            <Border.Effect>
                <DropShadowEffect BlurRadius="16" ShadowDepth="4" Direction="270" Color="#000000" Opacity="0.5"/>
            </Border.Effect>
            <Grid Background="#1E1E1E" ClipToBounds="True">
                <Canvas x:Name="LoupeCanvas" Width="120" Height="120" ClipToBounds="True">
                    <Image x:Name="LoupeImage"
                           RenderOptions.BitmapScalingMode="NearestNeighbor"
                           Stretch="Fill"/>
                </Canvas>
                <!-- Reticle Crosshairs -->
                <Line X1="0" Y1="60" X2="120" Y2="60" Stroke="#0078D4" StrokeThickness="1" StrokeDashArray="3 2" Opacity="0.85"/>
                <Line X1="60" Y1="0" X2="60" Y2="120" Stroke="#0078D4" StrokeThickness="1" StrokeDashArray="3 2" Opacity="0.85"/>
                <Ellipse Width="8" Height="8" Stroke="#F59E0B" StrokeThickness="1.5" HorizontalAlignment="Center" VerticalAlignment="Center"/>
                <!-- Sub-pixel Zoom Badge -->
                <Border Background="#DD000000" CornerRadius="3" Padding="4,1" HorizontalAlignment="Center" VerticalAlignment="Bottom" Margin="0,0,0,6">
                    <TextBlock x:Name="LoupeInfoText" Text="3x MAG" Foreground="White" FontSize="9.5" FontWeight="Bold" FontFamily="Consolas"/>
                </Border>
            </Grid>
        </Border>
    </Grid>
</UserControl>
