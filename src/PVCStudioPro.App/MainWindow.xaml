<ui:FluentWindow x:Class="PVCStudioPro.App.MainWindow"
                   xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
                   xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
                   xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
                   xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
                   xmlns:ui="http://schemas.lepo.co/wpfui/2022/xaml"
                   xmlns:vm="clr-namespace:PVCStudioPro.App.ViewModels"
                   xmlns:views="clr-namespace:PVCStudioPro.App.Views"
                   mc:Ignorable="d"
                   Title="{DynamicResource AppTitle}"
                   Height="900" Width="1440"
                   MinHeight="720" MinWidth="1100"
                   WindowStartupLocation="CenterScreen"
                   ExtendsContentIntoTitleBar="True"
                   WindowBackdropType="Mica">

    <Window.Resources>
        <!-- 14 Workspace DataTemplates -->
        <DataTemplate DataType="{x:Type vm:DashboardViewModel}">
            <views:DashboardView/>
        </DataTemplate>
        <DataTemplate DataType="{x:Type vm:CardPrintViewModel}">
            <views:CardPrintView/>
        </DataTemplate>
        <DataTemplate DataType="{x:Type vm:PhotoStudioViewModel}">
            <views:PhotoStudioView/>
        </DataTemplate>
        <DataTemplate DataType="{x:Type vm:DocumentProcessingViewModel}">
            <views:DocumentProcessingView/>
        </DataTemplate>
        <DataTemplate DataType="{x:Type vm:BatchProcessingViewModel}">
            <views:BatchProcessingView/>
        </DataTemplate>
        <DataTemplate DataType="{x:Type vm:PrintCenterViewModel}">
            <views:PrintCenterView/>
        </DataTemplate>
        <DataTemplate DataType="{x:Type vm:PrinterTrayManagerViewModel}">
            <views:PrinterTrayManagerView/>
        </DataTemplate>
        <DataTemplate DataType="{x:Type vm:CalibrationViewModel}">
            <views:CalibrationView/>
        </DataTemplate>
        <DataTemplate DataType="{x:Type vm:TemplateManagerViewModel}">
            <views:TemplateManagerView/>
        </DataTemplate>
        <DataTemplate DataType="{x:Type vm:BusinessProfileViewModel}">
            <views:BusinessProfileView/>
        </DataTemplate>
        <DataTemplate DataType="{x:Type vm:BusinessLedgerViewModel}">
            <views:BusinessLedgerView/>
        </DataTemplate>
        <DataTemplate DataType="{x:Type vm:ReportsAnalyticsViewModel}">
            <views:ReportsAnalyticsView/>
        </DataTemplate>
        <DataTemplate DataType="{x:Type vm:BackupRestoreViewModel}">
            <views:BackupRestoreView/>
        </DataTemplate>
        <DataTemplate DataType="{x:Type vm:SettingsViewModel}">
            <views:SettingsView/>
        </DataTemplate>
    </Window.Resources>

    <Grid>
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="*"/>
        </Grid.RowDefinitions>

        <!-- Top TitleBar with App Branding, Active Workspace, and Quick Action Buttons -->
        <ui:TitleBar Grid.Row="0" Title="{DynamicResource AppTitle}">
            <ui:TitleBar.Header>
                <Grid VerticalAlignment="Center" Margin="12,0,0,0">
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="Auto"/>
                        <ColumnDefinition Width="Auto"/>
                        <ColumnDefinition Width="*"/>
                        <ColumnDefinition Width="Auto"/>
                    </Grid.ColumnDefinitions>

                    <!-- Active Workspace Breadcrumb -->
                    <Border Grid.Column="0" Background="{DynamicResource NeutralSurfaceBrush}" CornerRadius="4" Padding="8,2" Margin="0,0,16,0">
                        <TextBlock Text="{Binding ActiveWorkspaceTitle}" FontWeight="SemiBold" FontSize="11" Foreground="{DynamicResource TextSecondaryBrush}"/>
                    </Border>

                    <!-- Theme Toggle -->
                    <ui:Button Grid.Column="1" Command="{Binding ToggleThemeCommand}" Content="{Binding CurrentTheme, StringFormat='Theme: {0}'}" Height="28" Padding="10,0" FontSize="11" FontWeight="SemiBold" CornerRadius="4" Background="{DynamicResource NeutralSurfaceBrush}" Margin="0,0,8,0"/>

                    <!-- Language Switcher -->
                    <ui:Button Grid.Column="3" Command="{Binding ToggleLanguageCommand}" Content="{Binding LanguageButtonText}" Height="28" Padding="12,0" FontSize="11" FontWeight="SemiBold" CornerRadius="4" Style="{DynamicResource PrimaryActionButtonStyle}"/>
                </Grid>
            </ui:TitleBar.Header>
        </ui:TitleBar>

        <!-- Main Body: Navigation Sidebar + Workspace Content -->
        <Grid Grid.Row="1">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="Auto"/>
                <ColumnDefinition Width="*"/>
            </Grid.ColumnDefinitions>

            <!-- Fluent Navigation View (14 Workspaces Organized in 4 Core Modules) -->
            <ui:NavigationView Grid.Column="0" PaneDisplayMode="Left" OpenPaneLength="250" IsBackButtonVisible="Collapsed">
                <ui:NavigationView.MenuItems>
                    <!-- SECTION 1: PRODUCTION -->
                    <ui:NavigationViewItemHeader Text="PRODUCTION WORKFLOW" Margin="4,8,4,4"/>

                    <ui:NavigationViewItem Content="{DynamicResource NavDashboard}" TargetPageType="{x:Type views:DashboardView}" Command="{Binding NavigateCommand}" CommandParameter="Dashboard">
                        <ui:NavigationViewItem.Icon>
                            <ui:SymbolIcon Symbol="AppGeneric24" />
                        </ui:NavigationViewItem.Icon>
                    </ui:NavigationViewItem>

                    <ui:NavigationViewItem Content="{DynamicResource NavCardPrint}" TargetPageType="{x:Type views:CardPrintView}" Command="{Binding NavigateCommand}" CommandParameter="Cards">
                        <ui:NavigationViewItem.Icon>
                            <ui:SymbolIcon Symbol="Document24" />
                        </ui:NavigationViewItem.Icon>
                    </ui:NavigationViewItem>

                    <ui:NavigationViewItem Content="{DynamicResource NavPhotoStudio}" TargetPageType="{x:Type views:PhotoStudioView}" Command="{Binding NavigateCommand}" CommandParameter="Photo">
                        <ui:NavigationViewItem.Icon>
                            <ui:SymbolIcon Symbol="Image24" />
                        </ui:NavigationViewItem.Icon>
                    </ui:NavigationViewItem>

                    <ui:NavigationViewItem Content="{DynamicResource NavDocProcessing}" TargetPageType="{x:Type views:DocumentProcessingView}" Command="{Binding NavigateCommand}" CommandParameter="DocProcessing">
                        <ui:NavigationViewItem.Icon>
                            <ui:SymbolIcon Symbol="Crop24" />
                        </ui:NavigationViewItem.Icon>
                    </ui:NavigationViewItem>

                    <ui:NavigationViewItem Content="{DynamicResource NavBatchProcessing}" TargetPageType="{x:Type views:BatchProcessingView}" Command="{Binding NavigateCommand}" CommandParameter="Batch">
                        <ui:NavigationViewItem.Icon>
                            <ui:SymbolIcon Symbol="FolderZip24" />
                        </ui:NavigationViewItem.Icon>
                    </ui:NavigationViewItem>

                    <!-- SECTION 2: HARDWARE & PRINTING -->
                    <ui:NavigationViewItemHeader Text="HARDWARE &amp; PRINTING" Margin="4,12,4,4"/>

                    <ui:NavigationViewItem Content="{DynamicResource NavPrintCenter}" TargetPageType="{x:Type views:PrintCenterView}" Command="{Binding NavigateCommand}" CommandParameter="PrintCenter">
                        <ui:NavigationViewItem.Icon>
                            <ui:SymbolIcon Symbol="Print24" />
                        </ui:NavigationViewItem.Icon>
                    </ui:NavigationViewItem>

                    <ui:NavigationViewItem Content="{DynamicResource NavPrinterTrayManager}" TargetPageType="{x:Type views:PrinterTrayManagerView}" Command="{Binding NavigateCommand}" CommandParameter="PrinterTray">
                        <ui:NavigationViewItem.Icon>
                            <ui:SymbolIcon Symbol="Board24" />
                        </ui:NavigationViewItem.Icon>
                    </ui:NavigationViewItem>

                    <ui:NavigationViewItem Content="{DynamicResource NavCalibration}" TargetPageType="{x:Type views:CalibrationView}" Command="{Binding NavigateCommand}" CommandParameter="Calibration">
                        <ui:NavigationViewItem.Icon>
                            <ui:SymbolIcon Symbol="Wrench24" />
                        </ui:NavigationViewItem.Icon>
                    </ui:NavigationViewItem>

                    <!-- SECTION 3: BUSINESS & TEMPLATES -->
                    <ui:NavigationViewItemHeader Text="BUSINESS &amp; TEMPLATES" Margin="4,12,4,4"/>

                    <ui:NavigationViewItem Content="{DynamicResource NavTemplateManager}" TargetPageType="{x:Type views:TemplateManagerView}" Command="{Binding NavigateCommand}" CommandParameter="Templates">
                        <ui:NavigationViewItem.Icon>
                            <ui:SymbolIcon Symbol="DocumentTable24" />
                        </ui:NavigationViewItem.Icon>
                    </ui:NavigationViewItem>

                    <ui:NavigationViewItem Content="{DynamicResource NavBusinessProfile}" TargetPageType="{x:Type views:BusinessProfileView}" Command="{Binding NavigateCommand}" CommandParameter="BusinessProfile">
                        <ui:NavigationViewItem.Icon>
                            <ui:SymbolIcon Symbol="Building24" />
                        </ui:NavigationViewItem.Icon>
                    </ui:NavigationViewItem>

                    <ui:NavigationViewItem Content="{DynamicResource NavLedger}" TargetPageType="{x:Type views:BusinessLedgerView}" Command="{Binding NavigateCommand}" CommandParameter="Ledger">
                        <ui:NavigationViewItem.Icon>
                            <ui:SymbolIcon Symbol="Receipt24" />
                        </ui:NavigationViewItem.Icon>
                    </ui:NavigationViewItem>

                    <ui:NavigationViewItem Content="{DynamicResource NavReportsAnalytics}" TargetPageType="{x:Type views:ReportsAnalyticsView}" Command="{Binding NavigateCommand}" CommandParameter="Reports">
                        <ui:NavigationViewItem.Icon>
                            <ui:SymbolIcon Symbol="DataUsage24" />
                        </ui:NavigationViewItem.Icon>
                    </ui:NavigationViewItem>

                    <!-- SECTION 4: SYSTEM & PREFERENCES -->
                    <ui:NavigationViewItemHeader Text="SYSTEM &amp; STORAGE" Margin="4,12,4,4"/>

                    <ui:NavigationViewItem Content="{DynamicResource NavBackupRestore}" TargetPageType="{x:Type views:BackupRestoreView}" Command="{Binding NavigateCommand}" CommandParameter="Backup">
                        <ui:NavigationViewItem.Icon>
                            <ui:SymbolIcon Symbol="ArrowCounterclockwise24" />
                        </ui:NavigationViewItem.Icon>
                    </ui:NavigationViewItem>

                    <ui:NavigationViewItem Content="{DynamicResource NavSettings}" TargetPageType="{x:Type views:SettingsView}" Command="{Binding NavigateCommand}" CommandParameter="Settings">
                        <ui:NavigationViewItem.Icon>
                            <ui:SymbolIcon Symbol="Settings24" />
                        </ui:NavigationViewItem.Icon>
                    </ui:NavigationViewItem>
                </ui:NavigationView.MenuItems>
            </ui:NavigationView>

            <!-- Dynamic Workspace Content Host -->
            <ContentControl Grid.Column="1" Content="{Binding CurrentView}" Margin="12"/>
        </Grid>
    </Grid>
</ui:FluentWindow>
