<ui:FluentWindow x:Class="PVCStudioPro.App.MainWindow"
                   xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
                   xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
                   xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
                   xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
                   xmlns:ui="http://schemas.lepo.co/wpfui/2022/xaml"
                   xmlns:vm="clr-namespace:PVCStudioPro.App.ViewModels"
                   xmlns:views="clr-namespace:PVCStudioPro.App.Views"
                   mc:Ignorable="d"
                   Title="{DynamicResource AppTitle}"
                   Height="800" Width="1280"
                   MinHeight="750" MinWidth="1200"
                   WindowStartupLocation="CenterScreen"
                   ExtendsContentIntoTitleBar="True"
                   WindowBackdropType="Mica">

    <Window.InputBindings>
        <KeyBinding Modifiers="Ctrl" Key="O" Command="{Binding QuickOpenDocumentCommand}"/>
        <KeyBinding Modifiers="Ctrl" Key="P" Command="{Binding QuickPrintCommand}"/>
        <KeyBinding Modifiers="Ctrl" Key="S" Command="{Binding QuickExportPdfCommand}"/>
        <KeyBinding Key="F5" Command="{Binding DirectSpoolF5Command}"/>
        <KeyBinding Modifiers="Ctrl" Key="D" Command="{Binding ProductionVM.AutoExtractCardsCommand}"/>
    </Window.InputBindings>

    <Window.Resources>
        <!-- Workspace DataTemplates -->
        <DataTemplate DataType="{x:Type vm:ProductionWorkspaceViewModel}">
            <views:ProductionWorkspaceView/>
        </DataTemplate>
        <DataTemplate DataType="{x:Type vm:DocumentDeskViewModel}">
            <views:DocumentDeskView/>
        </DataTemplate>
        <DataTemplate DataType="{x:Type vm:DocumentPageDesignerViewModel}">
            <views:DocumentPageDesignerView/>
        </DataTemplate>
        <DataTemplate DataType="{x:Type vm:PrintPreviewApprovalViewModel}">
            <views:PrintPreviewApprovalView/>
        </DataTemplate>
        <DataTemplate DataType="{x:Type vm:PhotoStudioViewModel}">
            <views:PhotoStudioView/>
        </DataTemplate>
        <DataTemplate DataType="{x:Type vm:DocumentProcessingViewModel}">
            <views:DocumentProcessingView/>
        </DataTemplate>
        <DataTemplate DataType="{x:Type vm:BatchProcessingViewModel}">
            <views:BatchProcessingView/>
        </DataTemplate>
        <DataTemplate DataType="{x:Type vm:PrinterTrayManagerViewModel}">
            <views:PrinterTrayManagerView/>
        </DataTemplate>
        <DataTemplate DataType="{x:Type vm:CalibrationViewModel}">
            <views:CalibrationView/>
        </DataTemplate>
        <DataTemplate DataType="{x:Type vm:TemplateManagerViewModel}">
            <views:TemplateManagerView/>
        </DataTemplate>
        <DataTemplate DataType="{x:Type vm:BusinessProfileViewModel}">
            <views:BusinessProfileView/>
        </DataTemplate>
        <DataTemplate DataType="{x:Type vm:BusinessLedgerViewModel}">
            <views:BusinessLedgerView/>
        </DataTemplate>
        <DataTemplate DataType="{x:Type vm:ReportsAnalyticsViewModel}">
            <views:ReportsAnalyticsView/>
        </DataTemplate>
        <DataTemplate DataType="{x:Type vm:BackupRestoreViewModel}">
            <views:BackupRestoreView/>
        </DataTemplate>
        <DataTemplate DataType="{x:Type vm:SettingsViewModel}">
            <views:SettingsView/>
        </DataTemplate>
    </Window.Resources>

    <Grid>
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="*"/>
        </Grid.RowDefinitions>

        <!-- Top TitleBar with Google Stitch Midnight Executive Branding & Live Telemetry -->
        <ui:TitleBar Grid.Row="0" Title="{DynamicResource AppTitle}">
            <ui:TitleBar.Header>
                <Grid VerticalAlignment="Center" Margin="10,0,0,0">
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="Auto"/>
                        <ColumnDefinition Width="Auto"/>
                        <ColumnDefinition Width="Auto"/>
                        <ColumnDefinition Width="*"/>
                        <ColumnDefinition Width="Auto"/>
                        <ColumnDefinition Width="Auto"/>
                        <ColumnDefinition Width="Auto"/>
                        <ColumnDefinition Width="Auto"/>
                        <ColumnDefinition Width="Auto"/>
                    </Grid.ColumnDefinitions>

                    <!-- Active Workspace Breadcrumb -->
                    <Border Grid.Column="0" Background="{DynamicResource StitchPrimaryContainerBrush}" CornerRadius="4" Padding="8,3" Margin="0,0,8,0">
                        <StackPanel Orientation="Horizontal">
                            <TextBlock Text="PVC STUDIO PRO" FontWeight="Bold" FontSize="11" Foreground="{DynamicResource StitchSecondaryContainerBrush}" Margin="0,0,6,0"/>
                            <TextBlock Text="•" FontSize="11" Foreground="#475569" Margin="0,0,6,0"/>
                            <TextBlock Text="{Binding ActiveWorkspaceTitle}" FontWeight="SemiBold" FontSize="11" Foreground="White"/>
                        </StackPanel>
                    </Border>

                    <!-- 100% Offline Badge -->
                    <Border Grid.Column="1" Background="#064E3B" BorderBrush="#059669" BorderThickness="1" CornerRadius="4" Padding="6,2" Margin="0,0,6,0">
                        <StackPanel Orientation="Horizontal">
                            <TextBlock Text="● " FontSize="8" Foreground="#34D399" VerticalAlignment="Center"/>
                            <TextBlock Text="v2.4 Desktop • 100% Offline" FontSize="10" FontWeight="SemiBold" Foreground="#A7F3D0" VerticalAlignment="Center"/>
                        </StackPanel>
                    </Border>

                    <!-- Zero PII Retained Shield -->
                    <Border Grid.Column="2" Background="{DynamicResource NeutralSurfaceBrush}" BorderBrush="{DynamicResource ControlStrokeColorDefaultBrush}" BorderThickness="1" CornerRadius="4" Padding="6,2" Margin="0,0,10,0">
                        <StackPanel Orientation="Horizontal">
                            <TextBlock Text="🛡️ " FontSize="10" VerticalAlignment="Center"/>
                            <TextBlock Text="Zero PII Retained" FontSize="10" FontWeight="SemiBold" Foreground="{DynamicResource TextSecondaryBrush}" VerticalAlignment="Center"/>
                        </StackPanel>
                    </Border>

                    <!-- Open Document Session Tabs -->
                    <ScrollViewer Grid.Column="3" HorizontalScrollBarVisibility="Auto" VerticalScrollBarVisibility="Disabled" Margin="4,0,8,0" VerticalAlignment="Center">
                        <ItemsControl ItemsSource="{Binding OpenSessions}">
                            <ItemsControl.ItemsPanel>
                                <ItemsPanelTemplate>
                                    <StackPanel Orientation="Horizontal"/>
                                </ItemsPanelTemplate>
                            </ItemsControl.ItemsPanel>
                            <ItemsControl.ItemTemplate>
                                <DataTemplate>
                                    <Border CornerRadius="4" Padding="8,3" Margin="0,0,6,0" Background="{DynamicResource NeutralSurfaceBrush}" BorderBrush="{DynamicResource ControlStrokeColorDefaultBrush}" BorderThickness="1">
                                        <StackPanel Orientation="Horizontal" VerticalAlignment="Center">
                                            <TextBlock Text="{Binding FileName}" FontSize="11" FontWeight="SemiBold" Margin="0,0,6,0" VerticalAlignment="Center" Cursor="Hand">
                                                <TextBlock.InputBindings>
                                                    <MouseBinding MouseAction="LeftClick" 
                                                                  Command="{Binding DataContext.SwitchSessionCommand, RelativeSource={RelativeSource AncestorType=Window}}" 
                                                                  CommandParameter="{Binding SessionId}"/>
                                                </TextBlock.InputBindings>
                                            </TextBlock>
                                            <Button Content="✕" Padding="3,0" FontSize="9" FontWeight="Bold" BorderThickness="0" Background="Transparent" Foreground="{DynamicResource TextSecondaryBrush}" Cursor="Hand"
                                                    Command="{Binding DataContext.CloseSessionCommand, RelativeSource={RelativeSource AncestorType=Window}}"
                                                    CommandParameter="{Binding SessionId}"/>
                                        </StackPanel>
                                    </Border>
                                </DataTemplate>
                            </ItemsControl.ItemTemplate>
                        </ItemsControl>
                    </ScrollViewer>

                    <!-- Hardware Status Pill -->
                    <Border Grid.Column="4" Background="{DynamicResource NeutralSurfaceBrush}" BorderBrush="{DynamicResource ControlStrokeColorDefaultBrush}" BorderThickness="1" CornerRadius="4" Padding="8,3" Margin="0,0,6,0" VerticalAlignment="Center">
                        <StackPanel Orientation="Horizontal">
                            <TextBlock Text="🖨️ " FontSize="10" VerticalAlignment="Center"/>
                            <TextBlock Text="{Binding PrinterStatusText}" FontSize="10.5" FontWeight="SemiBold" Foreground="{DynamicResource TextPrimaryBrush}" VerticalAlignment="Center"/>
                        </StackPanel>
                    </Border>

                    <!-- Today Financial Summary Pill -->
                    <Border Grid.Column="5" Background="#ECFDF5" BorderBrush="#6EE7B7" BorderThickness="1" CornerRadius="4" Padding="8,3" Margin="0,0,6,0" VerticalAlignment="Center">
                        <StackPanel Orientation="Horizontal">
                            <TextBlock Text="₹ " FontWeight="Bold" FontSize="11" Foreground="#047857" VerticalAlignment="Center"/>
                            <TextBlock Text="{Binding TodayRevenueSummary}" FontSize="10.5" FontWeight="Bold" Foreground="#065F46" VerticalAlignment="Center"/>
                        </StackPanel>
                    </Border>

                    <!-- F5 Direct Spool Quick Action Button -->
                    <ui:Button Grid.Column="6" Command="{Binding DirectSpoolF5Command}" Height="28" Padding="10,0" Margin="0,0,6,0" Background="#006C4A" Foreground="White" BorderBrush="#004D34" BorderThickness="1" CornerRadius="4" ToolTip="Instant Direct Winspool (F5)">
                        <StackPanel Orientation="Horizontal">
                            <TextBlock Text="⚡ " FontSize="11" VerticalAlignment="Center"/>
                            <TextBlock Text="F5 Direct Spool" FontWeight="Bold" FontSize="10.5" VerticalAlignment="Center"/>
                        </StackPanel>
                    </ui:Button>

                    <!-- Theme Toggle -->
                    <ui:Button Grid.Column="7" Command="{Binding ToggleThemeCommand}" Content="{Binding CurrentTheme}" Height="28" Padding="8,0" FontSize="10.5" FontWeight="SemiBold" CornerRadius="4" Background="{DynamicResource NeutralSurfaceBrush}" Margin="0,0,6,0"/>

                    <!-- Language Switcher -->
                    <ui:Button Grid.Column="8" Command="{Binding ToggleLanguageCommand}" Content="{Binding LanguageButtonText}" Height="28" Padding="10,0" FontSize="10.5" FontWeight="SemiBold" CornerRadius="4" Background="#EBF3FC" Foreground="#0067B8" BorderBrush="#C2DCF7" BorderThickness="1"/>
                </Grid>
            </ui:TitleBar.Header>
        </ui:TitleBar>

        <!-- High-Visibility Test Mode Top Warning Banner -->
        <Border Grid.Row="1" Background="#FEF3C7" BorderBrush="#F59E0B" BorderThickness="0,0,0,1.5" Padding="16,6"
                Visibility="{Binding IsTestMode, Converter={StaticResource BooleanToVisibilityConverter}}">
            <Grid>
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="Auto"/>
                    <ColumnDefinition Width="*"/>
                    <ColumnDefinition Width="Auto"/>
                </Grid.ColumnDefinitions>
                <TextBlock Grid.Column="0" Text="⚠️" FontSize="14" VerticalAlignment="Center" Margin="0,0,8,0"/>
                <TextBlock Grid.Column="1" Text="TEST MODE ACTIVE — Financial Sandbox Enabled (Zero Production Data Affected)" FontWeight="Bold" Foreground="#92400E" FontSize="11.5" VerticalAlignment="Center"/>
                <ui:Button Grid.Column="2" Command="{Binding ExitTestModeCommand}" Content="Exit Test Mode" Height="24" Padding="10,0" Background="#F59E0B" Foreground="White" FontWeight="Bold" FontSize="10.5" CornerRadius="4"/>
            </Grid>
        </Border>

        <!-- Main Body: Navigation Sidebar + Workspace Content -->
        <Grid Grid.Row="2">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="Auto"/>
                <ColumnDefinition Width="*"/>
            </Grid.ColumnDefinitions>

            <!-- Collapsible Fluent Navigation Rail with Google Stitch Executive Navy Palette -->
            <ui:NavigationView x:Name="RootNavigation"
                               Grid.Column="0"
                               PaneDisplayMode="Left"
                               CompactPaneLength="56"
                               OpenPaneLength="240"
                               IsPaneOpen="False"
                               IsBackButtonVisible="Collapsed"
                               Background="#0E1C2F"
                               Foreground="White"
                               MouseEnter="Navigation_MouseEnter"
                               MouseLeave="Navigation_MouseLeave">
                <ui:NavigationView.PaneHeader>
                    <Border Padding="12,10" Background="#0A1422" BorderBrush="#16273E" BorderThickness="0,0,0,1">
                        <StackPanel>
                            <Grid Margin="0,0,0,6">
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="Auto"/>
                                    <ColumnDefinition Width="*"/>
                                </Grid.ColumnDefinitions>
                                <Border Grid.Column="0" Background="#006C4A" CornerRadius="6" Width="28" Height="28" Margin="0,0,10,0">
                                    <TextBlock Text="💳" FontSize="14" HorizontalAlignment="Center" VerticalAlignment="Center"/>
                                </Border>
                                <StackPanel Grid.Column="1" VerticalAlignment="Center">
                                    <TextBlock Text="PVC STUDIO" FontWeight="Bold" FontSize="12.5" Foreground="White"/>
                                    <TextBlock Text="ENTERPRISE SUITE" FontWeight="SemiBold" FontSize="9" Foreground="#34D399"/>
                                </StackPanel>
                            </Grid>
                            <Border Background="#0E233A" BorderBrush="#006C4A" BorderThickness="1" CornerRadius="4" Padding="6,2" Margin="0,2,0,0">
                                <StackPanel Orientation="Horizontal">
                                    <TextBlock Text="● " FontSize="8" Foreground="#85F8C4" VerticalAlignment="Center"/>
                                    <TextBlock Text="ENGINE: CORE-V2.4" FontSize="9" FontWeight="Bold" Foreground="#85F8C4" VerticalAlignment="Center"/>
                                </StackPanel>
                            </Border>
                        </StackPanel>
                    </Border>
                </ui:NavigationView.PaneHeader>
                <ui:NavigationView.MenuItems>
                    <!-- HERO: UNIFIED PVC PRODUCTION STUDIO -->
                    <ui:NavigationViewItem Content="{DynamicResource NavProductionStudio}" Command="{Binding NavigateCommand}" CommandParameter="Production" ToolTip="Production Studio">
                        <ui:NavigationViewItem.Icon>
                            <ui:SymbolIcon Symbol="Print24" />
                        </ui:NavigationViewItem.Icon>
                    </ui:NavigationViewItem>

                    <ui:NavigationViewItem Content="{DynamicResource NavPhotoStudio}" Command="{Binding NavigateCommand}" CommandParameter="Photo" ToolTip="Photo Studio">
                        <ui:NavigationViewItem.Icon>
                            <ui:SymbolIcon Symbol="Image24" />
                        </ui:NavigationViewItem.Icon>
                    </ui:NavigationViewItem>

                    <ui:NavigationViewItem Content="{DynamicResource NavBatchProcessing}" Command="{Binding NavigateCommand}" CommandParameter="Batch" ToolTip="High Volume Batch">
                        <ui:NavigationViewItem.Icon>
                            <ui:SymbolIcon Symbol="FolderZip24" />
                        </ui:NavigationViewItem.Icon>
                    </ui:NavigationViewItem>

                    <!-- HARDWARE & CALIBRATION -->
                    <ui:NavigationViewItemSeparator Margin="4,8,4,8"/>

                    <ui:NavigationViewItem Content="{DynamicResource NavPrinterTrayManager}" Command="{Binding NavigateCommand}" CommandParameter="PrinterTray" ToolTip="Printer &amp; Tray Manager">
                        <ui:NavigationViewItem.Icon>
                            <ui:SymbolIcon Symbol="Board24" />
                        </ui:NavigationViewItem.Icon>
                    </ui:NavigationViewItem>

                    <ui:NavigationViewItem Content="{DynamicResource NavCalibration}" Command="{Binding NavigateCommand}" CommandParameter="Calibration" ToolTip="Calibration Studio">
                        <ui:NavigationViewItem.Icon>
                            <ui:SymbolIcon Symbol="Wrench24" />
                        </ui:NavigationViewItem.Icon>
                    </ui:NavigationViewItem>

                    <!-- BUSINESS & AUDIT -->
                    <ui:NavigationViewItemSeparator Margin="4,8,4,8"/>

                    <ui:NavigationViewItem Content="{DynamicResource NavLedger}" Command="{Binding NavigateCommand}" CommandParameter="Ledger" ToolTip="Transactions &amp; Ledger">
                        <ui:NavigationViewItem.Icon>
                            <ui:SymbolIcon Symbol="Receipt24" />
                        </ui:NavigationViewItem.Icon>
                    </ui:NavigationViewItem>

                    <ui:NavigationViewItem Content="{DynamicResource NavBusinessProfile}" Command="{Binding NavigateCommand}" CommandParameter="BusinessProfile" ToolTip="Business Profile">
                        <ui:NavigationViewItem.Icon>
                            <ui:SymbolIcon Symbol="Building24" />
                        </ui:NavigationViewItem.Icon>
                    </ui:NavigationViewItem>

                    <!-- UTILITIES & ADVANCED TOOLS -->
                    <ui:NavigationViewItemSeparator Margin="4,8,4,8"/>

                    <ui:NavigationViewItem Content="{DynamicResource NavDocumentDesk}" Command="{Binding NavigateCommand}" CommandParameter="DocumentDesk" ToolTip="Document Desk">
                        <ui:NavigationViewItem.Icon>
                            <ui:SymbolIcon Symbol="DocumentTable24" />
                        </ui:NavigationViewItem.Icon>
                    </ui:NavigationViewItem>

                    <ui:NavigationViewItem Content="{DynamicResource NavPageDesigner}" Command="{Binding NavigateCommand}" CommandParameter="PageDesigner" ToolTip="Page Designer">
                        <ui:NavigationViewItem.Icon>
                            <ui:SymbolIcon Symbol="DesignIdeas24" />
                        </ui:NavigationViewItem.Icon>
                    </ui:NavigationViewItem>

                    <ui:NavigationViewItem Content="{DynamicResource NavSettings}" Command="{Binding NavigateCommand}" CommandParameter="Settings" ToolTip="Settings &amp; Preferences">
                        <ui:NavigationViewItem.Icon>
                            <ui:SymbolIcon Symbol="Settings24" />
                        </ui:NavigationViewItem.Icon>
                    </ui:NavigationViewItem>
                </ui:NavigationView.MenuItems>

                <ui:NavigationView.PaneFooter>
                    <Border Padding="10,8" Background="#0A1422" BorderBrush="#16273E" BorderThickness="0,1,0,0" Margin="4,0,4,6" CornerRadius="6">
                        <StackPanel>
                            <StackPanel Orientation="Horizontal" Margin="0,0,0,3">
                                <TextBlock Text="● " FontSize="8" Foreground="#34D399" VerticalAlignment="Center"/>
                                <TextBlock Text="HARDWARE BRIDGE • LIVE" FontWeight="Bold" FontSize="9" Foreground="#34D399"/>
                            </StackPanel>
                            <StackPanel Orientation="Horizontal" Margin="0,0,0,2">
                                <TextBlock Text="🖨️ " FontSize="9.5" VerticalAlignment="Center"/>
                                <TextBlock Text="L8050 PVC JIG 2-UP" FontWeight="SemiBold" FontSize="10" Foreground="White" VerticalAlignment="Center"/>
                            </StackPanel>
                            <StackPanel Orientation="Horizontal">
                                <TextBlock Text="🔒 " FontSize="8.5" VerticalAlignment="Center"/>
                                <TextBlock Text="HOST: SECURE-DESK-01" FontSize="8.5" Foreground="#94A3B8" VerticalAlignment="Center"/>
                            </StackPanel>
                        </StackPanel>
                    </Border>
                </ui:NavigationView.PaneFooter>
            </ui:NavigationView>

            <!-- Dynamic Workspace Content Host -->
            <ContentControl Grid.Column="1" Content="{Binding CurrentView}" Margin="12"/>
        </Grid>
    </Grid>
</ui:FluentWindow>
