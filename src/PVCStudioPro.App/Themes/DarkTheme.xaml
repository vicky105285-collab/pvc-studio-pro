<ResourceDictionary xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
                    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml">

    <!-- Surfaces -->
    <SolidColorBrush x:Key="WindowBackgroundBrush" Color="#0B0F19"/>
    <SolidColorBrush x:Key="AppBackgroundBrush" Color="#0F172A"/>
    <SolidColorBrush x:Key="NeutralSurfaceBrush" Color="#1E293B"/>
    <SolidColorBrush x:Key="CardSurfaceBrush" Color="#1E293B"/>
    <SolidColorBrush x:Key="CardBackgroundBrush" Color="#1E293B"/>
    <SolidColorBrush x:Key="CardSubtleBackgroundBrush" Color="#334155"/>
    <SolidColorBrush x:Key="ElevatedSurfaceBrush" Color="#334155"/>
    <SolidColorBrush x:Key="PreviewCanvasBgBrush" Color="#0B0F19"/>
    <SolidColorBrush x:Key="SidebarBackgroundBrush" Color="#1E293B"/>
    <SolidColorBrush x:Key="SidebarActiveItemBrush" Color="#334155"/>
    <SolidColorBrush x:Key="StatusPillBackgroundBrush" Color="#334155"/>

    <!-- Borders & Dividers -->
    <SolidColorBrush x:Key="NeutralBorderBrush" Color="#334155"/>
    <SolidColorBrush x:Key="BorderSubtleBrush" Color="#334155"/>
    <SolidColorBrush x:Key="BorderStrongBrush" Color="#475569"/>
    <SolidColorBrush x:Key="DividerBrush" Color="#475569"/>
    <SolidColorBrush x:Key="ControlBorderBrush" Color="#475569"/>
    <SolidColorBrush x:Key="ControlFocusBorderBrush" Color="#38BDF8"/>

    <!-- Text (High Contrast Dark Mode) -->
    <SolidColorBrush x:Key="TextPrimaryBrush" Color="#F8FAFC"/>
    <SolidColorBrush x:Key="TextSecondaryBrush" Color="#94A3B8"/>
    <SolidColorBrush x:Key="TextMutedBrush" Color="#64748B"/>
    <SolidColorBrush x:Key="TextTertiaryBrush" Color="#64748B"/>
    <SolidColorBrush x:Key="TextDisabledBrush" Color="#475569"/>

    <!-- Controls & Inputs -->
    <SolidColorBrush x:Key="ControlBackgroundBrush" Color="#1E293B"/>

    <!-- Primary Accent & Actions -->
    <SolidColorBrush x:Key="PrimaryAccentBrush" Color="#38BDF8"/>
    <SolidColorBrush x:Key="AccentPrimaryBrush" Color="#38BDF8"/>
    <SolidColorBrush x:Key="PrimaryAccentHoverBrush" Color="#0EA5E9"/>
    <SolidColorBrush x:Key="AccentPrimaryHoverBrush" Color="#0EA5E9"/>
    <SolidColorBrush x:Key="PrimaryAccentPressedBrush" Color="#0284C7"/>
    <SolidColorBrush x:Key="AccentTextBrush" Color="#0F172A"/>

    <!-- Status & Alerts (Dark rich backgrounds with light vibrant text) -->
    <SolidColorBrush x:Key="AccentSuccessBrush" Color="#22C55E"/>
    <SolidColorBrush x:Key="StatusSuccessBgBrush" Color="#064E3B"/>
    <SolidColorBrush x:Key="StatusSuccessFgBrush" Color="#34D399"/>

    <SolidColorBrush x:Key="AccentWarningBrush" Color="#F59E0B"/>
    <SolidColorBrush x:Key="StatusWarningBgBrush" Color="#78350F"/>
    <SolidColorBrush x:Key="StatusWarningFgBrush" Color="#FBBF24"/>

    <SolidColorBrush x:Key="AccentDangerBrush" Color="#EF4444"/>
    <SolidColorBrush x:Key="StatusErrorBgBrush" Color="#7F1D1D"/>
    <SolidColorBrush x:Key="StatusErrorFgBrush" Color="#F87171"/>

    <SolidColorBrush x:Key="StatusInfoBgBrush" Color="#0C4A6E"/>
    <SolidColorBrush x:Key="StatusInfoFgBrush" Color="#38BDF8"/>

</ResourceDictionary>
