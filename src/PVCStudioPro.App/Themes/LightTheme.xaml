<ResourceDictionary xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
                    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml">

    <!-- Surfaces -->
    <SolidColorBrush x:Key="WindowBackgroundBrush" Color="#F8FAFC"/>
    <SolidColorBrush x:Key="AppBackgroundBrush" Color="#F8FAFC"/>
    <SolidColorBrush x:Key="NeutralSurfaceBrush" Color="#FFFFFF"/>
    <SolidColorBrush x:Key="CardSurfaceBrush" Color="#FFFFFF"/>
    <SolidColorBrush x:Key="CardBackgroundBrush" Color="#FFFFFF"/>
    <SolidColorBrush x:Key="CardSubtleBackgroundBrush" Color="#F1F5F9"/>
    <SolidColorBrush x:Key="ElevatedSurfaceBrush" Color="#F8FAFC"/>
    <SolidColorBrush x:Key="PreviewCanvasBgBrush" Color="#E2E8F0"/>
    <SolidColorBrush x:Key="SidebarBackgroundBrush" Color="#FFFFFF"/>
    <SolidColorBrush x:Key="SidebarActiveItemBrush" Color="#EBF3FC"/>
    <SolidColorBrush x:Key="StatusPillBackgroundBrush" Color="#F1F5F9"/>
    <SolidColorBrush x:Key="ModalBackdropBrush" Color="#80000000"/>

    <!-- Borders & Dividers -->
    <SolidColorBrush x:Key="NeutralBorderBrush" Color="#E2E8F0"/>
    <SolidColorBrush x:Key="BorderSubtleBrush" Color="#E2E8F0"/>
    <SolidColorBrush x:Key="BorderStrongBrush" Color="#CBD5E1"/>
    <SolidColorBrush x:Key="DividerBrush" Color="#CBD5E1"/>
    <SolidColorBrush x:Key="ControlBorderBrush" Color="#CBD5E1"/>
    <SolidColorBrush x:Key="ControlFocusBorderBrush" Color="#0284C7"/>

    <!-- Text (WCAG AA Compliant Contrast) -->
    <SolidColorBrush x:Key="TextPrimaryBrush" Color="#0F172A"/>
    <SolidColorBrush x:Key="TextSecondaryBrush" Color="#475569"/>
    <SolidColorBrush x:Key="TextMutedBrush" Color="#64748B"/>
    <SolidColorBrush x:Key="TextTertiaryBrush" Color="#64748B"/>
    <SolidColorBrush x:Key="TextDisabledBrush" Color="#94A3B8"/>

    <!-- Controls & Inputs -->
    <SolidColorBrush x:Key="ControlBackgroundBrush" Color="#FFFFFF"/>

    <!-- Primary Accent & Actions -->
    <SolidColorBrush x:Key="PrimaryAccentBrush" Color="#0067B8"/>
    <SolidColorBrush x:Key="AccentPrimaryBrush" Color="#0067B8"/>
    <SolidColorBrush x:Key="PrimaryAccentHoverBrush" Color="#005DA6"/>
    <SolidColorBrush x:Key="AccentPrimaryHoverBrush" Color="#005DA6"/>
    <SolidColorBrush x:Key="PrimaryAccentPressedBrush" Color="#004C87"/>
    <SolidColorBrush x:Key="AccentTextBrush" Color="#FFFFFF"/>

    <!-- Status & Alerts (Light backgrounds with dark saturated text) -->
    <SolidColorBrush x:Key="AccentSuccessBrush" Color="#107C41"/>
    <SolidColorBrush x:Key="StatusSuccessBgBrush" Color="#ECFDF5"/>
    <SolidColorBrush x:Key="StatusSuccessFgBrush" Color="#047857"/>

    <SolidColorBrush x:Key="AccentWarningBrush" Color="#D97706"/>
    <SolidColorBrush x:Key="StatusWarningBgBrush" Color="#FFFBEB"/>
    <SolidColorBrush x:Key="StatusWarningFgBrush" Color="#B45309"/>

    <SolidColorBrush x:Key="AccentDangerBrush" Color="#DC2626"/>
    <SolidColorBrush x:Key="StatusErrorBgBrush" Color="#FEF2F2"/>
    <SolidColorBrush x:Key="StatusErrorFgBrush" Color="#B91C1C"/>

    <SolidColorBrush x:Key="StatusInfoBgBrush" Color="#F0F9FF"/>
    <SolidColorBrush x:Key="StatusInfoFgBrush" Color="#0369A1"/>

    <!-- Google Stitch Design System Tokens -->
    <SolidColorBrush x:Key="StitchPrimaryContainerBrush" Color="#0E1C2F"/>
    <SolidColorBrush x:Key="StitchSecondaryBrush" Color="#006C4A"/>
    <SolidColorBrush x:Key="StitchSecondaryContainerBrush" Color="#82F5C1"/>
    <SolidColorBrush x:Key="StitchOnSecondaryContainerBrush" Color="#00714E"/>
    <SolidColorBrush x:Key="StitchSecondaryFixedBrush" Color="#85F8C4"/>
    <SolidColorBrush x:Key="StitchOnSecondaryFixedBrush" Color="#002114"/>
    <SolidColorBrush x:Key="StitchSurfaceBrush" Color="#F8F9FF"/>
    <SolidColorBrush x:Key="StitchSurfaceContainerLowestBrush" Color="#FFFFFF"/>
    <SolidColorBrush x:Key="StitchSurfaceContainerLowBrush" Color="#EFF4FF"/>
    <SolidColorBrush x:Key="StitchSurfaceContainerHighBrush" Color="#DCE9FF"/>
    <SolidColorBrush x:Key="StitchSurfaceContainerHighestBrush" Color="#D3E4FE"/>
    <SolidColorBrush x:Key="StitchInverseSurfaceBrush" Color="#213145"/>
    <SolidColorBrush x:Key="StitchTextPrimaryBrush" Color="#0B1C30"/>
    <SolidColorBrush x:Key="StitchTextSecondaryBrush" Color="#44474C"/>
    <SolidColorBrush x:Key="StitchTertiaryFixedBrush" Color="#DBE1FF"/>
    <SolidColorBrush x:Key="StitchOnTertiaryFixedBrush" Color="#00174B"/>

    <!-- Legacy Compatibility Aliases -->
    <SolidColorBrush x:Key="BrandPrimaryBrush" Color="#0067B8"/>
    <SolidColorBrush x:Key="BrandSuccessBrush" Color="#107C41"/>
    <SolidColorBrush x:Key="SurfaceBorderBrush" Color="#E2E8F0"/>
    <SolidColorBrush x:Key="CanvasBackgroundBrush" Color="#E2E8F0"/>

</ResourceDictionary>
