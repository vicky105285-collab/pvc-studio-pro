<ResourceDictionary xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
                    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml">

    <!-- Neutral Surface Brushes -->
    <SolidColorBrush x:Key="AppBackgroundBrush" Color="#F8FAFC"/>
    <SolidColorBrush x:Key="CardBackgroundBrush" Color="#FFFFFF"/>
    <SolidColorBrush x:Key="CardSubtleBackgroundBrush" Color="#F1F5F9"/>
    <SolidColorBrush x:Key="BorderSubtleBrush" Color="#E2E8F0"/>
    <SolidColorBrush x:Key="BorderStrongBrush" Color="#CBD5E1"/>

    <!-- Text Brushes -->
    <SolidColorBrush x:Key="TextPrimaryBrush" Color="#0F172A"/>
    <SolidColorBrush x:Key="TextSecondaryBrush" Color="#475569"/>
    <SolidColorBrush x:Key="TextMutedBrush" Color="#64748B"/>

    <!-- Accent & Status Brushes -->
    <SolidColorBrush x:Key="AccentPrimaryBrush" Color="#0067B8"/>
    <SolidColorBrush x:Key="AccentPrimaryHoverBrush" Color="#005DA6"/>
    <SolidColorBrush x:Key="AccentSuccessBrush" Color="#107C41"/>
    <SolidColorBrush x:Key="AccentWarningBrush" Color="#D97706"/>
    <SolidColorBrush x:Key="AccentDangerBrush" Color="#DC2626"/>

    <!-- Chrome & Sidebar -->
    <SolidColorBrush x:Key="SidebarBackgroundBrush" Color="#FFFFFF"/>
    <SolidColorBrush x:Key="SidebarActiveItemBrush" Color="#EBF3FC"/>
    <SolidColorBrush x:Key="StatusPillBackgroundBrush" Color="#F1F5F9"/>

</ResourceDictionary>
