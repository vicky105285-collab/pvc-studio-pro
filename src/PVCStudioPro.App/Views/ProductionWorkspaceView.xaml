<UserControl x:Class="PVCStudioPro.App.Views.ProductionWorkspaceView"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006" 
             xmlns:d="http://schemas.microsoft.com/expression/blend/2008" 
             xmlns:ui="http://schemas.lepo.co/wpfui/2022/xaml"
             xmlns:vm="clr-namespace:PVCStudioPro.App.ViewModels"
             xmlns:controls="clr-namespace:PVCStudioPro.App.Controls"
             mc:Ignorable="d" 
             d:DataContext="{d:DesignInstance Type=vm:ProductionWorkspaceViewModel}"
             d:DesignHeight="850" d:DesignWidth="1300">
    <Grid Margin="12,8,12,12">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto"/> <!-- Top Action Bar -->
            <RowDefinition Height="*"/>    <!-- Main 3-Column Task Workspace -->
            <RowDefinition Height="Auto"/> <!-- Status Bar -->
        </Grid.RowDefinitions>

        <!-- ROW 0: TOP ACTION BAR, PASSWORD PROMPT & LOW-CONFIDENCE AMBER ALERT -->
        <StackPanel Grid.Row="0" Margin="0,0,0,10">
            <!-- Action Toolbar (Clean, high-density, commercial desktop) -->
            <Border Style="{StaticResource SurfaceCardStyle}" Padding="12,8" Margin="0,0,0,6">
                <Grid>
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="Auto"/>
                        <ColumnDefinition Width="Auto"/>
                        <ColumnDefinition Width="*"/>
                        <ColumnDefinition Width="Auto"/>
                    </Grid.ColumnDefinitions>

                    <!-- Primary Document Actions -->
                    <StackPanel Grid.Column="0" Orientation="Horizontal" VerticalAlignment="Center" Margin="0,0,16,0">
                        <ui:Button Command="{Binding OpenDocumentFileDialogCommand}" Style="{StaticResource PrimaryActionButtonStyle}" Height="36" Padding="16,0" Margin="0,0,8,0" ToolTip="Open Aadhaar PDF, PAN, Voter, or Scanned Image (Ctrl+O)">
                            <StackPanel Orientation="Horizontal">
                                <ui:SymbolIcon Symbol="FolderOpen24" Margin="0,0,8,0"/>
                                <TextBlock Text="Open Document" FontWeight="Bold" VerticalAlignment="Center"/>
                            </StackPanel>
                        </ui:Button>

                        <ui:Button Command="{Binding SaveProjectCommand}" Style="{StaticResource SecondaryActionButtonStyle}" Height="36" Margin="0,0,6,0" ToolTip="Save current layout to .pvcproj project file">
                            <StackPanel Orientation="Horizontal">
                                <ui:SymbolIcon Symbol="Save24" Margin="0,0,6,0"/>
                                <TextBlock Text="Save Project" VerticalAlignment="Center"/>
                            </StackPanel>
                        </ui:Button>

                        <ui:Button Command="{Binding ExportPdfCommand}" Style="{StaticResource SecondaryActionButtonStyle}" Height="36" Margin="0,0,6,0" ToolTip="Export 600 DPI vector print-ready PDF">
                            <StackPanel Orientation="Horizontal">
                                <ui:SymbolIcon Symbol="DocumentPdf24" Margin="0,0,6,0"/>
                                <TextBlock Text="Export PDF" VerticalAlignment="Center"/>
                            </StackPanel>
                        </ui:Button>
                    </StackPanel>

                    <!-- Document Recognition & Security Status Badge -->
                    <StackPanel Grid.Column="1" Orientation="Horizontal" VerticalAlignment="Center" Margin="0,0,16,0">
                        <Border Background="{DynamicResource CardSubtleBackgroundBrush}" BorderBrush="{DynamicResource AccentPrimaryBrush}" BorderThickness="1" CornerRadius="4" Padding="10,4" Margin="0,0,8,0">
                            <TextBlock Text="{Binding DetectedBadge}" FontWeight="Bold" FontSize="11" Foreground="{DynamicResource AccentPrimaryBrush}" VerticalAlignment="Center"/>
                        </Border>
                        <Border Background="{Binding ConfidenceBadgeBrush}" CornerRadius="4" Padding="8,4" Margin="0,0,8,0" Visibility="{Binding HasLoadedDocument, Converter={StaticResource BooleanToVisibilityConverter}}">
                            <TextBlock Text="{Binding DetectionConfidenceSummary}" FontWeight="Bold" FontSize="10.5" Foreground="{Binding ConfidenceTextBrush}" VerticalAlignment="Center"/>
                        </Border>
                        <TextBlock Text="{Binding DetectedDocTitle}" FontWeight="SemiBold" FontSize="12.5" Foreground="{DynamicResource TextPrimaryBrush}" VerticalAlignment="Center" TextTrimming="CharacterEllipsis" MaxWidth="320"/>
                    </StackPanel>

                    <!-- Universal 29-Template Categorized Selector & Override -->
                    <StackPanel Grid.Column="2" Orientation="Horizontal" VerticalAlignment="Center" Margin="8,0,16,0">
                        <TextBlock Text="Template:" VerticalAlignment="Center" FontWeight="SemiBold" Foreground="{DynamicResource TextSecondaryBrush}" Margin="0,0,6,0" FontSize="11.5"/>
                        <ComboBox ItemsSource="{Binding TemplateOptions}"
                                  SelectedItem="{Binding SelectedTemplateOption}"
                                  DisplayMemberPath="FormattedLabel"
                                  Width="260" Height="34"
                                  ToolTip="Select or override with any of the 29 calibrated government templates (Identity, Health, Labour, State Rations, Transport)"/>
                    </StackPanel>

                    <!-- Quick Workspace Switcher for Secondary Tools -->
                    <StackPanel Grid.Column="3" Orientation="Horizontal" VerticalAlignment="Center">
                        <ui:Button Command="{Binding SelectOtherCardOptionCommand}" CommandParameter="other_id_dual" Style="{StaticResource SecondaryActionButtonStyle}" Height="34" Margin="0,0,6,0" ToolTip="Quick switch to Other Cards / Custom Presets">
                            <StackPanel Orientation="Horizontal">
                                <ui:SymbolIcon Symbol="ContactCard24" Margin="0,0,6,0"/>
                                <TextBlock Text="Other Cards" VerticalAlignment="Center"/>
                            </StackPanel>
                        </ui:Button>
                        <ui:Button Command="{Binding OpenCropDrawerCommand}" CommandParameter="Front Card (Slot 1)" Style="{StaticResource SecondaryActionButtonStyle}" Height="34" Margin="0,0,6,0" ToolTip="Open fine-tuned interactive crop adjustment drawer">
                            <StackPanel Orientation="Horizontal">
                                <ui:SymbolIcon Symbol="Crop24" Margin="0,0,6,0"/>
                                <TextBlock Text="Adjust Crop" VerticalAlignment="Center"/>
                            </StackPanel>
                        </ui:Button>
                    </StackPanel>
                </Grid>
            </Border>

            <!-- PASSWORD PROMPT BAR (Conditional - Appears only when required) -->
            <Border Background="#FEF3C7" BorderBrush="#FDE68A" BorderThickness="1" CornerRadius="6" Padding="12,8" Margin="0,0,0,6" Visibility="{Binding IsPasswordPromptVisible, Converter={StaticResource BooleanToVisibilityConverter}, FallbackValue=Collapsed}">
                <Grid>
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="Auto"/>
                        <ColumnDefinition Width="*"/>
                        <ColumnDefinition Width="Auto"/>
                    </Grid.ColumnDefinitions>
                    <TextBlock Grid.Column="0" Text="🔒 Document is Password-Protected. Enter PDF Decryption Password:" FontWeight="Bold" Foreground="#92400E" VerticalAlignment="Center" Margin="0,0,12,0"/>
                    <TextBox Grid.Column="1" Text="{Binding PasswordInput, UpdateSourceTrigger=PropertyChanged}" Height="34" VerticalContentAlignment="Center" Margin="0,0,12,0"/>
                    <ui:Button Grid.Column="2" Command="{Binding UnlockPasswordCommand}" Content="Unlock &amp; Extract Cards" Height="34" Padding="14,0" Background="#B45309" Foreground="White" FontWeight="Bold" CornerRadius="4"/>
                </Grid>
            </Border>

            <!-- LOW CONFIDENCE AMBER BANNER (Conditional - Appears when detection confidence < 85%) -->
            <Border Background="#FFFBEB" BorderBrush="#F59E0B" BorderThickness="1.5" CornerRadius="6" Padding="12,8" Margin="0,0,0,6"
                    Visibility="{Binding IsLowConfidenceBannerVisible, Converter={StaticResource BooleanToVisibilityConverter}, FallbackValue=Collapsed}">
                <Grid>
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="Auto"/>
                        <ColumnDefinition Width="*"/>
                        <ColumnDefinition Width="Auto"/>
                        <ColumnDefinition Width="8"/>
                        <ColumnDefinition Width="Auto"/>
                    </Grid.ColumnDefinitions>
                    <TextBlock Grid.Column="0" Text="⚠️" FontSize="16" VerticalAlignment="Center" Margin="0,0,10,0"/>
                    <StackPanel Grid.Column="1" VerticalAlignment="Center">
                        <TextBlock Text="{Binding LowConfidenceWarningTitle}" FontWeight="Bold" Foreground="#B45309" FontSize="12"/>
                        <TextBlock Text="{Binding LowConfidenceWarningDetails}" Foreground="#92400E" FontSize="11"/>
                    </StackPanel>
                    <ui:Button Grid.Column="2" Command="{Binding OpenCropDrawerCommand}" CommandParameter="Front Card" Content="Review &amp; Adjust Bounds" Height="30" Padding="12,0" Background="#F59E0B" Foreground="White" FontWeight="SemiBold" CornerRadius="4"/>
                    <ui:Button Grid.Column="4" Command="{Binding DismissLowConfidenceBannerCommand}" Content="Accept Auto Bounds" Height="30" Padding="12,0" Style="{StaticResource SecondaryActionButtonStyle}"/>
                </Grid>
            </Border>

            <!-- OPERATOR PRINT VERIFICATION BANNER (Conditional - Appears after SpoolerProcessingCompleted) -->
            <Border Background="#EFF6FF" BorderBrush="#3B82F6" BorderThickness="1.5" CornerRadius="6" Padding="12,8" Margin="0,0,0,6"
                    Visibility="{Binding IsReprintVerificationPromptVisible, Converter={StaticResource BooleanToVisibilityConverter}, FallbackValue=Collapsed}">
                <Grid>
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="Auto"/>
                        <ColumnDefinition Width="*"/>
                        <ColumnDefinition Width="Auto"/>
                        <ColumnDefinition Width="8"/>
                        <ColumnDefinition Width="Auto"/>
                    </Grid.ColumnDefinitions>
                    <TextBlock Grid.Column="0" Text="🖨️" FontSize="16" VerticalAlignment="Center" Margin="0,0,10,0"/>
                    <StackPanel Grid.Column="1" VerticalAlignment="Center">
                        <TextBlock Text="Print Spooled to Hardware — Please Verify Physical Card Output" FontWeight="Bold" Foreground="#1E40AF" FontSize="12"/>
                        <TextBlock Text="Check physical print quality for ribbon scuffs, banding, or misalignment before billing customer." Foreground="#1D4ED8" FontSize="11"/>
                    </StackPanel>
                    <ui:Button Grid.Column="2" Command="{Binding ConfirmPrintOutputCommand}" Content="✓ Print Verified (Confirm &amp; Bill)" Height="30" Padding="14,0" Background="#16A34A" Foreground="White" FontWeight="Bold" CornerRadius="4"/>
                    <ui:Button Grid.Column="4" Command="{Binding ReportDefectAndReprintCommand}" CommandParameter="MisalignedOrDefective" Content="⚠️ Defect / Reprint Needed" Height="30" Padding="14,0" Background="#DC2626" Foreground="White" FontWeight="SemiBold" CornerRadius="4"/>
                </Grid>
            </Border>
        </StackPanel>

        <!-- ROW 1: 3-COLUMN TASK WORKSPACE (Zero scrolling, fully responsive) -->
        <Grid Grid.Row="1">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="280"/> <!-- Left: Documents, Card Faces, Layout Presets -->
                <ColumnDefinition Width="*"/>   <!-- Center: True Physical Sheet Canvas -->
                <ColumnDefinition Width="310"/> <!-- Right: Hardware Spooler & Settings -->
            </Grid.ColumnDefinitions>

            <!-- ================= LEFT PANEL: Document, Faces, Layouts ================= -->
            <Border Grid.Column="0" Style="{StaticResource SurfaceCardStyle}" Padding="14" Margin="0,0,10,0">
                <Grid>
                    <Grid.RowDefinitions>
                        <RowDefinition Height="Auto"/>
                        <RowDefinition Height="*"/>
                        <RowDefinition Height="Auto"/>
                    </Grid.RowDefinitions>

                    <!-- Section Header -->
                    <TextBlock Grid.Row="0" Text="EXTRACTED CARD FACES" Style="{StaticResource FormLabelStyle}" FontWeight="Bold" Margin="0,0,0,8"/>

                    <!-- Side-by-Side Dual Card Faces -->
                    <Grid Grid.Row="1">
                        <Grid.RowDefinitions>
                            <RowDefinition Height="*"/>
                            <RowDefinition Height="*"/>
                        </Grid.RowDefinitions>

                        <!-- Front Card Face -->
                        <Border Grid.Row="0" Background="{DynamicResource CardSubtleBackgroundBrush}" BorderBrush="{DynamicResource BorderSubtleBrush}" BorderThickness="1" CornerRadius="6" Margin="0,0,0,8" Padding="6">
                            <Grid>
                                <Grid.RowDefinitions>
                                    <RowDefinition Height="Auto"/>
                                    <RowDefinition Height="*"/>
                                </Grid.RowDefinitions>
                                <Grid Grid.Row="0" Margin="0,0,0,4">
                                    <TextBlock Text="FRONT FACE" FontWeight="Bold" FontSize="10.5" Foreground="{DynamicResource AccentPrimaryBrush}"/>
                                    <TextBlock Text="85.60 × 53.98 mm" FontSize="9.5" Foreground="{DynamicResource TextMutedBrush}" HorizontalAlignment="Right"/>
                                </Grid>
                                <Border Grid.Row="1" Background="White" CornerRadius="4" ClipToBounds="True">
                                    <Image Source="{Binding FrontCardImage}" Stretch="Uniform" RenderOptions.BitmapScalingMode="HighQuality"/>
                                </Border>
                            </Grid>
                        </Border>

                        <!-- Back Card Face -->
                        <Border Grid.Row="1" Background="{DynamicResource CardSubtleBackgroundBrush}" BorderBrush="{DynamicResource BorderSubtleBrush}" BorderThickness="1" CornerRadius="6" Margin="0,0,0,8" Padding="6">
                            <Grid>
                                <Grid.RowDefinitions>
                                    <RowDefinition Height="Auto"/>
                                    <RowDefinition Height="*"/>
                                </Grid.RowDefinitions>
                                <Grid Grid.Row="0" Margin="0,0,0,4">
                                    <TextBlock Text="BACK FACE" FontWeight="Bold" FontSize="10.5" Foreground="{DynamicResource AccentPrimaryBrush}"/>
                                    <TextBlock Text="85.60 × 53.98 mm" FontSize="9.5" Foreground="{DynamicResource TextMutedBrush}" HorizontalAlignment="Right"/>
                                </Grid>
                                <Border Grid.Row="1" Background="White" CornerRadius="4" ClipToBounds="True">
                                    <Image Source="{Binding BackCardImage}" Stretch="Uniform" RenderOptions.BitmapScalingMode="HighQuality"/>
                                </Border>
                            </Grid>
                        </Border>
                    </Grid>

                    <!-- Quick Tools & Sheet Layout Selector -->
                    <StackPanel Grid.Row="2">
                        <!-- Quick Face Actions -->
                        <Grid Margin="0,0,0,10">
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="*"/>
                                <ColumnDefinition Width="6"/>
                                <ColumnDefinition Width="*"/>
                            </Grid.ColumnDefinitions>
                            <ui:Button Grid.Column="0" Command="{Binding SwapCardFacesCommand}" Content="Swap Faces" Height="30" FontSize="11" Style="{StaticResource SecondaryActionButtonStyle}"/>
                            <ui:Button Grid.Column="2" Command="{Binding RotateCards90Command}" Content="Rotate 90°" Height="30" FontSize="11" Style="{StaticResource SecondaryActionButtonStyle}"/>
                        </Grid>

                        <CheckBox IsChecked="{Binding IsMaskAadhaar}" Command="{Binding ToggleMaskAadhaarCommand}" Margin="0,0,0,6">
                            <TextBlock Text="Mask Aadhaar (Hide First 8 Digits)" FontSize="11" Foreground="{DynamicResource TextPrimaryBrush}"/>
                        </CheckBox>

                        <CheckBox IsChecked="{Binding ShowCutMarks}" Margin="0,0,0,6">
                            <TextBlock Text="Cut Guidelines (0.2 mm Crop Lines)" FontSize="11" Foreground="{DynamicResource TextPrimaryBrush}"/>
                        </CheckBox>

                        <CheckBox IsChecked="{Binding ShowFoldLine}" Margin="0,0,0,6">
                            <TextBlock Text="Center Folding Line (Crease Guide)" FontSize="11" Foreground="{DynamicResource TextPrimaryBrush}"/>
                        </CheckBox>

                        <CheckBox IsChecked="{Binding MirrorMode}" Margin="0,0,0,10">
                            <TextBlock Text="Mirror Mode (Dragon Sheet Reverse)" FontSize="11" Foreground="{DynamicResource TextPrimaryBrush}"/>
                        </CheckBox>

                        <Separator Margin="0,0,0,10"/>

                        <!-- One-Click Physical Sheet Layout Preset -->
                        <TextBlock Text="PHYSICAL SHEET ARRANGEMENT" Style="{StaticResource FormLabelStyle}" FontWeight="Bold" Margin="0,0,0,6"/>
                        <ComboBox ItemsSource="{Binding SheetLayoutOptions}" SelectedItem="{Binding SelectedSheetLayoutString}" Height="34" Margin="0,0,0,6"/>
                        <TextBlock Text="Automatically positions both cards on the chosen paper." Style="{StaticResource FormHelpStyle}"/>
                    </StackPanel>
                </Grid>
            </Border>

            <!-- ================= CENTER WORKSPACE: True Physical Sheet Canvas ================= -->
            <Border Grid.Column="1" Background="{DynamicResource PreviewCanvasBgBrush}" BorderBrush="{DynamicResource BorderSubtleBrush}" BorderThickness="1" CornerRadius="{StaticResource RadiusMedium}" Margin="0,0,10,0" ClipToBounds="True">
                <Grid>
                    <Grid.RowDefinitions>
                        <RowDefinition Height="Auto"/> <!-- Canvas Controls Strip -->
                        <RowDefinition Height="*"/>    <!-- Real Physical Sheet Image Viewport -->
                    </Grid.RowDefinitions>

                    <!-- Top Canvas Controls Strip -->
                    <Border Grid.Row="0" Background="{DynamicResource CardSurfaceBrush}" BorderBrush="{DynamicResource BorderSubtleBrush}" BorderThickness="0,0,0,1" Padding="12,6">
                        <Grid>
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="Auto"/>
                                <ColumnDefinition Width="*"/>
                                <ColumnDefinition Width="Auto"/>
                            </Grid.ColumnDefinitions>

                            <StackPanel Grid.Column="0" Orientation="Horizontal" VerticalAlignment="Center">
                                <TextBlock Text="PHYSICAL PRINT PREVIEW:" FontWeight="Bold" FontSize="11" Foreground="{DynamicResource TextSecondaryBrush}" Margin="0,0,6,0"/>
                                <TextBlock Text="{Binding PageDimensionsText}" FontWeight="SemiBold" FontSize="11" Foreground="{DynamicResource AccentPrimaryBrush}"/>
                            </StackPanel>

                            <!-- Calibration Nudge Shortcuts -->
                            <StackPanel Grid.Column="2" Orientation="Horizontal" VerticalAlignment="Center">
                                <CheckBox IsChecked="{Binding ShowCutMarks}" Command="{Binding ToggleCutMarksCommand}" Margin="0,0,10,0" VerticalAlignment="Center">
                                    <TextBlock Text="Cut Marks" FontSize="11" Foreground="{DynamicResource TextPrimaryBrush}"/>
                                </CheckBox>
                                <CheckBox IsChecked="{Binding MirrorMode}" Command="{Binding ToggleMirrorModeCommand}" Margin="0,0,14,0" VerticalAlignment="Center">
                                    <TextBlock Text="Mirror (Dragon Sheet)" FontSize="11" Foreground="{DynamicResource TextPrimaryBrush}"/>
                                </CheckBox>

                                <TextBlock Text="Nudge Offset:" FontSize="10.5" Foreground="{DynamicResource TextMutedBrush}" VerticalAlignment="Center" Margin="0,0,6,0"/>
                                <ui:Button Command="{Binding NudgeFineCommand}" CommandParameter="LEFT" Content="◀" Height="26" Width="26" Padding="0" FontSize="10" Margin="0,0,2,0" ToolTip="Nudge Left 0.1 mm"/>
                                <ui:Button Command="{Binding NudgeFineCommand}" CommandParameter="RIGHT" Content="▶" Height="26" Width="26" Padding="0" FontSize="10" Margin="0,0,4,0" ToolTip="Nudge Right 0.1 mm"/>
                                <ui:Button Command="{Binding NudgeFineCommand}" CommandParameter="UP" Content="▲" Height="26" Width="26" Padding="0" FontSize="10" Margin="0,0,2,0" ToolTip="Nudge Up 0.1 mm"/>
                                <ui:Button Command="{Binding NudgeFineCommand}" CommandParameter="DOWN" Content="▼" Height="26" Width="26" Padding="0" FontSize="10" Margin="0,0,4,0" ToolTip="Nudge Down 0.1 mm"/>
                                <ui:Button Command="{Binding NudgeFineCommand}" CommandParameter="RESET" Content="0" Height="26" Width="26" Padding="0" FontSize="10" ToolTip="Reset Offsets"/>
                            </StackPanel>
                        </Grid>
                    </Border>

                    <!-- Real Physical Sheet Image (Fitted to viewport, complete A4 paper visible with zero scroll!) -->
                    <Grid Grid.Row="1" Margin="16">
                        <Border Background="White" BorderBrush="#94A3B8" BorderThickness="1" CornerRadius="2" HorizontalAlignment="Center" VerticalAlignment="Center">
                            <Border.Effect>
                                <DropShadowEffect BlurRadius="16" ShadowDepth="4" Direction="270" Color="#000000" Opacity="0.25"/>
                            </Border.Effect>
                            <!-- Rendered Physical Sheet Bitmap from IPhysicalPageRenderService -->
                            <Image Source="{Binding SheetPreviewImage}" Stretch="Uniform" RenderOptions.BitmapScalingMode="HighQuality"/>
                        </Border>
                    </Grid>
                </Grid>
            </Border>

            <!-- ================= RIGHT PANEL: Hardware Spooler & Settings ================= -->
            <Border Grid.Column="2" Style="{StaticResource SurfaceCardStyle}" Padding="16">
                <Grid>
                    <Grid.RowDefinitions>
                        <RowDefinition Height="Auto"/>
                        <RowDefinition Height="*"/>
                        <RowDefinition Height="Auto"/>
                    </Grid.RowDefinitions>

                    <TextBlock Grid.Row="0" Text="PRODUCTION HARDWARE SETUP" Style="{StaticResource FormLabelStyle}" FontWeight="Bold" Margin="0,0,0,10"/>

                    <ScrollViewer Grid.Row="1" VerticalScrollBarVisibility="Auto" HorizontalScrollBarVisibility="Disabled">
                        <StackPanel>
                            <!-- Target Printer -->
                            <StackPanel Margin="0,0,0,12">
                                <TextBlock Text="Target Windows Printer:" Style="{StaticResource FormLabelStyle}"/>
                                <ComboBox ItemsSource="{Binding PrinterList}" SelectedItem="{Binding SelectedPrinter}" Height="34"/>
                            </StackPanel>

                            <!-- Copies & Price -->
                            <Grid Margin="0,0,0,12">
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="*"/>
                                    <ColumnDefinition Width="8"/>
                                    <ColumnDefinition Width="*"/>
                                </Grid.ColumnDefinitions>
                                <StackPanel Grid.Column="0">
                                    <TextBlock Text="Copies:" Style="{StaticResource FormLabelStyle}"/>
                                    <TextBox Text="{Binding Copies}" Height="34" VerticalContentAlignment="Center" FontSize="12.5"/>
                                </StackPanel>
                                <StackPanel Grid.Column="2">
                                    <TextBlock Text="Fee (₹):" Style="{StaticResource FormLabelStyle}"/>
                                    <TextBox Text="{Binding CardFee, StringFormat='F2'}" Height="34" VerticalContentAlignment="Center" FontWeight="Bold" FontSize="12.5"/>
                                </StackPanel>
                            </Grid>

                            <!-- Payment Mode -->
                            <StackPanel Margin="0,0,0,14">
                                <TextBlock Text="Payment Mode:" Style="{StaticResource FormLabelStyle}"/>
                                <ComboBox ItemsSource="{Binding PaymentModes}" SelectedItem="{Binding SelectedPaymentMode}" Height="34"/>
                            </StackPanel>

                            <!-- Pre-Flight Checklist -->
                            <Border Background="{DynamicResource CardSubtleBackgroundBrush}" BorderBrush="{DynamicResource BorderSubtleBrush}" BorderThickness="1" CornerRadius="6" Padding="12" Margin="0,0,0,14">
                                <StackPanel>
                                    <TextBlock Text="Quality &amp; Standards Verification" FontWeight="Bold" FontSize="11" Foreground="{DynamicResource TextPrimaryBrush}" Margin="0,0,0,6"/>
                                    <CheckBox IsChecked="True" Content="ISO/IEC 7810 CR80 (85.60 × 53.98 mm)" FontSize="10.5" IsEnabled="False" Margin="0,0,0,4"/>
                                    <CheckBox IsChecked="True" Content="Physical tray insertion aligned to feed arrow" FontSize="10.5" IsEnabled="False" Margin="0,0,0,4"/>
                                    <CheckBox IsChecked="True" Content="Zero-Citizen-PII: No citizen data stored" FontSize="10.5" IsEnabled="False"/>
                                </StackPanel>
                            </Border>

                            <!-- Success Banner -->
                            <Border Background="{DynamicResource StatusSuccessBgBrush}" BorderBrush="{DynamicResource BorderSubtleBrush}" BorderThickness="1" CornerRadius="6" Padding="10,8" Margin="0,0,0,10" Visibility="{Binding PrintSuccessAlert, Converter={StaticResource BooleanToVisibilityConverter}}">
                                <StackPanel Orientation="Horizontal">
                                    <TextBlock Text="✓" FontWeight="Bold" Foreground="{DynamicResource StatusSuccessFgBrush}" FontSize="15" Margin="0,0,8,0" VerticalAlignment="Center"/>
                                    <TextBlock Text="Job spooled successfully. Recorded in ledger." FontWeight="SemiBold" Foreground="{DynamicResource StatusSuccessFgBrush}" VerticalAlignment="Center" FontSize="11"/>
                                </StackPanel>
                            </Border>
                        </StackPanel>
                    </ScrollViewer>

                    <!-- HERO ACTION BUTTON (Big, prominent, explicit confirmation) -->
                    <ui:Button Grid.Row="2" Command="{Binding StartPrintingCommand}" Style="{StaticResource PrimaryActionButtonStyle}" Height="50" FontSize="14" HorizontalAlignment="Stretch">
                        <StackPanel Orientation="Horizontal">
                            <ui:SymbolIcon Symbol="Print24" Margin="0,0,8,0"/>
                            <TextBlock Text="START PRINTING" FontWeight="Bold"/>
                        </StackPanel>
                    </ui:Button>
                </Grid>
            </Border>
        </Grid>

        <!-- ROW 2: BOTTOM STATUS BAR -->
        <Border Grid.Row="2" Background="{DynamicResource CardSubtleBackgroundBrush}" BorderBrush="{DynamicResource BorderSubtleBrush}" BorderThickness="1" CornerRadius="4" Padding="10,6" Margin="0,8,0,0">
            <Grid>
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="*"/>
                    <ColumnDefinition Width="Auto"/>
                </Grid.ColumnDefinitions>
                <TextBlock Grid.Column="0" Text="{Binding StatusMessage}" FontSize="11" Foreground="{DynamicResource TextPrimaryBrush}" VerticalAlignment="Center"/>
                <TextBlock Grid.Column="1" Text="ISO/IEC 7810 CR80 Standard • 600 DPI Calibrated Spooler" FontSize="10.5" FontWeight="SemiBold" Foreground="{DynamicResource AccentPrimaryBrush}" VerticalAlignment="Center"/>
            </Grid>
        </Border>

        <!-- CROP ADJUSTMENT DRAWER OVERLAY (Fit-to-Window, Advanced Straighten, Free Crop & Multi-Card Options) -->
        <Border Grid.Row="0" Grid.RowSpan="3" Background="#90000000" Panel.ZIndex="100"
                Visibility="{Binding IsCropDrawerOpen, Converter={StaticResource BooleanToVisibilityConverter}, FallbackValue=Collapsed}">
            <Border Width="1040" Height="720" Style="{StaticResource SurfaceCardStyle}" HorizontalAlignment="Center" VerticalAlignment="Center" Padding="20">
                <Grid>
                    <Grid.RowDefinitions>
                        <RowDefinition Height="Auto"/> <!-- Header & Presets -->
                        <RowDefinition Height="*"/>    <!-- Canvas & Controls -->
                        <RowDefinition Height="Auto"/> <!-- Action Buttons -->
                    </Grid.RowDefinitions>

                    <!-- Drawer Header & Quick Aspect Ratio Presets -->
                    <Grid Grid.Row="0" Margin="0,0,0,12">
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="*"/>
                            <ColumnDefinition Width="Auto"/>
                            <ColumnDefinition Width="Auto"/>
                        </Grid.ColumnDefinitions>
                        <StackPanel Grid.Column="0">
                            <TextBlock Text="Advanced Card Crop &amp; Straighten Studio" FontSize="16" FontWeight="Bold" Foreground="{DynamicResource TextPrimaryBrush}"/>
                            <TextBlock Text="Fine tilt straighten (-45° to +45°), freeform unconstrained crop, ISO CR80, photo presets and perspective alignment" FontSize="11" Foreground="{DynamicResource TextSecondaryBrush}"/>
                        </StackPanel>

                        <!-- Aspect Ratio Presets & Mode -->
                        <StackPanel Grid.Column="1" Orientation="Horizontal" VerticalAlignment="Center" Margin="0,0,12,0">
                            <TextBlock Text="Preset:" VerticalAlignment="Center" FontSize="11" FontWeight="SemiBold" Foreground="{DynamicResource TextSecondaryBrush}" Margin="0,0,6,0"/>
                            <ui:Button Command="{Binding SetCropRatioCommand}" CommandParameter="CR80" Content="CR80 PVC (85.6×54)" Height="30" Margin="0,0,4,0" Padding="8,0" Style="{StaticResource SecondaryActionButtonStyle}"/>
                            <ui:Button Command="{Binding SetCropRatioCommand}" CommandParameter="Free" Content="Free Crop" Height="30" Margin="0,0,4,0" Padding="8,0" Style="{StaticResource SecondaryActionButtonStyle}"/>
                            <ui:Button Command="{Binding SetCropRatioCommand}" CommandParameter="Passport" Content="Passport (35×45)" Height="30" Margin="0,0,4,0" Padding="8,0" Style="{StaticResource SecondaryActionButtonStyle}"/>
                            <ui:Button Command="{Binding SetCropRatioCommand}" CommandParameter="Stamp" Content="Stamp (25×30)" Height="30" Margin="0,0,8,0" Padding="8,0" Style="{StaticResource SecondaryActionButtonStyle}"/>
                            <ui:Button Command="{Binding TogglePerspectiveCropModeCommand}" Content="Perspective Quad" Height="30" Padding="8,0" Style="{StaticResource SecondaryActionButtonStyle}"/>
                        </StackPanel>

                        <ui:Button Grid.Column="2" Command="{Binding CloseCropDrawerCommand}" Content="✕" Width="32" Height="32" CornerRadius="16" Padding="0" Style="{StaticResource SecondaryActionButtonStyle}"/>
                    </Grid>

                    <!-- Preview, Straighten Bar & Bounds Adjuster -->
                    <Grid Grid.Row="1" Margin="0,0,0,12">
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="*"/>
                            <ColumnDefinition Width="280"/>
                        </Grid.ColumnDefinitions>

                        <!-- Interactive Canvas & Straighten Toolbar -->
                        <Grid Grid.Column="0" Margin="0,0,14,0">
                            <Grid.RowDefinitions>
                                <RowDefinition Height="*"/>
                                <RowDefinition Height="Auto"/>
                            </Grid.RowDefinitions>

                            <!-- Interactive Visual Crop Canvas -->
                            <Border Grid.Row="0" Background="{DynamicResource NeutralSurfaceBrush}" CornerRadius="6" BorderBrush="{DynamicResource BorderSubtleBrush}" BorderThickness="1" ClipToBounds="True">
                                <controls:InteractiveCropCanvas
                                    SourceImage="{Binding CropSourceImage}"
                                    CropX="{Binding CropX, Mode=TwoWay}"
                                    CropY="{Binding CropY, Mode=TwoWay}"
                                    CropWidth="{Binding CropWidth, Mode=TwoWay}"
                                    CropHeight="{Binding CropHeight, Mode=TwoWay}"
                                    RotationAngle="{Binding StraightenAngle, Mode=TwoWay}"
                                    SelectedAspectRatio="{Binding SelectedCropRatio, Mode=TwoWay}"
                                    IsPerspectiveMode="{Binding IsPerspectiveCropMode, Mode=TwoWay}"
                                    Corner1X="{Binding CropCorner1X, Mode=TwoWay}"
                                    Corner1Y="{Binding CropCorner1Y, Mode=TwoWay}"
                                    Corner2X="{Binding CropCorner2X, Mode=TwoWay}"
                                    Corner2Y="{Binding CropCorner2Y, Mode=TwoWay}"
                                    Corner3X="{Binding CropCorner3X, Mode=TwoWay}"
                                    Corner3Y="{Binding CropCorner3Y, Mode=TwoWay}"
                                    Corner4X="{Binding CropCorner4X, Mode=TwoWay}"
                                    Corner4Y="{Binding CropCorner4Y, Mode=TwoWay}"/>
                            </Border>

                            <!-- Straighten Tilt Slider & Quick Rotation Controls -->
                            <Border Grid.Row="1" Background="{DynamicResource CardSubtleBackgroundBrush}" CornerRadius="6" BorderBrush="{DynamicResource BorderSubtleBrush}" BorderThickness="1" Margin="0,8,0,0" Padding="12,8">
                                <Grid>
                                    <Grid.ColumnDefinitions>
                                        <ColumnDefinition Width="Auto"/>
                                        <ColumnDefinition Width="*"/>
                                        <ColumnDefinition Width="Auto"/>
                                        <ColumnDefinition Width="Auto"/>
                                        <ColumnDefinition Width="Auto"/>
                                        <ColumnDefinition Width="Auto"/>
                                        <ColumnDefinition Width="Auto"/>
                                    </Grid.ColumnDefinitions>

                                    <StackPanel Grid.Column="0" Orientation="Horizontal" VerticalAlignment="Center" Margin="0,0,10,0">
                                        <ui:SymbolIcon Symbol="ArrowRotateClockwise24" Margin="0,0,6,0"/>
                                        <TextBlock Text="Straighten Tilt:" FontWeight="SemiBold" FontSize="11.5" VerticalAlignment="Center" Foreground="{DynamicResource TextPrimaryBrush}"/>
                                    </StackPanel>

                                    <!-- Fine Slider from -45 to +45 degrees -->
                                    <Slider Grid.Column="1"
                                            Minimum="-45" Maximum="45" SmallChange="0.5" LargeChange="5.0"
                                            Value="{Binding StraightenAngle, Mode=TwoWay}"
                                            VerticalAlignment="Center" Margin="0,0,10,0"/>

                                    <TextBlock Grid.Column="2"
                                               Text="{Binding StraightenAngle, StringFormat={}{0:F1}°}"
                                               FontWeight="Bold" FontSize="12" FontFamily="Consolas" Width="48"
                                               VerticalAlignment="Center" HorizontalAlignment="Center" Foreground="{DynamicResource AccentPrimaryBrush}"/>

                                    <ui:Button Grid.Column="3" Command="{Binding ResetStraightenAngleCommand}" Content="Reset 0°" Height="28" Padding="8,0" Margin="4,0" Style="{StaticResource SecondaryActionButtonStyle}"/>
                                    <ui:Button Grid.Column="4" Command="{Binding RotateCropCcwCommand}" Content="⟲ -90°" Height="28" Padding="8,0" Margin="2,0" Style="{StaticResource SecondaryActionButtonStyle}" ToolTip="Rotate 90 degrees counter-clockwise"/>
                                    <ui:Button Grid.Column="5" Command="{Binding RotateCropCwCommand}" Content="⟳ +90°" Height="28" Padding="8,0" Margin="2,0" Style="{StaticResource SecondaryActionButtonStyle}" ToolTip="Rotate 90 degrees clockwise"/>
                                    <ui:Button Grid.Column="6" Command="{Binding FlipCropHorizontalCommand}" Content="⇄ Flip" Height="28" Padding="8,0" Margin="2,0" Style="{StaticResource SecondaryActionButtonStyle}" ToolTip="Flip scan horizontally"/>
                                </Grid>
                            </Border>
                        </Grid>

                        <!-- Controls & Target Card Slot Column -->
                        <Border Grid.Column="1" Background="{DynamicResource CardSubtleBackgroundBrush}" CornerRadius="6" BorderBrush="{DynamicResource BorderSubtleBrush}" BorderThickness="1" Padding="14">
                            <ScrollViewer VerticalScrollBarVisibility="Auto">
                                <StackPanel>
                                    <TextBlock Text="Target Card Slot:" FontWeight="Bold" FontSize="11.5" Foreground="{DynamicResource TextPrimaryBrush}" Margin="0,0,0,4"/>
                                    <ComboBox ItemsSource="{Binding CropFaceOptions}" SelectedItem="{Binding CropTargetFace}" Height="32" Margin="0,0,0,12"/>

                                    <TextBlock Text="Crop Geometry (300 DPI px):" FontWeight="Bold" FontSize="11.5" Foreground="{DynamicResource TextPrimaryBrush}" Margin="0,0,0,6"/>

                                    <TextBlock Text="Left (X Offset):" FontSize="10.5" Foreground="{DynamicResource TextSecondaryBrush}"/>
                                    <TextBox Text="{Binding CropX, UpdateSourceTrigger=PropertyChanged}" Height="28" Margin="0,2,0,6"/>

                                    <TextBlock Text="Top (Y Offset):" FontSize="10.5" Foreground="{DynamicResource TextSecondaryBrush}"/>
                                    <TextBox Text="{Binding CropY, UpdateSourceTrigger=PropertyChanged}" Height="28" Margin="0,2,0,6"/>

                                    <TextBlock Text="Width:" FontSize="10.5" Foreground="{DynamicResource TextSecondaryBrush}"/>
                                    <TextBox Text="{Binding CropWidth, UpdateSourceTrigger=PropertyChanged}" Height="28" Margin="0,2,0,6"/>

                                    <TextBlock Text="Height:" FontSize="10.5" Foreground="{DynamicResource TextSecondaryBrush}"/>
                                    <TextBox Text="{Binding CropHeight, UpdateSourceTrigger=PropertyChanged}" Height="28" Margin="0,2,0,10"/>

                                    <!-- Quick Other Cards Presets -->
                                    <Border Background="{DynamicResource NeutralSurfaceBrush}" CornerRadius="4" Padding="10" Margin="0,0,0,10">
                                        <StackPanel>
                                            <TextBlock Text="Card Presets:" FontWeight="SemiBold" FontSize="11" Foreground="{DynamicResource TextPrimaryBrush}" Margin="0,0,0,6"/>
                                            <UniformGrid Columns="2" Margin="0,0,0,4">
                                                <ui:Button Command="{Binding SelectOtherCardOptionCommand}" CommandParameter="other_id_dual" Content="Other Dual ID" Height="26" Margin="1" Style="{StaticResource SecondaryActionButtonStyle}" FontSize="10"/>
                                                <ui:Button Command="{Binding SelectOtherCardOptionCommand}" CommandParameter="other_id_single" Content="Other Single ID" Height="26" Margin="1" Style="{StaticResource SecondaryActionButtonStyle}" FontSize="10"/>
                                                <ui:Button Command="{Binding SelectOtherCardOptionCommand}" CommandParameter="student_id" Content="Student ID" Height="26" Margin="1" Style="{StaticResource SecondaryActionButtonStyle}" FontSize="10"/>
                                                <ui:Button Command="{Binding SelectOtherCardOptionCommand}" CommandParameter="employee_badge" Content="Employee Badge" Height="26" Margin="1" Style="{StaticResource SecondaryActionButtonStyle}" FontSize="10"/>
                                            </UniformGrid>
                                        </StackPanel>
                                    </Border>

                                    <ui:Button Command="{Binding ResetCropToAutoCommand}" Style="{StaticResource SecondaryActionButtonStyle}" Content="Reset to Calibrated Bounds" HorizontalAlignment="Stretch" Margin="0,0,0,6"/>
                                </StackPanel>
                            </ScrollViewer>
                        </Border>
                    </Grid>

                    <!-- Footer Actions -->
                    <Grid Grid.Row="2">
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="*"/>
                            <ColumnDefinition Width="Auto"/>
                            <ColumnDefinition Width="Auto"/>
                        </Grid.ColumnDefinitions>

                        <StackPanel Grid.Column="0" VerticalAlignment="Center">
                            <TextBlock Text="Physical color invariant: Original native BGRA colors 100% preserved in display, PDF &amp; print." FontSize="10.5" Foreground="{DynamicResource AccentPrimaryBrush}"/>
                            <TextBlock Text="Selected ratio will be applied cleanly without squishing or aspect distortion." FontSize="10" Foreground="{DynamicResource TextSecondaryBrush}"/>
                        </StackPanel>
                        <ui:Button Grid.Column="1" Command="{Binding CloseCropDrawerCommand}" Style="{StaticResource SecondaryActionButtonStyle}" Content="Cancel" Height="36" Padding="16,0" Margin="0,0,8,0"/>
                        <ui:Button Grid.Column="2" Command="{Binding ApplyCustomCropCommand}" Style="{StaticResource PrimaryActionButtonStyle}" Content="Apply &amp; Update Layout" Height="36" Padding="20,0"/>
                    </Grid>
                </Grid>
            </Border>
        </Border>
    </Grid>
</UserControl>
