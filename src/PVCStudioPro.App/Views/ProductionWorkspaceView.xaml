<UserControl x:Class="PVCStudioPro.App.Views.ProductionWorkspaceView"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006" 
             xmlns:d="http://schemas.microsoft.com/expression/blend/2008" 
             xmlns:ui="http://schemas.lepo.co/wpfui/2022/xaml"
             xmlns:vm="clr-namespace:PVCStudioPro.App.ViewModels"
             xmlns:controls="clr-namespace:PVCStudioPro.App.Controls"
             mc:Ignorable="d" 
             d:DataContext="{d:DesignInstance Type=vm:ProductionWorkspaceViewModel}"
             d:DesignHeight="850" d:DesignWidth="1300"
             Focusable="True">

    <UserControl.InputBindings>
        <KeyBinding Key="Escape" Command="{Binding CloseCropDrawerCommand}"/>
    </UserControl.InputBindings>

    <Grid Margin="10,6,10,10">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto"/> <!-- Top Sub-Header Action Strip & Alerts -->
            <RowDefinition Height="*"/>    <!-- Split Stage: 8 Cols Canvas + 4 Cols Inspector -->
            <RowDefinition Height="Auto"/> <!-- Status Bar -->
        </Grid.RowDefinitions>

        <!-- ================= ROW 0: TOP SUB-HEADER ACTION STRIP & ALERTS ================= -->
        <StackPanel Grid.Row="0" Margin="0,0,0,8">
            <!-- Google Stitch Action Strip -->
            <Border Background="{DynamicResource StitchSurfaceBrush}" BorderBrush="{DynamicResource StitchSurfaceContainerHighBrush}" BorderThickness="1" CornerRadius="8" Padding="10,6" Margin="0,0,0,6">
                <Grid>
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="Auto"/> <!-- Document Source & Adaptive Telemetry -->
                        <ColumnDefinition Width="*"/>    <!-- Spacer -->
                        <ColumnDefinition Width="Auto"/> <!-- Pre-flight Controls Strip -->
                    </Grid.ColumnDefinitions>

                    <!-- Left: Document Source & 5-Stage Adaptive Telemetry -->
                    <StackPanel Grid.Column="0" Orientation="Horizontal" VerticalAlignment="Center">
                        <!-- Open Document CTA -->
                        <ui:Button Command="{Binding OpenDocumentFileDialogCommand}" Style="{StaticResource PrimaryActionButtonStyle}" Height="32" Padding="12,0" Margin="0,0,8,0" ToolTip="Open Aadhaar PDF, PAN, Voter, or Scanned Image (Ctrl+O)">
                            <StackPanel Orientation="Horizontal">
                                <TextBlock Text="📁 " FontSize="11" VerticalAlignment="Center"/>
                                <TextBlock Text="Open Document" FontWeight="Bold" FontSize="11" VerticalAlignment="Center"/>
                            </StackPanel>
                        </ui:Button>

                        <!-- File Metadata Pill -->
                        <Border Background="{DynamicResource StitchSurfaceContainerLowBrush}" BorderBrush="{DynamicResource StitchSurfaceContainerHighBrush}" BorderThickness="1" CornerRadius="6" Padding="8,4" Margin="0,0,6,0" VerticalAlignment="Center">
                            <StackPanel Orientation="Horizontal">
                                <TextBlock Text="📄 " FontSize="11" VerticalAlignment="Center"/>
                                <TextBlock Text="{Binding DetectedDocTitle, FallbackValue='No Document Loaded'}" FontWeight="SemiBold" FontSize="11" Foreground="{DynamicResource StitchTextPrimaryBrush}" VerticalAlignment="Center" MaxWidth="190" TextTrimming="CharacterEllipsis"/>
                                <Border Background="{DynamicResource StitchPrimaryContainerBrush}" CornerRadius="3" Padding="5,1" Margin="6,0,0,0" VerticalAlignment="Center">
                                    <TextBlock Text="600 DPI Vector" FontSize="9" FontWeight="Bold" Foreground="{DynamicResource StitchSecondaryContainerBrush}"/>
                                </Border>
                            </StackPanel>
                        </Border>

                        <!-- 5-Stage Adaptive AI Detection Telemetry Badge -->
                        <Border Background="{Binding ConfidenceBadgeBrush}" CornerRadius="6" Padding="8,4" Margin="0,0,6,0" VerticalAlignment="Center" Visibility="{Binding HasLoadedDocument, Converter={StaticResource BooleanToVisibilityConverter}}">
                            <StackPanel Orientation="Horizontal">
                                <TextBlock Text="🛡️ " FontSize="10" VerticalAlignment="Center"/>
                                <TextBlock Text="5-Stage: " FontWeight="SemiBold" FontSize="10.5" Foreground="{Binding ConfidenceTextBrush}" VerticalAlignment="Center"/>
                                <TextBlock Text="{Binding DetectedBadge}" FontWeight="Bold" FontSize="10.5" Foreground="{Binding ConfidenceTextBrush}" VerticalAlignment="Center"/>
                                <TextBlock Text=" • " FontSize="10" Foreground="{Binding ConfidenceTextBrush}" VerticalAlignment="Center"/>
                                <TextBlock Text="{Binding DetectionConfidenceSummary}" FontWeight="Bold" FontSize="10.5" Foreground="{Binding ConfidenceTextBrush}" VerticalAlignment="Center"/>
                            </StackPanel>
                        </Border>

                        <!-- Universal Template Selector -->
                        <ComboBox ItemsSource="{Binding TemplateOptions}"
                                  SelectedItem="{Binding SelectedTemplateOption}"
                                  DisplayMemberPath="FormattedLabel"
                                  Width="190" Height="30" Margin="0,0,6,0"
                                  ToolTip="Select or override calibrated government template"/>
                    </StackPanel>

                    <!-- Right: Pre-Flight Processing Controls -->
                    <StackPanel Grid.Column="2" Orientation="Horizontal" VerticalAlignment="Center">
                        <!-- Auto-Detect Bounds (Ctrl+D) -->
                        <ui:Button Command="{Binding AutoExtractCardsCommand}" Style="{StaticResource SecondaryActionButtonStyle}" Height="30" Padding="8,0" Margin="0,0,4,0" ToolTip="Auto-Detect Card Bounds (Ctrl+D)">
                            <StackPanel Orientation="Horizontal">
                                <TextBlock Text="✨ " FontSize="10" VerticalAlignment="Center"/>
                                <TextBlock Text="Auto-Detect" FontWeight="SemiBold" FontSize="10.5" VerticalAlignment="Center"/>
                            </StackPanel>
                        </ui:Button>

                        <!-- Fine Tilt Straighten Slider with 'ROT' label and angle readout -->
                        <Border Background="{DynamicResource StitchSurfaceContainerLowBrush}" BorderBrush="{DynamicResource StitchSurfaceContainerHighBrush}" BorderThickness="1" CornerRadius="6" Padding="6,2" Margin="0,0,4,0" VerticalAlignment="Center">
                            <StackPanel Orientation="Horizontal">
                                <TextBlock Text="ROT" FontWeight="Bold" FontSize="9" Foreground="{DynamicResource StitchTextSecondaryBrush}" VerticalAlignment="Center" Margin="0,0,4,0"/>
                                <Slider Minimum="-45" Maximum="45" SmallChange="0.5" LargeChange="5.0"
                                        Value="{Binding StraightenAngle, Mode=TwoWay}"
                                        Width="70" VerticalAlignment="Center" ToolTip="Fine Tilt Straighten (-45° to +45°)"/>
                                <TextBlock Text="{Binding StraightenAngle, StringFormat={}{0:+0.0;-0.0;0.0}°}"
                                           FontWeight="Bold" FontSize="10" FontFamily="Consolas" Width="38"
                                           TextAlignment="Right" VerticalAlignment="Center" Foreground="{DynamicResource StitchSecondaryBrush}" Margin="2,0,0,0"/>
                            </StackPanel>
                        </Border>

                        <!-- 90° CCW / CW Buttons -->
                        <ui:Button Command="{Binding RotateCropCcwCommand}" Content="⟲" Height="30" Width="28" Padding="0" FontSize="12" Margin="0,0,2,0" ToolTip="Rotate 90° CCW"/>
                        <ui:Button Command="{Binding RotateCropCwCommand}" Content="⟳" Height="30" Width="28" Padding="0" FontSize="12" Margin="0,0,4,0" ToolTip="Rotate 90° CW"/>

                        <!-- Shadow Purge Filter Toggle -->
                        <ToggleButton IsChecked="{Binding IsShadowPurge}" Command="{Binding ToggleShadowPurgeCommand}" Height="30" Padding="6,0" Margin="0,0,4,0" ToolTip="Shadow Purge illumination filter">
                            <StackPanel Orientation="Horizontal">
                                <TextBlock Text="☀️ " FontSize="10" VerticalAlignment="Center"/>
                                <TextBlock Text="Shadow Purge" FontSize="10" FontWeight="SemiBold" VerticalAlignment="Center"/>
                            </StackPanel>
                        </ToggleButton>

                        <!-- Mask First 8 UID Toggle -->
                        <ToggleButton IsChecked="{Binding IsMaskAadhaar}" Command="{Binding ToggleMaskAadhaarCommand}" Height="30" Padding="6,0" Margin="0,0,4,0" ToolTip="UIDAI Compliant Aadhaar Masking (First 8 Digits Redacted)">
                            <StackPanel Orientation="Horizontal">
                                <TextBlock Text="🔒 " FontSize="10" VerticalAlignment="Center"/>
                                <TextBlock Text="Mask UID" FontSize="10" FontWeight="SemiBold" VerticalAlignment="Center"/>
                                <Border Background="#006C4A" CornerRadius="3" Padding="3,1" Margin="3,0,0,0">
                                    <TextBlock Text="UIDAI" FontSize="8" FontWeight="Bold" Foreground="White"/>
                                </Border>
                            </StackPanel>
                        </ToggleButton>

                        <!-- Aspect Ratio Presets Selector -->
                        <ComboBox SelectedValuePath="Tag" SelectedValue="{Binding SelectedCropRatio}" Height="30" Width="130" Margin="0,0,4,0" ToolTip="Physical Card Aspect Ratio Standard">
                            <ComboBoxItem Content="ISO CR-80" Tag="Cr80Card"/>
                            <ComboBoxItem Content="Aadhaar Pouch" Tag="AadhaarFullPouch"/>
                            <ComboBoxItem Content="Passport (35×45)" Tag="PassportPhoto"/>
                            <ComboBoxItem Content="Stamp (25×30)" Tag="StampPhoto"/>
                            <ComboBoxItem Content="Freeform Crop" Tag="Freeform"/>
                        </ComboBox>
                    </StackPanel>
                </Grid>
            </Border>

            <!-- PASSWORD PROMPT BAR (Conditional - Appears only when required) -->
            <Border Background="#FEF3C7" BorderBrush="#FDE68A" BorderThickness="1" CornerRadius="6" Padding="12,8" Margin="0,0,0,6" Visibility="{Binding IsPasswordPromptVisible, Converter={StaticResource BooleanToVisibilityConverter}, FallbackValue=Collapsed}">
                <Grid>
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="Auto"/>
                        <ColumnDefinition Width="*"/>
                        <ColumnDefinition Width="Auto"/>
                    </Grid.ColumnDefinitions>
                    <TextBlock Grid.Column="0" Text="🔒 Document is Password-Protected. Enter PDF Password:" FontWeight="Bold" Foreground="#92400E" VerticalAlignment="Center" Margin="0,0,12,0"/>
                    <TextBox Grid.Column="1" Text="{Binding PasswordInput, UpdateSourceTrigger=PropertyChanged}" Height="32" VerticalContentAlignment="Center" Margin="0,0,12,0"/>
                    <ui:Button Grid.Column="2" Command="{Binding UnlockPasswordCommand}" Content="Unlock &amp; Extract Cards" Height="32" Padding="14,0" Background="#B45309" Foreground="White" FontWeight="Bold" CornerRadius="4"/>
                </Grid>
            </Border>

            <!-- LOW CONFIDENCE AMBER BANNER (Conditional - Appears when detection confidence < 85%) -->
            <Border Background="#FFFBEB" BorderBrush="#F59E0B" BorderThickness="1.5" CornerRadius="6" Padding="10,6" Margin="0,0,0,6"
                    Visibility="{Binding IsLowConfidenceBannerVisible, Converter={StaticResource BooleanToVisibilityConverter}, FallbackValue=Collapsed}">
                <Grid>
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="Auto"/>
                        <ColumnDefinition Width="*"/>
                        <ColumnDefinition Width="Auto"/>
                        <ColumnDefinition Width="8"/>
                        <ColumnDefinition Width="Auto"/>
                    </Grid.ColumnDefinitions>
                    <TextBlock Grid.Column="0" Text="⚠️" FontSize="14" VerticalAlignment="Center" Margin="0,0,10,0"/>
                    <StackPanel Grid.Column="1" VerticalAlignment="Center">
                        <TextBlock Text="{Binding LowConfidenceWarningTitle}" FontWeight="Bold" Foreground="#B45309" FontSize="11.5"/>
                        <TextBlock Text="{Binding LowConfidenceWarningDetails}" Foreground="#92400E" FontSize="10.5"/>
                    </StackPanel>
                    <ui:Button Grid.Column="2" Command="{Binding OpenCropDrawerCommand}" CommandParameter="Front Card" Content="Review &amp; Adjust Bounds" Height="28" Padding="10,0" Background="#F59E0B" Foreground="White" FontWeight="SemiBold" CornerRadius="4"/>
                    <ui:Button Grid.Column="4" Command="{Binding DismissLowConfidenceBannerCommand}" Content="Accept Auto Bounds" Height="28" Padding="10,0" Style="{StaticResource SecondaryActionButtonStyle}"/>
                </Grid>
            </Border>

            <!-- OPERATOR PRINT VERIFICATION BANNER (Conditional - Appears after SpoolerProcessingCompleted) -->
            <Border Background="#EFF6FF" BorderBrush="#3B82F6" BorderThickness="1.5" CornerRadius="6" Padding="10,6" Margin="0,0,0,6"
                    Visibility="{Binding IsReprintVerificationPromptVisible, Converter={StaticResource BooleanToVisibilityConverter}, FallbackValue=Collapsed}">
                <Grid>
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="Auto"/>
                        <ColumnDefinition Width="*"/>
                        <ColumnDefinition Width="Auto"/>
                        <ColumnDefinition Width="8"/>
                        <ColumnDefinition Width="Auto"/>
                    </Grid.ColumnDefinitions>
                    <TextBlock Grid.Column="0" Text="🖨️" FontSize="14" VerticalAlignment="Center" Margin="0,0,10,0"/>
                    <StackPanel Grid.Column="1" VerticalAlignment="Center">
                        <TextBlock Text="Print Spooled to Hardware — Please Verify Physical Card Output" FontWeight="Bold" Foreground="#1E40AF" FontSize="11.5"/>
                        <TextBlock Text="Check physical print quality for ribbon scuffs, banding, or misalignment before billing customer." Foreground="#1D4ED8" FontSize="10.5"/>
                    </StackPanel>
                    <ui:Button Grid.Column="2" Command="{Binding ConfirmPrintOutputCommand}" Content="✓ Print Verified (Confirm &amp; Bill)" Height="28" Padding="12,0" Background="#16A34A" Foreground="White" FontWeight="Bold" CornerRadius="4"/>
                    <ui:Button Grid.Column="4" Command="{Binding ReportDefectAndReprintCommand}" CommandParameter="MisalignedOrDefective" Content="⚠️ Defect / Reprint Needed" Height="28" Padding="12,0" Background="#DC2626" Foreground="White" FontWeight="SemiBold" CornerRadius="4"/>
                </Grid>
            </Border>
        </StackPanel>

        <!-- ================= ROW 1: SPLIT STAGE (8 COLS CANVAS + 4 COLS INSPECTOR) ================= -->
        <Grid Grid.Row="1">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="1.85*"/> <!-- Left 8 Cols: Dark Viewport Document Canvas -->
                <ColumnDefinition Width="385"/>    <!-- Right 4 Cols: Fluent Inspector -->
            </Grid.ColumnDefinitions>

            <!-- ================= LEFT 8 COLS: Dark Viewport Canvas Stage ================= -->
            <Border Grid.Column="0" Background="{DynamicResource StitchInverseSurfaceBrush}" BorderBrush="#16273E" BorderThickness="1" CornerRadius="8" Margin="0,0,10,0" ClipToBounds="True">
                <Grid>
                    <Grid.RowDefinitions>
                        <RowDefinition Height="Auto"/> <!-- Top Telemetry & Switcher Strip -->
                        <RowDefinition Height="*"/>    <!-- Main Central Document / Sheet Viewport -->
                        <RowDefinition Height="Auto"/> <!-- Bottom Footnote Strip -->
                    </Grid.RowDefinitions>

                    <!-- Top Telemetry & Canvas Mode Strip -->
                    <Border Grid.Row="0" Background="#162232" BorderBrush="#2D3F55" BorderThickness="0,0,0,1" Padding="10,6">
                        <Grid>
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="Auto"/>
                                <ColumnDefinition Width="*"/>
                                <ColumnDefinition Width="Auto"/>
                            </Grid.ColumnDefinitions>

                            <!-- Telemetry Chip -->
                            <StackPanel Grid.Column="0" Orientation="Horizontal" VerticalAlignment="Center">
                                <Border Background="#0E1C2F" BorderBrush="#006C4A" BorderThickness="1" CornerRadius="4" Padding="6,2">
                                    <StackPanel Orientation="Horizontal">
                                        <TextBlock Text="● " FontSize="8" Foreground="#85F8C4" VerticalAlignment="Center"/>
                                        <TextBlock Text="CANVAS: A4 600 DPI • OPENGL ACCELERATED" FontWeight="Bold" FontSize="9" Foreground="#85F8C4" VerticalAlignment="Center"/>
                                    </StackPanel>
                                </Border>
                            </StackPanel>

                            <!-- Canvas Mode Switcher Buttons -->
                            <StackPanel Grid.Column="1" Orientation="Horizontal" HorizontalAlignment="Center" VerticalAlignment="Center">
                                <ui:Button Command="{Binding SetCanvasTabCommand}" CommandParameter="0" Height="26" Padding="10,0" Margin="0,0,6,0"
                                           Background="#0E1C2F" Foreground="White" BorderBrush="#006C4A" BorderThickness="1" CornerRadius="4">
                                    <StackPanel Orientation="Horizontal">
                                        <TextBlock Text="📐 " FontSize="10" VerticalAlignment="Center"/>
                                        <TextBlock Text="Crop &amp; Loupe Studio" FontSize="10" FontWeight="SemiBold" VerticalAlignment="Center"/>
                                    </StackPanel>
                                </ui:Button>

                                <ui:Button Command="{Binding SetCanvasTabCommand}" CommandParameter="1" Height="26" Padding="10,0"
                                           Background="#0E1C2F" Foreground="White" BorderBrush="#334155" BorderThickness="1" CornerRadius="4">
                                    <StackPanel Orientation="Horizontal">
                                        <TextBlock Text="🖨️ " FontSize="10" VerticalAlignment="Center"/>
                                        <TextBlock Text="Print Sheet Layout" FontSize="10" FontWeight="SemiBold" VerticalAlignment="Center"/>
                                    </StackPanel>
                                </ui:Button>
                            </StackPanel>

                            <!-- Alignment Guidelines & Nudge Controls -->
                            <StackPanel Grid.Column="2" Orientation="Horizontal" VerticalAlignment="Center">
                                <CheckBox IsChecked="{Binding ShowCutMarks}" Command="{Binding ToggleCutMarksCommand}" Margin="0,0,6,0" VerticalAlignment="Center">
                                    <TextBlock Text="Cut" FontSize="10" Foreground="#CBD5E1"/>
                                </CheckBox>
                                <CheckBox IsChecked="{Binding ShowFoldLine}" Command="{Binding ToggleFoldLineCommand}" Margin="0,0,6,0" VerticalAlignment="Center">
                                    <TextBlock Text="Fold" FontSize="10" Foreground="#CBD5E1"/>
                                </CheckBox>
                                <CheckBox IsChecked="{Binding MirrorMode}" Command="{Binding ToggleMirrorModeCommand}" Margin="0,0,8,0" VerticalAlignment="Center">
                                    <TextBlock Text="Mirror" FontSize="10" Foreground="#CBD5E1"/>
                                </CheckBox>

                                <TextBlock Text="Nudge:" FontSize="9.5" Foreground="#94A3B8" VerticalAlignment="Center" Margin="0,0,3,0"/>
                                <ui:Button Command="{Binding NudgeFineCommand}" CommandParameter="LEFT" Content="◀" Height="22" Width="22" Padding="0" FontSize="8.5" Margin="0,0,2,0" ToolTip="Nudge Left 0.1 mm"/>
                                <ui:Button Command="{Binding NudgeFineCommand}" CommandParameter="RIGHT" Content="▶" Height="22" Width="22" Padding="0" FontSize="8.5" Margin="0,0,2,0" ToolTip="Nudge Right 0.1 mm"/>
                                <ui:Button Command="{Binding NudgeFineCommand}" CommandParameter="UP" Content="▲" Height="22" Width="22" Padding="0" FontSize="8.5" Margin="0,0,2,0" ToolTip="Nudge Up 0.1 mm"/>
                                <ui:Button Command="{Binding NudgeFineCommand}" CommandParameter="DOWN" Content="▼" Height="22" Width="22" Padding="0" FontSize="8.5" Margin="0,0,3,0" ToolTip="Nudge Down 0.1 mm"/>
                                <ui:Button Command="{Binding NudgeFineCommand}" CommandParameter="RESET" Content="0" Height="22" Width="22" Padding="0" FontSize="8.5" ToolTip="Reset Offsets"/>
                            </StackPanel>
                        </Grid>
                    </Border>

                    <!-- Central Document / Sheet Viewport Container -->
                    <Grid Grid.Row="1" Margin="8">
                        <TabControl SelectedIndex="{Binding ActiveCanvasTabIndex}" BorderThickness="0" Background="Transparent" Padding="0">
                            <TabControl.ItemContainerStyle>
                                <Style TargetType="TabItem">
                                    <Setter Property="Visibility" Value="Collapsed"/>
                                </Style>
                            </TabControl.ItemContainerStyle>

                            <!-- Tab 0: Interactive Visual Crop Canvas with Dual Bounds & Live 3x Loupe -->
                            <TabItem>
                                <Border Background="#162032" CornerRadius="6" BorderBrush="#283548" BorderThickness="1" ClipToBounds="True">
                                    <controls:InteractiveCropCanvas
                                        SourceImage="{Binding CropSourceImage}"
                                        CropX="{Binding CropX, Mode=TwoWay}"
                                        CropY="{Binding CropY, Mode=TwoWay}"
                                        CropWidth="{Binding CropWidth, Mode=TwoWay}"
                                        CropHeight="{Binding CropHeight, Mode=TwoWay}"
                                        RotationAngle="{Binding StraightenAngle, Mode=TwoWay}"
                                        SelectedAspectRatio="{Binding SelectedCropRatio, Mode=TwoWay}"
                                        IsPerspectiveMode="{Binding IsPerspectiveCropMode, Mode=TwoWay}"
                                        Corner1X="{Binding CropCorner1X, Mode=TwoWay}"
                                        Corner1Y="{Binding CropCorner1Y, Mode=TwoWay}"
                                        Corner2X="{Binding CropCorner2X, Mode=TwoWay}"
                                        Corner2Y="{Binding CropCorner2Y, Mode=TwoWay}"
                                        Corner3X="{Binding CropCorner3X, Mode=TwoWay}"
                                        Corner3Y="{Binding CropCorner3Y, Mode=TwoWay}"
                                        Corner4X="{Binding CropCorner4X, Mode=TwoWay}"
                                        Corner4Y="{Binding CropCorner4Y, Mode=TwoWay}"/>
                                </Border>
                            </TabItem>

                            <!-- Tab 1: Rendered Physical Sheet Layout on Real Paper -->
                            <TabItem>
                                <Grid Background="#162032">
                                    <Border Background="White" BorderBrush="#94A3B8" BorderThickness="1" CornerRadius="2" HorizontalAlignment="Center" VerticalAlignment="Center">
                                        <Border.Effect>
                                            <DropShadowEffect BlurRadius="16" ShadowDepth="4" Direction="270" Color="#000000" Opacity="0.35"/>
                                        </Border.Effect>
                                        <Image Source="{Binding SheetPreviewImage}" Stretch="Uniform" RenderOptions.BitmapScalingMode="HighQuality"/>
                                    </Border>
                                </Grid>
                            </TabItem>
                        </TabControl>
                    </Grid>

                    <!-- Bottom Footnote Strip -->
                    <Border Grid.Row="2" Background="#162232" BorderBrush="#2D3F55" BorderThickness="0,1,0,0" Padding="12,4">
                        <Grid>
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="Auto"/>
                                <ColumnDefinition Width="*"/>
                                <ColumnDefinition Width="Auto"/>
                            </Grid.ColumnDefinitions>
                            <StackPanel Grid.Column="0" Orientation="Horizontal">
                                <TextBlock Text="🟢 Front Crop Locked (ISO ID-1)" FontSize="9.5" FontWeight="SemiBold" Foreground="#34D399" Margin="0,0,12,0"/>
                                <TextBlock Text="🟣 Back Crop Synchronized" FontSize="9.5" FontWeight="SemiBold" Foreground="#A78BFA" Margin="0,0,12,0"/>
                                <TextBlock Text="Space + Drag to Pan Sheet" FontSize="9.5" Foreground="#94A3B8"/>
                            </StackPanel>
                            <TextBlock Grid.Column="2" Text="{Binding PageDimensionsText}" FontSize="9.5" FontWeight="SemiBold" Foreground="#64748B"/>
                        </Grid>
                    </Border>
                </Grid>
            </Border>

            <!-- ================= RIGHT 4 COLS: Fluent Inspector ================= -->
            <ScrollViewer Grid.Column="1" VerticalScrollBarVisibility="Auto" HorizontalScrollBarVisibility="Disabled">
                <StackPanel Margin="0,0,2,0">

                    <!-- PANEL 1: CROP GEOMETRY & ANCHORS -->
                    <Border Style="{StaticResource SurfaceCardStyle}" Padding="12" Margin="0,0,0,8">
                        <StackPanel>
                            <Grid Margin="0,0,0,8">
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="*"/>
                                    <ColumnDefinition Width="Auto"/>
                                </Grid.ColumnDefinitions>
                                <StackPanel Grid.Column="0" Orientation="Horizontal">
                                    <TextBlock Text="📐 " FontSize="12" VerticalAlignment="Center"/>
                                    <TextBlock Text="CROP GEOMETRY &amp; ANCHORS" FontWeight="Bold" FontSize="11" Foreground="{DynamicResource StitchTextPrimaryBrush}" VerticalAlignment="Center"/>
                                </StackPanel>
                                <Border Grid.Column="1" Background="#006C4A" CornerRadius="4" Padding="6,2">
                                    <TextBlock Text="ISO 7810 ID-1" FontWeight="Bold" FontSize="9" Foreground="White"/>
                                </Border>
                            </Grid>

                            <!-- Dual Card Coordinate Matrix (mm) -->
                            <Grid Margin="0,0,0,8">
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="*"/>
                                    <ColumnDefinition Width="6"/>
                                    <ColumnDefinition Width="*"/>
                                </Grid.ColumnDefinitions>

                                <!-- Front Card MM Box -->
                                <Border Grid.Column="0" Background="{DynamicResource StitchSurfaceContainerLowBrush}" BorderBrush="{DynamicResource StitchSurfaceContainerHighBrush}" BorderThickness="1" CornerRadius="6" Padding="8,6">
                                    <StackPanel>
                                        <TextBlock Text="FRONT (SLOT 1)" FontWeight="Bold" FontSize="9.5" Foreground="#006C4A" Margin="0,0,0,4"/>
                                        <Grid>
                                            <Grid.ColumnDefinitions>
                                                <ColumnDefinition Width="*"/>
                                                <ColumnDefinition Width="*"/>
                                            </Grid.ColumnDefinitions>
                                            <StackPanel Grid.Column="0">
                                                <TextBlock Text="X (mm):" FontSize="8.5" Foreground="{DynamicResource StitchTextSecondaryBrush}"/>
                                                <TextBlock Text="{Binding FrontCropXMm, StringFormat='{}{0:F1}'}" FontWeight="Bold" FontSize="10.5"/>
                                                <TextBlock Text="W (mm):" FontSize="8.5" Foreground="{DynamicResource StitchTextSecondaryBrush}" Margin="0,2,0,0"/>
                                                <TextBlock Text="{Binding FrontCropWMm, StringFormat='{}{0:F1}'}" FontWeight="Bold" FontSize="10.5"/>
                                            </StackPanel>
                                            <StackPanel Grid.Column="1">
                                                <TextBlock Text="Y (mm):" FontSize="8.5" Foreground="{DynamicResource StitchTextSecondaryBrush}"/>
                                                <TextBlock Text="{Binding FrontCropYMm, StringFormat='{}{0:F1}'}" FontWeight="Bold" FontSize="10.5"/>
                                                <TextBlock Text="H (mm):" FontSize="8.5" Foreground="{DynamicResource StitchTextSecondaryBrush}" Margin="0,2,0,0"/>
                                                <TextBlock Text="{Binding FrontCropHMm, StringFormat='{}{0:F1}'}" FontWeight="Bold" FontSize="10.5"/>
                                            </StackPanel>
                                        </Grid>
                                    </StackPanel>
                                </Border>

                                <!-- Back Card MM Box -->
                                <Border Grid.Column="2" Background="{DynamicResource StitchSurfaceContainerLowBrush}" BorderBrush="{DynamicResource StitchSurfaceContainerHighBrush}" BorderThickness="1" CornerRadius="6" Padding="8,6">
                                    <StackPanel>
                                        <TextBlock Text="BACK (SLOT 2)" FontWeight="Bold" FontSize="9.5" Foreground="#4F46E5" Margin="0,0,0,4"/>
                                        <Grid>
                                            <Grid.ColumnDefinitions>
                                                <ColumnDefinition Width="*"/>
                                                <ColumnDefinition Width="*"/>
                                            </Grid.ColumnDefinitions>
                                            <StackPanel Grid.Column="0">
                                                <TextBlock Text="X (mm):" FontSize="8.5" Foreground="{DynamicResource StitchTextSecondaryBrush}"/>
                                                <TextBlock Text="{Binding BackCropXMm, StringFormat='{}{0:F1}'}" FontWeight="Bold" FontSize="10.5"/>
                                                <TextBlock Text="W (mm):" FontSize="8.5" Foreground="{DynamicResource StitchTextSecondaryBrush}" Margin="0,2,0,0"/>
                                                <TextBlock Text="{Binding BackCropWMm, StringFormat='{}{0:F1}'}" FontWeight="Bold" FontSize="10.5"/>
                                            </StackPanel>
                                            <StackPanel Grid.Column="1">
                                                <TextBlock Text="Y (mm):" FontSize="8.5" Foreground="{DynamicResource StitchTextSecondaryBrush}"/>
                                                <TextBlock Text="{Binding BackCropYMm, StringFormat='{}{0:F1}'}" FontWeight="Bold" FontSize="10.5"/>
                                                <TextBlock Text="H (mm):" FontSize="8.5" Foreground="{DynamicResource StitchTextSecondaryBrush}" Margin="0,2,0,0"/>
                                                <TextBlock Text="{Binding BackCropHMm, StringFormat='{}{0:F1}'}" FontWeight="Bold" FontSize="10.5"/>
                                            </StackPanel>
                                        </Grid>
                                    </StackPanel>
                                </Border>
                            </Grid>

                            <!-- Magnetic Edge Snapping & Perspective Quad Buttons -->
                            <Grid Margin="0,0,0,6">
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="*"/>
                                    <ColumnDefinition Width="6"/>
                                    <ColumnDefinition Width="*"/>
                                </Grid.ColumnDefinitions>
                                <ToggleButton Grid.Column="0" IsChecked="{Binding IsMagneticSnapping}" Command="{Binding ToggleMagneticSnappingCommand}" Height="28" Padding="6,0" FontSize="10" ToolTip="Magnetic Edge Snapping to vector lines">
                                    <StackPanel Orientation="Horizontal">
                                        <TextBlock Text="🧲 " FontSize="9" VerticalAlignment="Center"/>
                                        <TextBlock Text="Edge Snapping" FontWeight="SemiBold" VerticalAlignment="Center"/>
                                    </StackPanel>
                                </ToggleButton>
                                <ToggleButton Grid.Column="2" IsChecked="{Binding IsPerspectiveCropMode}" Command="{Binding TogglePerspectiveCropModeCommand}" Height="28" Padding="6,0" FontSize="10" ToolTip="Homography 4-Point Unwarp">
                                    <StackPanel Orientation="Horizontal">
                                        <TextBlock Text="📐 " FontSize="9" VerticalAlignment="Center"/>
                                        <TextBlock Text="Perspective Quad" FontWeight="SemiBold" VerticalAlignment="Center"/>
                                    </StackPanel>
                                </ToggleButton>
                            </Grid>

                            <Grid>
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="*"/>
                                    <ColumnDefinition Width="6"/>
                                    <ColumnDefinition Width="*"/>
                                </Grid.ColumnDefinitions>
                                <ui:Button Grid.Column="0" Command="{Binding ResetCropToAutoCommand}" Style="{StaticResource SecondaryActionButtonStyle}" Height="28" Padding="4,0" FontSize="10" Content="Reset Bounds" ToolTip="Reset to AI Calibrated Bounds"/>
                                <ui:Button Grid.Column="2" Command="{Binding OpenSavePresetDialogCommand}" Style="{StaticResource SecondaryActionButtonStyle}" Height="28" Padding="4,0" FontSize="10" Content="Save Preset..." ToolTip="Save custom physical card dimensions"/>
                            </Grid>
                        </StackPanel>
                    </Border>

                    <!-- PANEL 2: REAL-TIME CROP PREVIEWS -->
                    <Border Style="{StaticResource SurfaceCardStyle}" Padding="12" Margin="0,0,0,8">
                        <StackPanel>
                            <Grid Margin="0,0,0,8">
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="*"/>
                                    <ColumnDefinition Width="Auto"/>
                                </Grid.ColumnDefinitions>
                                <StackPanel Grid.Column="0" Orientation="Horizontal">
                                    <TextBlock Text="👁️ " FontSize="12" VerticalAlignment="Center"/>
                                    <TextBlock Text="REAL-TIME CROP PREVIEWS" FontWeight="Bold" FontSize="11" Foreground="{DynamicResource StitchTextPrimaryBrush}" VerticalAlignment="Center"/>
                                </StackPanel>
                                <Border Grid.Column="1" Background="{DynamicResource StitchSurfaceContainerHighBrush}" CornerRadius="4" Padding="6,2">
                                    <TextBlock Text="1:1 SCALED" FontWeight="Bold" FontSize="9" Foreground="{DynamicResource StitchTextSecondaryBrush}"/>
                                </Border>
                            </Grid>

                            <!-- Previews Stack -->
                            <Grid Margin="0,0,0,8">
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="*"/>
                                    <ColumnDefinition Width="6"/>
                                    <ColumnDefinition Width="*"/>
                                </Grid.ColumnDefinitions>

                                <!-- Front Preview -->
                                <Border Grid.Column="0" Background="{DynamicResource StitchSurfaceContainerLowestBrush}" BorderBrush="{DynamicResource BorderSubtleBrush}" BorderThickness="1" CornerRadius="6" Padding="6">
                                    <StackPanel>
                                        <Grid Margin="0,0,0,4">
                                            <TextBlock Text="SLOT 1 • FRONT" FontWeight="Bold" FontSize="9" Foreground="#006C4A"/>
                                            <Border Background="#006C4A" CornerRadius="3" Padding="4,1" HorizontalAlignment="Right" Visibility="{Binding IsMaskAadhaar, Converter={StaticResource BooleanToVisibilityConverter}}">
                                                <TextBlock Text="MASKED" FontSize="7.5" FontWeight="Bold" Foreground="White"/>
                                            </Border>
                                        </Grid>
                                        <Border Height="95" Background="White" CornerRadius="4" ClipToBounds="True">
                                            <Image Source="{Binding FrontCardImage}" Stretch="Uniform" RenderOptions.BitmapScalingMode="HighQuality"/>
                                        </Border>
                                    </StackPanel>
                                </Border>

                                <!-- Back Preview -->
                                <Border Grid.Column="2" Background="{DynamicResource StitchSurfaceContainerLowestBrush}" BorderBrush="{DynamicResource BorderSubtleBrush}" BorderThickness="1" CornerRadius="6" Padding="6">
                                    <StackPanel>
                                        <Grid Margin="0,0,0,4">
                                            <TextBlock Text="SLOT 2 • BACK" FontWeight="Bold" FontSize="9" Foreground="#4F46E5"/>
                                            <Border Background="#4F46E5" CornerRadius="3" Padding="4,1" HorizontalAlignment="Right">
                                                <TextBlock Text="QR OK" FontSize="7.5" FontWeight="Bold" Foreground="White"/>
                                            </Border>
                                        </Grid>
                                        <Border Height="95" Background="White" CornerRadius="4" ClipToBounds="True">
                                            <Image Source="{Binding BackCardImage}" Stretch="Uniform" RenderOptions.BitmapScalingMode="HighQuality"/>
                                        </Border>
                                    </StackPanel>
                                </Border>
                            </Grid>

                            <!-- Face Actions -->
                            <Grid>
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="*"/>
                                    <ColumnDefinition Width="6"/>
                                    <ColumnDefinition Width="*"/>
                                </Grid.ColumnDefinitions>
                                <ui:Button Grid.Column="0" Command="{Binding SwapCardFacesCommand}" Style="{StaticResource SecondaryActionButtonStyle}" Height="28" Padding="4,0" FontSize="10.5" Content="⇄ Swap Faces"/>
                                <ui:Button Grid.Column="2" Command="{Binding RotateCards90Command}" Style="{StaticResource SecondaryActionButtonStyle}" Height="28" Padding="4,0" FontSize="10.5" Content="↻ Rotate 90°"/>
                            </Grid>
                        </StackPanel>
                    </Border>

                    <!-- PANEL 3: PIPELINE TELEMETRY -->
                    <Border Style="{StaticResource SurfaceCardStyle}" Padding="12" Margin="0,0,0,8">
                        <StackPanel>
                            <Grid Margin="0,0,0,6">
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="*"/>
                                    <ColumnDefinition Width="Auto"/>
                                </Grid.ColumnDefinitions>
                                <StackPanel Grid.Column="0" Orientation="Horizontal">
                                    <TextBlock Text="⚡ " FontSize="11" VerticalAlignment="Center"/>
                                    <TextBlock Text="PIPELINE TELEMETRY" FontWeight="Bold" FontSize="11" Foreground="{DynamicResource StitchTextPrimaryBrush}" VerticalAlignment="Center"/>
                                </StackPanel>
                                <Border Grid.Column="1" Background="#ECFDF5" BorderBrush="#059669" BorderThickness="1" CornerRadius="4" Padding="6,1">
                                    <TextBlock Text="ZERO-LOSS RGB" FontWeight="Bold" FontSize="8.5" Foreground="#047857"/>
                                </Border>
                            </Grid>

                            <Grid Margin="0,2,0,2">
                                <TextBlock Text="Render Engine:" FontSize="9.5" Foreground="{DynamicResource StitchTextSecondaryBrush}"/>
                                <TextBlock Text="{Binding RenderingEngineInfo}" FontWeight="SemiBold" FontSize="9.5" HorizontalAlignment="Right" Foreground="{DynamicResource StitchTextPrimaryBrush}"/>
                            </Grid>
                            <Grid Margin="0,2,0,2">
                                <TextBlock Text="Rasterizer DPI:" FontSize="9.5" Foreground="{DynamicResource StitchTextSecondaryBrush}"/>
                                <TextBlock Text="{Binding OutputDpiInfo}" FontWeight="SemiBold" FontSize="9.5" HorizontalAlignment="Right" Foreground="{DynamicResource StitchTextPrimaryBrush}"/>
                            </Grid>
                            <Grid Margin="0,2,0,2">
                                <TextBlock Text="Safe Memory Lease:" FontSize="9.5" Foreground="{DynamicResource StitchTextSecondaryBrush}"/>
                                <TextBlock Text="{Binding MemoryLeaseInfo}" FontWeight="SemiBold" FontSize="9.5" HorizontalAlignment="Right" Foreground="#006C4A"/>
                            </Grid>
                            <Grid Margin="0,2,0,0">
                                <TextBlock Text="Color Gamut:" FontSize="9.5" Foreground="{DynamicResource StitchTextSecondaryBrush}"/>
                                <TextBlock Text="Rec.709 sRGB Preserved" FontWeight="SemiBold" FontSize="9.5" HorizontalAlignment="Right" Foreground="{DynamicResource StitchTextPrimaryBrush}"/>
                            </Grid>
                        </StackPanel>
                    </Border>

                    <!-- PANEL 4: PHYSICAL TRAY ROUTING & DIRECT SPOOL DOCK -->
                    <Border Style="{StaticResource SurfaceCardStyle}" Padding="12" Margin="0,0,0,4">
                        <StackPanel>
                            <Grid Margin="0,0,0,8">
                                <StackPanel Orientation="Horizontal">
                                    <TextBlock Text="🖨️ " FontSize="12" VerticalAlignment="Center"/>
                                    <TextBlock Text="PHYSICAL TRAY ROUTING &amp; SPOOL" FontWeight="Bold" FontSize="11" Foreground="{DynamicResource StitchTextPrimaryBrush}" VerticalAlignment="Center"/>
                                </StackPanel>
                            </Grid>

                            <!-- Active Jig Pill -->
                            <Border Background="{DynamicResource StitchSurfaceContainerLowBrush}" BorderBrush="{DynamicResource StitchSurfaceContainerHighBrush}" BorderThickness="1" CornerRadius="5" Padding="8,4" Margin="0,0,0,8">
                                <StackPanel Orientation="Horizontal">
                                    <TextBlock Text="JIG: " FontWeight="Bold" FontSize="9.5" Foreground="{DynamicResource StitchSecondaryBrush}"/>
                                    <TextBlock Text="{Binding ActiveJigName}" FontWeight="SemiBold" FontSize="9.5" Foreground="{DynamicResource StitchTextPrimaryBrush}"/>
                                </StackPanel>
                            </Border>

                            <!-- Target Windows Printer -->
                            <StackPanel Margin="0,0,0,6">
                                <TextBlock Text="Target Windows Printer:" FontSize="10" FontWeight="SemiBold" Foreground="{DynamicResource StitchTextSecondaryBrush}" Margin="0,0,0,2"/>
                                <ComboBox ItemsSource="{Binding PrinterList}" SelectedItem="{Binding SelectedPrinter}" Height="30" FontSize="11"/>
                            </StackPanel>

                            <!-- Copies & Fee -->
                            <Grid Margin="0,0,0,6">
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="*"/>
                                    <ColumnDefinition Width="6"/>
                                    <ColumnDefinition Width="*"/>
                                </Grid.ColumnDefinitions>
                                <StackPanel Grid.Column="0">
                                    <TextBlock Text="Copies:" FontSize="10" FontWeight="SemiBold" Foreground="{DynamicResource StitchTextSecondaryBrush}" Margin="0,0,0,2"/>
                                    <TextBox Text="{Binding Copies}" Height="30" VerticalContentAlignment="Center" FontSize="11"/>
                                </StackPanel>
                                <StackPanel Grid.Column="2">
                                    <TextBlock Text="Fee (₹):" FontSize="10" FontWeight="SemiBold" Foreground="{DynamicResource StitchTextSecondaryBrush}" Margin="0,0,0,2"/>
                                    <TextBox Text="{Binding CardFee, StringFormat='F2'}" Height="30" VerticalContentAlignment="Center" FontWeight="Bold" FontSize="11"/>
                                </StackPanel>
                            </Grid>

                            <!-- Payment Mode -->
                            <StackPanel Margin="0,0,0,8">
                                <TextBlock Text="Payment Mode:" FontSize="10" FontWeight="SemiBold" Foreground="{DynamicResource StitchTextSecondaryBrush}" Margin="0,0,0,2"/>
                                <ComboBox ItemsSource="{Binding PaymentModes}" SelectedItem="{Binding SelectedPaymentMode}" Height="30" FontSize="11"/>
                            </StackPanel>

                            <!-- Print Success Alert -->
                            <Border Background="#ECFDF5" BorderBrush="#059669" BorderThickness="1" CornerRadius="6" Padding="8,6" Margin="0,0,0,8" Visibility="{Binding PrintSuccessAlert, Converter={StaticResource BooleanToVisibilityConverter}}">
                                <StackPanel Orientation="Horizontal">
                                    <TextBlock Text="✓ " FontWeight="Bold" Foreground="#047857" FontSize="13" VerticalAlignment="Center"/>
                                    <TextBlock Text="Job spooled successfully. Recorded in ledger." FontWeight="SemiBold" Foreground="#047857" VerticalAlignment="Center" FontSize="10.5"/>
                                </StackPanel>
                            </Border>

                            <!-- PRIMARY ACTION CTA: Direct Winspool (F5) -->
                            <ui:Button Command="{Binding StartPrintingCommand}" Height="44" Background="#006C4A" Foreground="White" BorderBrush="#004D34" BorderThickness="1" CornerRadius="6" HorizontalAlignment="Stretch" Margin="0,0,0,6">
                                <StackPanel Orientation="Horizontal">
                                    <TextBlock Text="⚡ " FontSize="14" VerticalAlignment="Center"/>
                                    <TextBlock Text="SEND TO PRINT TRAY (F5)" FontWeight="Bold" FontSize="12" VerticalAlignment="Center"/>
                                </StackPanel>
                            </ui:Button>

                            <!-- Secondary Actions -->
                            <Grid>
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="*"/>
                                    <ColumnDefinition Width="4"/>
                                    <ColumnDefinition Width="*"/>
                                    <ColumnDefinition Width="4"/>
                                    <ColumnDefinition Width="*"/>
                                </Grid.ColumnDefinitions>
                                <ui:Button Grid.Column="0" Command="{Binding ExportPdfCommand}" Style="{StaticResource SecondaryActionButtonStyle}" Height="28" Padding="2,0" FontSize="10" Content="Export PDF" ToolTip="Export Dual PDF (Ctrl+S)"/>
                                <ui:Button Grid.Column="2" Command="{Binding PurgeMemoryCommand}" Style="{StaticResource SecondaryActionButtonStyle}" Height="28" Padding="2,0" FontSize="10" Content="Purge RAM" ToolTip="Clear cached page leases"/>
                                <ui:Button Grid.Column="4" Command="{Binding SaveProjectCommand}" Style="{StaticResource SecondaryActionButtonStyle}" Height="28" Padding="2,0" FontSize="10" Content="Save Proj" ToolTip="Save project file"/>
                            </Grid>
                        </StackPanel>
                    </Border>
                </StackPanel>
            </ScrollViewer>
        </Grid>

        <!-- ================= ROW 2: STATUS BAR ================= -->
        <Border Grid.Row="2" Background="{DynamicResource CardSubtleBackgroundBrush}" BorderBrush="{DynamicResource BorderSubtleBrush}" BorderThickness="1" CornerRadius="4" Padding="10,4" Margin="0,6,0,0">
            <Grid>
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="*"/>
                    <ColumnDefinition Width="Auto"/>
                </Grid.ColumnDefinitions>
                <TextBlock Grid.Column="0" Text="{Binding StatusMessage}" FontSize="10.5" Foreground="{DynamicResource TextPrimaryBrush}" VerticalAlignment="Center"/>
                <TextBlock Grid.Column="1" Text="ISO/IEC 7810 CR80 Standard • 600 DPI Calibrated Spooler" FontSize="10" FontWeight="SemiBold" Foreground="{DynamicResource AccentPrimaryBrush}" VerticalAlignment="Center"/>
            </Grid>
        </Border>

        <!-- SAVE CUSTOM PRESET MODAL DIALOG -->
        <Border Background="{DynamicResource ModalBackdropBrush}"
                Visibility="{Binding IsSavePresetDialogOpen, Converter={StaticResource BooleanToVisibilityConverter}, FallbackValue=Collapsed}"
                VerticalAlignment="Stretch" HorizontalAlignment="Stretch" Panel.ZIndex="200">
            <Border Style="{StaticResource SurfaceCardStyle}"
                    Width="440" HorizontalAlignment="Center" VerticalAlignment="Center" Padding="24">
                <StackPanel>
                    <TextBlock Text="Save Custom Card Layout Preset" FontSize="16" FontWeight="Bold" Foreground="{DynamicResource TextPrimaryBrush}" Margin="0,0,0,6"/>
                    <TextBlock Text="Save these physical dimensions so you can instantly select this card size from the presets dropdown in any future session." FontSize="11.5" Foreground="{DynamicResource TextSecondaryBrush}" TextWrapping="Wrap" Margin="0,0,0,16"/>

                    <TextBlock Text="Preset Name / Label:" FontWeight="SemiBold" FontSize="11" Foreground="{DynamicResource TextPrimaryBrush}" Margin="0,0,0,4"/>
                    <TextBox Text="{Binding CustomPresetName, UpdateSourceTrigger=PropertyChanged}" MinHeight="34" Padding="8,4" VerticalContentAlignment="Center" Margin="0,0,0,12"/>

                    <Border Background="{DynamicResource NeutralSurfaceBrush}" CornerRadius="4" Padding="12,8" Margin="0,0,0,20">
                        <StackPanel Orientation="Horizontal" HorizontalAlignment="Center">
                            <TextBlock Text="Saved Physical Geometry: " FontSize="11" Foreground="{DynamicResource TextSecondaryBrush}"/>
                            <TextBlock Text="{Binding CustomCardWidthMm, StringFormat='{}{0:0.0}'}" FontWeight="Bold" FontSize="11" Foreground="{DynamicResource AccentPrimaryBrush}"/>
                            <TextBlock Text=" × " FontSize="11" Foreground="{DynamicResource TextSecondaryBrush}"/>
                            <TextBlock Text="{Binding CustomCardHeightMm, StringFormat='{}{0:0.0}'}" FontWeight="Bold" FontSize="11" Foreground="{DynamicResource AccentPrimaryBrush}"/>
                            <TextBlock Text=" mm" FontSize="11" Foreground="{DynamicResource TextSecondaryBrush}"/>
                        </StackPanel>
                    </Border>

                    <Grid>
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="*"/>
                            <ColumnDefinition Width="Auto"/>
                            <ColumnDefinition Width="8"/>
                            <ColumnDefinition Width="Auto"/>
                        </Grid.ColumnDefinitions>
                        <ui:Button Grid.Column="1" Command="{Binding CloseSavePresetDialogCommand}" Style="{StaticResource SecondaryActionButtonStyle}" Content="Cancel" Height="34" Padding="16,0"/>
                        <ui:Button Grid.Column="3" Command="{Binding ConfirmSavePresetCommand}" Style="{StaticResource PrimaryActionButtonStyle}" Content="Save Preset" Height="34" Padding="20,0"/>
                    </Grid>
                </StackPanel>
            </Border>
        </Border>

        <!-- GLOBAL ASYNC LOADING OVERLAY -->
        <Border Background="{DynamicResource ModalBackdropBrush}"
                Visibility="{Binding IsProcessing, Converter={StaticResource BooleanToVisibilityConverter}, FallbackValue=Collapsed}"
                VerticalAlignment="Stretch" HorizontalAlignment="Stretch" Panel.ZIndex="300">
            <Border Style="{StaticResource SurfaceCardStyle}"
                    Width="320" HorizontalAlignment="Center" VerticalAlignment="Center" Padding="24">
                <StackPanel HorizontalAlignment="Center">
                    <ProgressBar IsIndeterminate="True" Height="4" Margin="0,0,0,16" Foreground="{DynamicResource AccentPrimaryBrush}"/>
                    <TextBlock Text="Processing Document..." FontWeight="Bold" FontSize="13" Foreground="{DynamicResource TextPrimaryBrush}" HorizontalAlignment="Center" Margin="0,0,0,6"/>
                    <TextBlock Text="{Binding StatusMessage}" FontSize="11" Foreground="{DynamicResource TextSecondaryBrush}" HorizontalAlignment="Center" TextAlignment="Center" TextWrapping="Wrap"/>
                </StackPanel>
            </Border>
        </Border>
    </Grid>
</UserControl>