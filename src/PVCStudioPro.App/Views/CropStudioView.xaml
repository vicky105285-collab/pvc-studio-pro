<UserControl x:Class="PVCStudioPro.App.Views.CropStudioView"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
             xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
             xmlns:ui="http://schemas.lepo.co/wpfui/2022/xaml"
             xmlns:vm="clr-namespace:PVCStudioPro.App.ViewModels"
             mc:Ignorable="d" 
             d:DataContext="{d:DesignInstance Type=vm:CropStudioViewModel}"
             d:DesignHeight="900" d:DesignWidth="1300"
             Loaded="UserControl_Loaded">

    <Grid Margin="16,8,16,16">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto"/> <!-- Top Controls & Presets -->
            <RowDefinition Height="*"/>    <!-- Left Canvas + Right Preview Split -->
            <RowDefinition Height="Auto"/> <!-- Status Bar -->
        </Grid.RowDefinitions>

        <!-- ROW 0: Toolbar & Aspect Ratio Presets -->
        <Border Grid.Row="0" Background="{DynamicResource NeutralSurfaceBrush}" BorderBrush="{DynamicResource NeutralBorderBrush}" BorderThickness="1" CornerRadius="8" Padding="14,10" Margin="0,0,0,10">
            <Grid>
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="Auto"/>
                    <ColumnDefinition Width="*"/>
                    <ColumnDefinition Width="Auto"/>
                </Grid.ColumnDefinitions>

                <!-- Title & Presets -->
                <StackPanel Grid.Column="0" Orientation="Horizontal" VerticalAlignment="Center">
                    <TextBlock Text="Crop Studio" FontSize="17" FontWeight="Bold" Foreground="{DynamicResource TextPrimaryBrush}" Margin="0,0,14,0" VerticalAlignment="Center"/>

                    <!-- Presets -->
                    <TextBlock Text="Preset:" FontWeight="SemiBold" VerticalAlignment="Center" Margin="0,0,6,0" Foreground="{DynamicResource TextSecondaryBrush}" FontSize="12"/>
                    <ui:Button Command="{Binding SetAspectRatioCommand}" CommandParameter="Cr80Card" Content="CR80 Card (85.6 × 54 mm)" Height="30" Padding="8,0" FontSize="11" FontWeight="SemiBold" CornerRadius="4" Margin="0,0,4,0"/>
                    <ui:Button Command="{Binding SetAspectRatioCommand}" CommandParameter="PassportPhoto" Content="Passport (35 × 45 mm)" Height="30" Padding="8,0" FontSize="11" FontWeight="SemiBold" CornerRadius="4" Margin="0,0,4,0"/>
                    <ui:Button Command="{Binding SetAspectRatioCommand}" CommandParameter="StampPhoto" Content="Stamp (25 × 30 mm)" Height="30" Padding="8,0" FontSize="11" FontWeight="SemiBold" CornerRadius="4" Margin="0,0,4,0"/>
                    <ui:Button Command="{Binding SetAspectRatioCommand}" CommandParameter="Freeform" Content="Freeform" Height="30" Padding="8,0" FontSize="11" FontWeight="SemiBold" CornerRadius="4" Margin="0,0,12,0"/>

                    <ui:Button Command="{Binding TogglePerspectiveModeCommand}" Content="Perspective Quad Mode" Height="30" Padding="10,0" FontSize="11" FontWeight="Bold" CornerRadius="4" Background="{DynamicResource CardSurfaceBrush}" BorderBrush="{DynamicResource PrimaryAccentBrush}" BorderThickness="1"/>
                </StackPanel>

                <!-- Zoom Controls -->
                <StackPanel Grid.Column="1" Orientation="Horizontal" HorizontalAlignment="Center" VerticalAlignment="Center">
                    <TextBlock Text="Zoom:" FontWeight="SemiBold" VerticalAlignment="Center" Margin="0,0,6,0" Foreground="{DynamicResource TextSecondaryBrush}" FontSize="12"/>
                    <ui:Button Command="{Binding ZoomOutCommand}" Content="-" Width="26" Height="26" Padding="0" FontWeight="Bold" CornerRadius="3" Margin="0,0,4,0"/>
                    <Slider Minimum="0.10" Maximum="3.0" Value="{Binding ZoomFactor, Mode=TwoWay}" Width="110" VerticalAlignment="Center" Margin="0,0,4,0"/>
                    <ui:Button Command="{Binding ZoomInCommand}" Content="+" Width="26" Height="26" Padding="0" FontWeight="Bold" CornerRadius="3" Margin="0,0,6,0"/>
                    <TextBlock Text="{Binding ZoomFactor, StringFormat='{}{0:P0}'}" Width="45" VerticalAlignment="Center" FontSize="11" Foreground="{DynamicResource TextPrimaryBrush}"/>
                    <ui:Button Command="{Binding FitToWindowCommand}" Content="Fit" Height="26" Padding="8,0" FontSize="11" CornerRadius="3" Margin="0,0,4,0"/>
                    <ui:Button Command="{Binding ActualSizeCommand}" Content="100%" Height="26" Padding="8,0" FontSize="11" CornerRadius="3"/>
                </StackPanel>

                <!-- Tools -->
                <StackPanel Grid.Column="2" Orientation="Horizontal" VerticalAlignment="Center">
                    <ui:Button Command="{Binding Rotate90Command}" Content="Rotate 90°" Height="30" Padding="8,0" FontSize="11" FontWeight="SemiBold" CornerRadius="4" Margin="0,0,4,0"/>
                    <ui:Button Command="{Binding FlipHorizontalCommand}" Content="Flip" Height="30" Padding="8,0" FontSize="11" FontWeight="SemiBold" CornerRadius="4" Margin="0,0,4,0"/>
                    <ui:Button Command="{Binding ResetCropCornersCommand}" Content="Reset Box" Height="30" Padding="8,0" FontSize="11" FontWeight="SemiBold" CornerRadius="4" Margin="0,0,10,0"/>
                    <ui:Button Command="{Binding CancelCommand}" Content="Back to Desk" Height="30" Padding="12,0" FontSize="11" FontWeight="Bold" CornerRadius="4" Background="{DynamicResource NeutralSurfaceBrush}" BorderBrush="{DynamicResource NeutralBorderBrush}" BorderThickness="1"/>
                </StackPanel>
            </Grid>
        </Border>

        <!-- ROW 1: Split View (Interactive Canvas + Right Tools/Preview) -->
        <Grid Grid.Row="1">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="7*"/> <!-- Interactive Canvas Viewport -->
                <ColumnDefinition Width="10"/> <!-- Splitter -->
                <ColumnDefinition Width="4*"/> <!-- Output, Adjustments & Assignment -->
            </Grid.ColumnDefinitions>

            <!-- LEFT: Interactive Canvas Viewport -->
            <Border Grid.Column="0" Background="{DynamicResource PreviewCanvasBgBrush}" BorderBrush="{DynamicResource NeutralBorderBrush}" BorderThickness="1" CornerRadius="8" ClipToBounds="True">
                <Grid x:Name="ViewportContainer" SizeChanged="ViewportContainer_SizeChanged">
                    <!-- Zoom & Pan Canvas Container -->
                    <Canvas x:Name="InteractionCanvas"
                            Background="Transparent"
                            ClipToBounds="True"
                            MouseWheel="Canvas_MouseWheel"
                            MouseDown="Canvas_MouseDown"
                            MouseMove="Canvas_MouseMove"
                            MouseUp="Canvas_MouseUp">
                        
                        <!-- Transformed Content: Source Image + Crop Box Overlay -->
                        <Canvas x:Name="TransformedContent">
                            <Canvas.RenderTransform>
                                <TransformGroup>
                                    <ScaleTransform x:Name="CanvasScale" ScaleX="{Binding ZoomFactor}" ScaleY="{Binding ZoomFactor}"/>
                                    <TranslateTransform x:Name="CanvasTranslate" X="{Binding PanOffsetX}" Y="{Binding PanOffsetY}"/>
                                </TransformGroup>
                            </Canvas.RenderTransform>

                            <!-- The Document/Card Image -->
                            <Image x:Name="DocImage" Source="{Binding SourceImage}" RenderOptions.BitmapScalingMode="HighQuality"/>

                            <!-- Dimmed Mask Overlay around crop box (drawn in code-behind) -->
                            <Path x:Name="DimmedMaskPath" Fill="#90000000"/>

                            <!-- Perspective Connecting Lines (Perspective Mode) -->
                            <Polygon x:Name="PerspectivePoly" Stroke="#2563EB" StrokeThickness="2" StrokeDashArray="3 1" Fill="#152563EB" Visibility="Collapsed"/>

                            <!-- Crop Box Rectangle & Grid (Standard Mode) -->
                            <Rectangle x:Name="CropBoxRect" Stroke="#2563EB" StrokeThickness="2" Fill="#102563EB"/>
                            <Line x:Name="GridLineH1" Stroke="#602563EB" StrokeThickness="1" StrokeDashArray="2 2"/>
                            <Line x:Name="GridLineH2" Stroke="#602563EB" StrokeThickness="1" StrokeDashArray="2 2"/>
                            <Line x:Name="GridLineV1" Stroke="#602563EB" StrokeThickness="1" StrokeDashArray="2 2"/>
                            <Line x:Name="GridLineV2" Stroke="#602563EB" StrokeThickness="1" StrokeDashArray="2 2"/>

                            <!-- Handles (4 Corners + 4 Edges) -->
                            <!-- Corner 1 (Top-Left) -->
                            <Ellipse x:Name="HandleC1" Width="14" Height="14" Fill="#3B82F6" Stroke="White" StrokeThickness="2" Cursor="SizeNWSE"/>
                            <!-- Corner 2 (Top-Right) -->
                            <Ellipse x:Name="HandleC2" Width="14" Height="14" Fill="#3B82F6" Stroke="White" StrokeThickness="2" Cursor="SizeNESW"/>
                            <!-- Corner 3 (Bottom-Right) -->
                            <Ellipse x:Name="HandleC3" Width="14" Height="14" Fill="#3B82F6" Stroke="White" StrokeThickness="2" Cursor="SizeNWSE"/>
                            <!-- Corner 4 (Bottom-Left) -->
                            <Ellipse x:Name="HandleC4" Width="14" Height="14" Fill="#3B82F6" Stroke="White" StrokeThickness="2" Cursor="SizeNESW"/>

                            <!-- Edge Handles (Standard Mode) -->
                            <Rectangle x:Name="HandleTop" Width="12" Height="8" Fill="#3B82F6" Stroke="White" StrokeThickness="1" Cursor="SizeNS"/>
                            <Rectangle x:Name="HandleBottom" Width="12" Height="8" Fill="#3B82F6" Stroke="White" StrokeThickness="1" Cursor="SizeNS"/>
                            <Rectangle x:Name="HandleLeft" Width="8" Height="12" Fill="#3B82F6" Stroke="White" StrokeThickness="1" Cursor="SizeWE"/>
                            <Rectangle x:Name="HandleRight" Width="8" Height="12" Fill="#3B82F6" Stroke="White" StrokeThickness="1" Cursor="SizeWE"/>
                        </Canvas>
                    </Canvas>

                    <!-- Viewport Hint Overlay (bottom left) -->
                    <Border HorizontalAlignment="Left" VerticalAlignment="Bottom" Margin="12" Background="#C0000000" CornerRadius="4" Padding="8,4">
                        <TextBlock Text="Scroll: Zoom | Drag Center: Move Box | Drag Handles: Resize | Space/Middle-Click: Pan" FontSize="10" Foreground="White"/>
                    </Border>
                </Grid>
            </Border>

            <!-- Splitter -->
            <GridSplitter Grid.Column="1" Width="4" HorizontalAlignment="Center" VerticalAlignment="Stretch" Background="Transparent"/>

            <!-- RIGHT: Cropped Output, Image Adjustments & Face Assignment -->
            <Border Grid.Column="2" Background="{DynamicResource CardSurfaceBrush}" BorderBrush="{DynamicResource NeutralBorderBrush}" BorderThickness="1" CornerRadius="8" Padding="14">
                <ScrollViewer VerticalScrollBarVisibility="Auto">
                    <StackPanel>
                        <!-- Section: Cropped Output Preview -->
                        <TextBlock Text="Card Output Preview" FontWeight="Bold" FontSize="13" Foreground="{DynamicResource TextPrimaryBrush}" Margin="0,0,0,6"/>

                        <Border Background="{DynamicResource NeutralSurfaceBrush}" BorderBrush="{DynamicResource NeutralBorderBrush}" BorderThickness="1" CornerRadius="6" Padding="10" Margin="0,0,0,10">
                            <StackPanel HorizontalAlignment="Center">
                                <Border BorderBrush="#2563EB" BorderThickness="2" CornerRadius="6" Background="White" ClipToBounds="True">
                                    <Image Source="{Binding PreviewCroppedImage}" MaxHeight="160" Stretch="Uniform" Margin="2"/>
                                </Border>
                                <TextBlock Text="{Binding PixelDimensionsText}" FontSize="12" FontWeight="Bold" Foreground="{DynamicResource TextPrimaryBrush}" HorizontalAlignment="Center" Margin="0,6,0,0"/>
                                <TextBlock Text="{Binding PhysicalDimensionsText}" FontSize="10" Foreground="{DynamicResource TextSecondaryBrush}" HorizontalAlignment="Center" Margin="0,2,0,0"/>
                                <TextBlock Text="{Binding AspectRatioText, StringFormat='Preset: {0}'}" FontSize="10" Foreground="{DynamicResource TextSecondaryBrush}" HorizontalAlignment="Center" Margin="0,2,0,0"/>
                            </StackPanel>
                        </Border>

                        <!-- Section: Non-Destructive Image Adjustments -->
                        <Border Background="{DynamicResource NeutralSurfaceBrush}" BorderBrush="{DynamicResource NeutralBorderBrush}" BorderThickness="1" CornerRadius="6" Padding="10" Margin="0,0,0,12">
                            <StackPanel>
                                <Grid Margin="0,0,0,6">
                                    <TextBlock Text="Image Enhancements" FontWeight="Bold" FontSize="12" Foreground="{DynamicResource TextPrimaryBrush}"/>
                                    <ui:Button Command="{Binding ResetAdjustmentsCommand}" Content="Reset" Height="20" Padding="6,0" FontSize="9" FontWeight="SemiBold" CornerRadius="3" HorizontalAlignment="Right"/>
                                </Grid>

                                <!-- Brightness -->
                                <Grid Margin="0,2">
                                    <Grid.ColumnDefinitions>
                                        <ColumnDefinition Width="65"/>
                                        <ColumnDefinition Width="*"/>
                                        <ColumnDefinition Width="35"/>
                                    </Grid.ColumnDefinitions>
                                    <TextBlock Grid.Column="0" Text="Brightness" FontSize="10" Foreground="{DynamicResource TextSecondaryBrush}" VerticalAlignment="Center"/>
                                    <Slider Grid.Column="1" Minimum="-100" Maximum="100" Value="{Binding Brightness, Mode=TwoWay}" TickFrequency="5" VerticalAlignment="Center"/>
                                    <TextBlock Grid.Column="2" Text="{Binding Brightness, StringFormat='{}{0:F0}'}" FontSize="10" HorizontalAlignment="Right" VerticalAlignment="Center"/>
                                </Grid>

                                <!-- Contrast -->
                                <Grid Margin="0,2">
                                    <Grid.ColumnDefinitions>
                                        <ColumnDefinition Width="65"/>
                                        <ColumnDefinition Width="*"/>
                                        <ColumnDefinition Width="35"/>
                                    </Grid.ColumnDefinitions>
                                    <TextBlock Grid.Column="0" Text="Contrast" FontSize="10" Foreground="{DynamicResource TextSecondaryBrush}" VerticalAlignment="Center"/>
                                    <Slider Grid.Column="1" Minimum="0.5" Maximum="2.0" Value="{Binding Contrast, Mode=TwoWay}" TickFrequency="0.05" VerticalAlignment="Center"/>
                                    <TextBlock Grid.Column="2" Text="{Binding Contrast, StringFormat='{}{0:F2}'}" FontSize="10" HorizontalAlignment="Right" VerticalAlignment="Center"/>
                                </Grid>

                                <!-- Saturation -->
                                <Grid Margin="0,2">
                                    <Grid.ColumnDefinitions>
                                        <ColumnDefinition Width="65"/>
                                        <ColumnDefinition Width="*"/>
                                        <ColumnDefinition Width="35"/>
                                    </Grid.ColumnDefinitions>
                                    <TextBlock Grid.Column="0" Text="Saturation" FontSize="10" Foreground="{DynamicResource TextSecondaryBrush}" VerticalAlignment="Center"/>
                                    <Slider Grid.Column="1" Minimum="0.0" Maximum="2.0" Value="{Binding Saturation, Mode=TwoWay}" TickFrequency="0.05" VerticalAlignment="Center"/>
                                    <TextBlock Grid.Column="2" Text="{Binding Saturation, StringFormat='{}{0:F2}'}" FontSize="10" HorizontalAlignment="Right" VerticalAlignment="Center"/>
                                </Grid>

                                <!-- Sharpness -->
                                <Grid Margin="0,2">
                                    <Grid.ColumnDefinitions>
                                        <ColumnDefinition Width="65"/>
                                        <ColumnDefinition Width="*"/>
                                        <ColumnDefinition Width="35"/>
                                    </Grid.ColumnDefinitions>
                                    <TextBlock Grid.Column="0" Text="Sharpen" FontSize="10" Foreground="{DynamicResource TextSecondaryBrush}" VerticalAlignment="Center"/>
                                    <Slider Grid.Column="1" Minimum="0.0" Maximum="2.0" Value="{Binding Sharpness, Mode=TwoWay}" TickFrequency="0.05" VerticalAlignment="Center"/>
                                    <TextBlock Grid.Column="2" Text="{Binding Sharpness, StringFormat='{}{0:F2}'}" FontSize="10" HorizontalAlignment="Right" VerticalAlignment="Center"/>
                                </Grid>
                            </StackPanel>
                        </Border>

                        <!-- Section: Card Face Assignment -->
                        <TextBlock Text="Card Assignment" FontWeight="Bold" FontSize="12" Foreground="{DynamicResource TextPrimaryBrush}" Margin="0,0,0,6"/>

                        <ui:Button Command="{Binding AssignToFrontFaceCommand}" Height="40" CornerRadius="6" Background="{DynamicResource PrimaryAccentBrush}" Foreground="{DynamicResource AccentTextBrush}" FontWeight="Bold" FontSize="12" Margin="0,0,0,8" IsEnabled="{Binding HasCroppedResult}">
                            <StackPanel Orientation="Horizontal">
                                <ui:SymbolIcon Symbol="Checkmark24" Margin="0,0,8,0"/>
                                <TextBlock Text="SET AS FRONT CARD FACE"/>
                            </StackPanel>
                        </ui:Button>

                        <ui:Button Command="{Binding AssignToBackFaceCommand}" Height="40" CornerRadius="6" Background="#7C3AED" Foreground="White" FontWeight="Bold" FontSize="12" Margin="0,0,0,10" IsEnabled="{Binding HasCroppedResult}">
                            <StackPanel Orientation="Horizontal">
                                <ui:SymbolIcon Symbol="Checkmark24" Margin="0,0,8,0"/>
                                <TextBlock Text="SET AS BACK CARD FACE"/>
                            </StackPanel>
                        </ui:Button>

                        <ui:Button Command="{Binding CancelCommand}" Content="Return to Document Desk" Height="34" CornerRadius="6" Background="Transparent" BorderBrush="{DynamicResource NeutralBorderBrush}" BorderThickness="1" FontSize="11"/>
                    </StackPanel>
                </ScrollViewer>
            </Border>
        </Grid>

        <!-- ROW 2: Status Bar -->
        <Border Grid.Row="2" Background="{DynamicResource NeutralSurfaceBrush}" CornerRadius="4" Padding="10,6" Margin="0,10,0,0">
            <TextBlock Text="{Binding StatusMessage}" FontSize="11" Foreground="{DynamicResource TextSecondaryBrush}"/>
        </Border>
    </Grid>
</UserControl>
