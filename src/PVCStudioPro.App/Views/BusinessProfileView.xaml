<UserControl x:Class="PVCStudioPro.App.Views.BusinessProfileView"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006" 
             xmlns:d="http://schemas.microsoft.com/expression/blend/2008" 
             xmlns:ui="http://schemas.lepo.co/wpfui/2022/xaml"
             mc:Ignorable="d" 
             d:DesignHeight="850" d:DesignWidth="1100">
    <ScrollViewer VerticalScrollBarVisibility="Auto" HorizontalScrollBarVisibility="Disabled">
        <Grid Margin="24">
            <Grid.RowDefinitions>
                <RowDefinition Height="Auto"/>
                <RowDefinition Height="*"/>
                <RowDefinition Height="Auto"/>
            </Grid.RowDefinitions>

            <!-- Workspace Header -->
            <Grid Grid.Row="0" Margin="0,0,0,20">
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="*"/>
                    <ColumnDefinition Width="Auto"/>
                </Grid.ColumnDefinitions>
                <StackPanel Grid.Column="0">
                    <TextBlock Text="{DynamicResource BusinessProfileHeader}" Style="{StaticResource WorkspaceTitleStyle}"/>
                    <TextBlock Text="{DynamicResource BusinessProfileSubHeader}" Style="{StaticResource FormHelpStyle}" Margin="0,4,0,0"/>
                </StackPanel>
                <StackPanel Grid.Column="1" Orientation="Horizontal" VerticalAlignment="Center">
                    <ui:Button Command="{Binding ResetDefaultsCommand}" Content="Reset Defaults" Style="{StaticResource SecondaryActionButtonStyle}" Margin="0,0,10,0"/>
                    <ui:Button Command="{Binding SaveCommand}" Content="{DynamicResource BtnSaveProfileSettings}" Style="{StaticResource PrimaryActionButtonStyle}"/>
                </StackPanel>
            </Grid>

            <!-- Main Tabbed Setup Form -->
            <TabControl Grid.Row="1" Background="Transparent" BorderThickness="0">

                <!-- TAB 1: Business Identity -->
                <TabItem Header="{DynamicResource TabIdentity}" FontSize="13" FontWeight="SemiBold">
                    <Border Style="{StaticResource SurfaceCardStyle}" Margin="0,16,0,0">
                        <StackPanel>
                            <TextBlock Text="COMMERCIAL IDENTITY &amp; CONTACT DETAILS" Style="{StaticResource SectionHeaderStyle}"/>

                            <!-- Row 1: Shop Name & Operator Name -->
                            <Grid Margin="0,0,0,16">
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="*"/>
                                    <ColumnDefinition Width="20"/>
                                    <ColumnDefinition Width="*"/>
                                </Grid.ColumnDefinitions>

                                <StackPanel Grid.Column="0">
                                    <TextBlock Text="{DynamicResource LblShopName}" Style="{StaticResource FormLabelStyle}"/>
                                    <TextBox Text="{Binding Profile.ShopName, UpdateSourceTrigger=PropertyChanged}" Height="38" VerticalContentAlignment="Center" FontSize="13"/>
                                    <TextBlock Text="Appears on customer receipts and print audit records" Style="{StaticResource FormHelpStyle}"/>
                                </StackPanel>

                                <StackPanel Grid.Column="2">
                                    <TextBlock Text="{DynamicResource LblOperatorName}" Style="{StaticResource FormLabelStyle}"/>
                                    <TextBox Text="{Binding Profile.OperatorName, UpdateSourceTrigger=PropertyChanged}" Height="38" VerticalContentAlignment="Center" FontSize="13"/>
                                    <TextBlock Text="Authorized operator name for audit sign-offs" Style="{StaticResource FormHelpStyle}"/>
                                </StackPanel>
                            </Grid>

                            <!-- Row 2: Business Type & Phone Number -->
                            <Grid Margin="0,0,0,16">
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="*"/>
                                    <ColumnDefinition Width="20"/>
                                    <ColumnDefinition Width="*"/>
                                </Grid.ColumnDefinitions>

                                <StackPanel Grid.Column="0">
                                    <TextBlock Text="{DynamicResource LblBusinessType}" Style="{StaticResource FormLabelStyle}"/>
                                    <TextBox Text="{Binding Profile.BusinessType, UpdateSourceTrigger=PropertyChanged}" Height="38" VerticalContentAlignment="Center" FontSize="13"/>
                                    <TextBlock Text="e.g. e-Sevai Maiyam, CSC Centre, Photo Studio, Cyber Cafe" Style="{StaticResource FormHelpStyle}"/>
                                </StackPanel>

                                <StackPanel Grid.Column="2">
                                    <TextBlock Text="{DynamicResource LblPhone}" Style="{StaticResource FormLabelStyle}"/>
                                    <TextBox Text="{Binding Profile.PhoneNumber, UpdateSourceTrigger=PropertyChanged}" Height="38" VerticalContentAlignment="Center" FontSize="13"/>
                                    <TextBlock Text="Customer support phone printed on receipts" Style="{StaticResource FormHelpStyle}"/>
                                </StackPanel>
                            </Grid>

                            <!-- Row 3: Address Line 1 & Line 2 -->
                            <Grid Margin="0,0,0,16">
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="*"/>
                                    <ColumnDefinition Width="20"/>
                                    <ColumnDefinition Width="*"/>
                                </Grid.ColumnDefinitions>

                                <StackPanel Grid.Column="0">
                                    <TextBlock Text="{DynamicResource LblAddressLine1}" Style="{StaticResource FormLabelStyle}"/>
                                    <TextBox Text="{Binding Profile.AddressLine1, UpdateSourceTrigger=PropertyChanged}" Height="38" VerticalContentAlignment="Center" FontSize="13"/>
                                </StackPanel>

                                <StackPanel Grid.Column="2">
                                    <TextBlock Text="{DynamicResource LblAddressLine2}" Style="{StaticResource FormLabelStyle}"/>
                                    <TextBox Text="{Binding Profile.AddressLine2, UpdateSourceTrigger=PropertyChanged}" Height="38" VerticalContentAlignment="Center" FontSize="13"/>
                                </StackPanel>
                            </Grid>

                            <!-- Row 4: District, State, PIN Code -->
                            <Grid Margin="0,0,0,16">
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="*"/>
                                    <ColumnDefinition Width="20"/>
                                    <ColumnDefinition Width="*"/>
                                    <ColumnDefinition Width="20"/>
                                    <ColumnDefinition Width="*"/>
                                </Grid.ColumnDefinitions>

                                <StackPanel Grid.Column="0">
                                    <TextBlock Text="{DynamicResource LblDistrict}" Style="{StaticResource FormLabelStyle}"/>
                                    <TextBox Text="{Binding Profile.District, UpdateSourceTrigger=PropertyChanged}" Height="38" VerticalContentAlignment="Center" FontSize="13"/>
                                </StackPanel>

                                <StackPanel Grid.Column="2">
                                    <TextBlock Text="{DynamicResource LblState}" Style="{StaticResource FormLabelStyle}"/>
                                    <TextBox Text="{Binding Profile.State, UpdateSourceTrigger=PropertyChanged}" Height="38" VerticalContentAlignment="Center" FontSize="13"/>
                                </StackPanel>

                                <StackPanel Grid.Column="4">
                                    <TextBlock Text="{DynamicResource LblPinCode}" Style="{StaticResource FormLabelStyle}"/>
                                    <TextBox Text="{Binding Profile.PinCode, UpdateSourceTrigger=PropertyChanged}" Height="38" VerticalContentAlignment="Center" FontSize="13"/>
                                </StackPanel>
                            </Grid>

                            <!-- Row 5: Email Address & Website -->
                            <Grid Margin="0,0,0,16">
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="*"/>
                                    <ColumnDefinition Width="20"/>
                                    <ColumnDefinition Width="*"/>
                                </Grid.ColumnDefinitions>

                                <StackPanel Grid.Column="0">
                                    <TextBlock Text="{DynamicResource LblEmail}" Style="{StaticResource FormLabelStyle}"/>
                                    <TextBox Text="{Binding Profile.EmailAddress, UpdateSourceTrigger=PropertyChanged}" Height="38" VerticalContentAlignment="Center" FontSize="13"/>
                                </StackPanel>

                                <StackPanel Grid.Column="2">
                                    <TextBlock Text="Website / Portal URL (Optional):" Style="{StaticResource FormLabelStyle}"/>
                                    <TextBox Text="{Binding Profile.WebsiteUrl, UpdateSourceTrigger=PropertyChanged}" Height="38" VerticalContentAlignment="Center" FontSize="13"/>
                                </StackPanel>
                            </Grid>
                        </StackPanel>
                    </Border>
                </TabItem>

                <!-- TAB 2: Billing & Invoicing -->
                <TabItem Header="{DynamicResource TabBilling}" FontSize="13" FontWeight="SemiBold">
                    <Border Style="{StaticResource SurfaceCardStyle}" Margin="0,16,0,0">
                        <StackPanel>
                            <TextBlock Text="INVOICING, TAXATION &amp; RECEIPT PRINTER SETUP" Style="{StaticResource SectionHeaderStyle}"/>

                            <!-- Row 1: Currency & Prefix -->
                            <Grid Margin="0,0,0,16">
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="*"/>
                                    <ColumnDefinition Width="20"/>
                                    <ColumnDefinition Width="*"/>
                                </Grid.ColumnDefinitions>

                                <StackPanel Grid.Column="0">
                                    <TextBlock Text="{DynamicResource LblCurrency}" Style="{StaticResource FormLabelStyle}"/>
                                    <TextBox Text="{Binding Profile.CurrencySymbol, UpdateSourceTrigger=PropertyChanged}" Height="38" VerticalContentAlignment="Center" FontSize="13"/>
                                    <TextBlock Text="Default: ₹ (Indian Rupee)" Style="{StaticResource FormHelpStyle}"/>
                                </StackPanel>

                                <StackPanel Grid.Column="2">
                                    <TextBlock Text="{DynamicResource LblInvoicePrefix}" Style="{StaticResource FormLabelStyle}"/>
                                    <TextBox Text="{Binding Profile.ReceiptPrefix, UpdateSourceTrigger=PropertyChanged}" Height="38" VerticalContentAlignment="Center" FontSize="13"/>
                                    <TextBlock Text="Prefix for operational job numbers (e.g. INV, ESV, CSC)" Style="{StaticResource FormHelpStyle}"/>
                                </StackPanel>
                            </Grid>

                            <!-- Row 2: Next Number & Receipt Size -->
                            <Grid Margin="0,0,0,16">
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="*"/>
                                    <ColumnDefinition Width="20"/>
                                    <ColumnDefinition Width="*"/>
                                </Grid.ColumnDefinitions>

                                <StackPanel Grid.Column="0">
                                    <TextBlock Text="{DynamicResource LblNextInvoice}" Style="{StaticResource FormLabelStyle}"/>
                                    <TextBox Text="{Binding Profile.NextInvoiceNumber, UpdateSourceTrigger=PropertyChanged}" Height="38" VerticalContentAlignment="Center" FontSize="13"/>
                                </StackPanel>

                                <StackPanel Grid.Column="2" Visibility="{Binding Converter={StaticResource FeatureVisibilityConverter}, ConverterParameter=F-THERMAL-RECEIPT}">
                                    <TextBlock Text="{DynamicResource LblReceiptPaperSize}" Style="{StaticResource FormLabelStyle}"/>
                                    <ComboBox ItemsSource="{Binding AvailablePaperSizes}" SelectedItem="{Binding Profile.ReceiptPaperSize}" Height="38"/>
                                    <TextBlock Text="Choose 58mm POS thermal roll, 80mm roll, or A4 statement" Style="{StaticResource FormHelpStyle}"/>
                                </StackPanel>
                            </Grid>

                            <!-- Row 3: Tax Configuration -->
                            <Border Background="{DynamicResource CardSubtleBackgroundBrush}" CornerRadius="6" Padding="14" Margin="0,0,0,16">
                                <StackPanel>
                                    <CheckBox IsChecked="{Binding Profile.EnableTaxGst}" Content="Enable GST / Commercial Tax Calculation" FontWeight="SemiBold" Margin="0,0,0,10"/>
                                    <Grid IsEnabled="{Binding Profile.EnableTaxGst}">
                                        <Grid.ColumnDefinitions>
                                            <ColumnDefinition Width="*"/>
                                            <ColumnDefinition Width="20"/>
                                            <ColumnDefinition Width="*"/>
                                        </Grid.ColumnDefinitions>
                                        <StackPanel Grid.Column="0">
                                            <TextBlock Text="GSTIN / Tax ID Number:" Style="{StaticResource FormLabelStyle}"/>
                                            <TextBox Text="{Binding Profile.GstNumber, UpdateSourceTrigger=PropertyChanged}" Height="38" VerticalContentAlignment="Center"/>
                                        </StackPanel>
                                        <StackPanel Grid.Column="2">
                                            <TextBlock Text="Applicable Tax Rate (%):" Style="{StaticResource FormLabelStyle}"/>
                                            <TextBox Text="{Binding Profile.TaxRatePercent, UpdateSourceTrigger=PropertyChanged}" Height="38" VerticalContentAlignment="Center"/>
                                        </StackPanel>
                                    </Grid>
                                </StackPanel>
                            </Border>

                            <!-- Row 4: Receipt Footer Message -->
                            <StackPanel Margin="0,0,0,16" Visibility="{Binding Converter={StaticResource FeatureVisibilityConverter}, ConverterParameter=F-THERMAL-RECEIPT}">
                                <TextBlock Text="{DynamicResource LblReceiptFooter}" Style="{StaticResource FormLabelStyle}"/>
                                <TextBox Text="{Binding Profile.ReceiptFooterMessage, UpdateSourceTrigger=PropertyChanged}" Height="54" TextWrapping="Wrap" AcceptsReturn="True" VerticalContentAlignment="Top" Padding="8"/>
                                <TextBlock Text="Custom thank you message printed at the bottom of customer receipts" Style="{StaticResource FormHelpStyle}"/>
                            </StackPanel>
                        </StackPanel>
                    </Border>
                </TabItem>

                <!-- TAB 3: Hardware Defaults -->
                <TabItem Header="{DynamicResource TabHardwareDefaults}" FontSize="13" FontWeight="SemiBold">
                    <Border Style="{StaticResource SurfaceCardStyle}" Margin="0,16,0,0">
                        <StackPanel>
                            <TextBlock Text="DEFAULT PRINTING &amp; PRICING PREFERENCES" Style="{StaticResource SectionHeaderStyle}"/>

                            <Grid Margin="0,0,0,16">
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="*"/>
                                    <ColumnDefinition Width="20"/>
                                    <ColumnDefinition Width="*"/>
                                </Grid.ColumnDefinitions>

                                <StackPanel Grid.Column="0">
                                    <TextBlock Text="Default Printer Device:" Style="{StaticResource FormLabelStyle}"/>
                                    <ComboBox ItemsSource="{Binding AvailablePrinters}" SelectedItem="{Binding Profile.DefaultPrinter}" Height="38"/>
                                    <TextBlock Text="Auto-selected whenever Card Studio or Photo Studio opens" Style="{StaticResource FormHelpStyle}"/>
                                </StackPanel>

                                <StackPanel Grid.Column="2">
                                    <TextBlock Text="Default Payment Mode:" Style="{StaticResource FormLabelStyle}"/>
                                    <ComboBox ItemsSource="{Binding AvailablePaymentModes}" SelectedItem="{Binding Profile.DefaultPaymentMode}" Height="38"/>
                                    <TextBlock Text="Default mode pre-selected in print confirmation" Style="{StaticResource FormHelpStyle}"/>
                                </StackPanel>
                            </Grid>

                            <Grid Margin="0,0,0,16">
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="*"/>
                                    <ColumnDefinition Width="20"/>
                                    <ColumnDefinition Width="*"/>
                                </Grid.ColumnDefinitions>

                                <StackPanel Grid.Column="0">
                                    <TextBlock Text="Standard PVC Card Price (₹):" Style="{StaticResource FormLabelStyle}"/>
                                    <TextBox Text="{Binding Profile.DefaultCardPrice, UpdateSourceTrigger=PropertyChanged, StringFormat='F2'}" Height="38" VerticalContentAlignment="Center" FontSize="13"/>
                                    <TextBlock Text="Standard price charged per PVC card (e.g. ₹ 70.00)" Style="{StaticResource FormHelpStyle}"/>
                                </StackPanel>

                                <StackPanel Grid.Column="2">
                                    <TextBlock Text="Standard Photo Sheet Price (₹):" Style="{StaticResource FormLabelStyle}"/>
                                    <TextBox Text="{Binding Profile.DefaultPhotoSheetPrice, UpdateSourceTrigger=PropertyChanged, StringFormat='F2'}" Height="38" VerticalContentAlignment="Center" FontSize="13"/>
                                    <TextBlock Text="Standard price charged per 8-up photo sheet (e.g. ₹ 50.00)" Style="{StaticResource FormHelpStyle}"/>
                                </StackPanel>
                            </Grid>
                        </StackPanel>
                    </Border>
                </TabItem>

                <!-- TAB 4: Data & Privacy Policy -->
                <TabItem Header="{DynamicResource TabDataPrivacy}" FontSize="13" FontWeight="SemiBold">
                    <Border Style="{StaticResource SurfaceCardStyle}" Margin="0,16,0,0">
                        <StackPanel>
                            <TextBlock Text="DATA PRIVACY &amp; LOCAL ENCRYPTION OVERVIEW" Style="{StaticResource SectionHeaderStyle}"/>

                            <Border Background="#E8F5E9" BorderBrush="#C8E6C9" BorderThickness="1" CornerRadius="6" Padding="16" Margin="0,0,0,16">
                                <StackPanel>
                                    <TextBlock Text="✓ ZERO-CITIZEN-PII ARCHITECTURE ENFORCED" FontWeight="Bold" Foreground="#2E7D32" FontSize="13"/>
                                    <TextBlock Text="PVC Studio Pro strictly excludes citizen identity data (Aadhaar numbers, applicant names, biometric photos, address strings) from permanent storage. Only operational invoice totals, document categories, and timestamps are recorded in the business ledger." 
                                               Foreground="#1B5E20" TextWrapping="Wrap" Margin="0,6,0,0" LineHeight="18"/>
                                </StackPanel>
                            </Border>

                            <Border Background="{DynamicResource CardSubtleBackgroundBrush}" BorderBrush="{DynamicResource BorderSubtleBrush}" BorderThickness="1" CornerRadius="6" Padding="16">
                                <StackPanel>
                                    <TextBlock Text="Audit Log Retention Policy:" Style="{StaticResource FormLabelStyle}"/>
                                    <StackPanel Orientation="Horizontal" VerticalAlignment="Center">
                                        <TextBox Text="{Binding Profile.AuditLogRetentionDays, UpdateSourceTrigger=PropertyChanged}" Width="100" Height="38" VerticalContentAlignment="Center" Margin="0,0,12,0"/>
                                        <TextBlock Text="Days of operational transaction records retained before automatic archival" VerticalAlignment="Center" Foreground="{DynamicResource TextSecondaryBrush}"/>
                                    </StackPanel>
                                </StackPanel>
                            </Border>
                        </StackPanel>
                    </Border>
                </TabItem>
            </TabControl>

            <!-- Bottom Save / Status Feedback Bar -->
            <Border Grid.Row="2" Background="{DynamicResource CardSubtleBackgroundBrush}" BorderBrush="{DynamicResource BorderSubtleBrush}" BorderThickness="1" CornerRadius="6" Padding="14,10" Margin="0,16,0,0">
                <Grid>
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="*"/>
                        <ColumnDefinition Width="Auto"/>
                    </Grid.ColumnDefinitions>
                    <TextBlock Grid.Column="0" Text="{Binding StatusMessage}" VerticalAlignment="Center" FontWeight="Medium" Foreground="{DynamicResource TextPrimaryBrush}"/>
                    <ui:Button Grid.Column="1" Command="{Binding SaveCommand}" Content="{DynamicResource BtnSaveProfileSettings}" Style="{StaticResource PrimaryActionButtonStyle}"/>
                </Grid>
            </Border>
        </Grid>
    </ScrollViewer>
</UserControl>
