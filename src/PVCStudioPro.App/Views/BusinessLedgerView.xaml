<UserControl x:Class="PVCStudioPro.App.Views.BusinessLedgerView"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006" 
             xmlns:d="http://schemas.microsoft.com/expression/blend/2008" 
             xmlns:ui="http://schemas.lepo.co/wpfui/2022/xaml"
             mc:Ignorable="d" 
             d:DesignHeight="780" d:DesignWidth="1200">
    <Grid Margin="24">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="*"/>
            <RowDefinition Height="Auto"/>
        </Grid.RowDefinitions>

        <!-- Test Mode Alert Banner (Conditional) -->
        <Border Grid.Row="0" Background="{DynamicResource StatusWarningBgBrush}" BorderBrush="{DynamicResource AccentWarningBrush}" BorderThickness="1" CornerRadius="{StaticResource RadiusMedium}" Padding="16,12" Margin="0,0,0,16"
                Visibility="{Binding IsTestMode, Converter={StaticResource BooleanToVisibilityConverter}}">
            <Grid>
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="Auto"/>
                    <ColumnDefinition Width="*"/>
                    <ColumnDefinition Width="Auto"/>
                </Grid.ColumnDefinitions>
                <TextBlock Grid.Column="0" Text="⚠️" FontSize="18" VerticalAlignment="Center" Margin="0,0,12,0"/>
                <StackPanel Grid.Column="1" VerticalAlignment="Center">
                    <TextBlock Text="TEST SANDBOX ENVIRONMENT ACTIVE" FontWeight="Bold" Foreground="{DynamicResource StatusWarningFgBrush}" FontSize="12.5"/>
                    <TextBlock Text="Financial transactions recorded here are isolated in pvc_studio_test.db and do not affect production records." Foreground="{DynamicResource StatusWarningFgBrush}" FontSize="11" Margin="0,2,0,0"/>
                </StackPanel>
                <ui:Button Grid.Column="2" Command="{Binding ResetTestModeDatabaseCommand}" Content="Clear Sandbox Database" MinHeight="32" Padding="14,0" Background="{DynamicResource AccentDangerBrush}" Foreground="{DynamicResource AccentTextBrush}" FontWeight="Bold" CornerRadius="{StaticResource RadiusSmall}"/>
            </Grid>
        </Border>

        <!-- Header with Environment Toggle & Controls -->
        <Border Grid.Row="1" Style="{DynamicResource SurfaceCardStyle}" Margin="0,0,0,16">
            <Grid>
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="*"/>
                    <ColumnDefinition Width="Auto"/>
                </Grid.ColumnDefinitions>

                <StackPanel Grid.Column="0">
                    <TextBlock Text="{DynamicResource LedgerHeader}" FontSize="18" FontWeight="Bold" Foreground="{DynamicResource TextPrimaryBrush}"/>
                    <TextBlock Text="Enterprise Financial Ledger | Integer Paise Precision | Strict IST Business Day" Foreground="{DynamicResource TextSecondaryBrush}" Margin="0,4,0,0" FontSize="11.5"/>
                </StackPanel>

                <StackPanel Grid.Column="1" Orientation="Horizontal" VerticalAlignment="Center">
                    <!-- Test Mode Toggle Button -->
                    <ui:Button Command="{Binding ToggleTestModeCommand}" MinHeight="36" Padding="12,0" Margin="0,0,8,0"
                               Background="{DynamicResource NeutralSurfaceBrush}">
                        <StackPanel Orientation="Horizontal">
                            <ui:SymbolIcon Symbol="DeveloperBoard24" Margin="0,0,6,0"/>
                            <TextBlock Text="{Binding TestModeButtonText}" VerticalAlignment="Center" FontWeight="SemiBold"/>
                        </StackPanel>
                    </ui:Button>

                    <!-- Export to CSV -->
                    <ui:Button Command="{Binding ExportCsvCommand}" MinHeight="36" Padding="16,0" Background="{DynamicResource NeutralSurfaceBrush}" Margin="0,0,8,0">
                        <StackPanel Orientation="Horizontal">
                            <ui:SymbolIcon Symbol="ArrowDownload24" Margin="0,0,6,0"/>
                            <TextBlock Text="Export CSV" VerticalAlignment="Center" FontWeight="SemiBold"/>
                        </StackPanel>
                    </ui:Button>

                    <!-- Refresh -->
                    <ui:Button Command="{Binding LoadLedgerCommand}" MinHeight="36" Padding="16,0" Background="{DynamicResource NeutralSurfaceBrush}">
                        <StackPanel Orientation="Horizontal">
                            <ui:SymbolIcon Symbol="ArrowClockwise24" Margin="0,0,6,0"/>
                            <TextBlock Text="Refresh" VerticalAlignment="Center" FontWeight="SemiBold"/>
                        </StackPanel>
                    </ui:Button>
                </StackPanel>
            </Grid>
        </Border>

        <!-- KPI Metric Cards Grid (5-column summary) -->
        <UniformGrid Grid.Row="2" Columns="5" Margin="0,0,0,16">
            <Border Style="{DynamicResource SurfaceCardStyle}" Margin="0,0,8,0">
                <StackPanel>
                    <TextBlock Text="Net Sales Revenue (IST)" Foreground="{DynamicResource TextSecondaryBrush}" FontSize="11.5" FontWeight="SemiBold"/>
                    <TextBlock Text="{Binding TodayRevenue, StringFormat='₹ {0:N2}'}" FontSize="24" FontWeight="Bold" Foreground="{DynamicResource AccentSuccessBrush}" Margin="0,4,0,0"/>
                    <TextBlock Text="{Binding TodayCards, StringFormat='Across {0} transactions'}" Foreground="{DynamicResource TextSecondaryBrush}" FontSize="10.5" Margin="0,4,0,0"/>
                </StackPanel>
            </Border>

            <Border Style="{DynamicResource SurfaceCardStyle}" Margin="4,0,4,0">
                <StackPanel>
                    <TextBlock Text="Total Gross Receipts" Foreground="{DynamicResource TextSecondaryBrush}" FontSize="11.5" FontWeight="SemiBold"/>
                    <TextBlock Text="{Binding TotalCollected, StringFormat='₹ {0:N2}'}" FontSize="24" FontWeight="Bold" Foreground="{DynamicResource AccentPrimaryBrush}" Margin="0,4,0,0"/>
                    <TextBlock Text="Gross Collected Inflow" Foreground="{DynamicResource TextSecondaryBrush}" FontSize="10.5" Margin="0,4,0,0"/>
                </StackPanel>
            </Border>

            <Border Style="{DynamicResource SurfaceCardStyle}" Margin="4,0,4,0">
                <StackPanel>
                    <TextBlock Text="Cash in Drawer" Foreground="{DynamicResource TextSecondaryBrush}" FontSize="11.5" FontWeight="SemiBold"/>
                    <TextBlock Text="{Binding CashRevenue, StringFormat='₹ {0:N2}'}" FontSize="24" FontWeight="Bold" Foreground="{DynamicResource TextPrimaryBrush}" Margin="0,4,0,0"/>
                    <TextBlock Text="Net Physical Currency" Foreground="{DynamicResource TextSecondaryBrush}" FontSize="10.5" Margin="0,4,0,0"/>
                </StackPanel>
            </Border>

            <Border Style="{DynamicResource SurfaceCardStyle}" Margin="4,0,4,0">
                <StackPanel>
                    <TextBlock Text="Digital Payments" Foreground="{DynamicResource TextSecondaryBrush}" FontSize="11.5" FontWeight="SemiBold"/>
                    <Grid Margin="0,4,0,0">
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="*"/>
                            <ColumnDefinition Width="*"/>
                        </Grid.ColumnDefinitions>
                        <StackPanel Grid.Column="0">
                            <TextBlock Text="{Binding UpiRevenue, StringFormat='₹ {0:N0}'}" FontSize="16" FontWeight="Bold" Foreground="{DynamicResource AccentPrimaryBrush}"/>
                            <TextBlock Text="UPI" FontSize="10" Foreground="{DynamicResource TextSecondaryBrush}"/>
                        </StackPanel>
                        <StackPanel Grid.Column="1">
                            <TextBlock Text="{Binding CardRevenue, StringFormat='₹ {0:N0}'}" FontSize="16" FontWeight="Bold" Foreground="{DynamicResource AccentPrimaryHoverBrush}"/>
                            <TextBlock Text="Card" FontSize="10" Foreground="{DynamicResource TextSecondaryBrush}"/>
                        </StackPanel>
                    </Grid>
                </StackPanel>
            </Border>

            <Border Style="{DynamicResource SurfaceCardStyle}" Margin="8,0,0,0">
                <StackPanel>
                    <TextBlock Text="Total Refunds" Foreground="{DynamicResource TextSecondaryBrush}" FontSize="11.5" FontWeight="SemiBold"/>
                    <TextBlock Text="{Binding TotalRefunded, StringFormat='₹ {0:N2}'}" FontSize="24" FontWeight="Bold" Foreground="{DynamicResource AccentDangerBrush}" Margin="0,4,0,0"/>
                    <TextBlock Text="Audited Disbursements" Foreground="{DynamicResource TextSecondaryBrush}" FontSize="10.5" Margin="0,4,0,0"/>
                </StackPanel>
            </Border>
        </UniformGrid>

        <!-- Main Master-Detail Workstage -->
        <Grid Grid.Row="3">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="*"/>
                <ColumnDefinition Width="380"/>
            </Grid.ColumnDefinitions>

            <!-- Left: Transactions Table -->
            <Border Grid.Column="0" Style="{DynamicResource SurfaceCardStyle}" Margin="0,0,16,0">
                <Grid>
                    <Grid.RowDefinitions>
                        <RowDefinition Height="Auto"/>
                        <RowDefinition Height="*"/>
                    </Grid.RowDefinitions>

                    <!-- Search Toolbar -->
                    <Grid Grid.Row="0" Margin="0,0,0,12">
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="300"/>
                            <ColumnDefinition Width="*"/>
                        </Grid.ColumnDefinitions>
                        <TextBox Grid.Column="0" Text="{Binding SearchFilter, UpdateSourceTrigger=PropertyChanged}" MinHeight="36" Padding="8,6" VerticalContentAlignment="Center"/>
                        <TextBlock Grid.Column="0" Text="Search Invoice, Customer, Document..." Foreground="{DynamicResource TextMutedBrush}" VerticalAlignment="Center" Margin="12,0,0,0" IsHitTestVisible="False"
                                   Visibility="{Binding SearchFilter.IsEmpty, Converter={StaticResource BooleanToVisibilityConverter}, FallbackValue=Collapsed}"/>
                        <TextBlock Grid.Column="1" Text="{Binding FilteredTransactions.Count, StringFormat='Showing {0} transactions'}" VerticalAlignment="Center" HorizontalAlignment="Right" Foreground="{DynamicResource TextSecondaryBrush}" FontWeight="SemiBold" FontSize="11"/>
                    </Grid>

                    <!-- Transactions DataGrid Host with Empty State Support -->
                    <Grid Grid.Row="1">
                        <!-- Transactions DataGrid -->
                        <DataGrid ItemsSource="{Binding FilteredTransactions}" SelectedItem="{Binding SelectedTransaction}" AutoGenerateColumns="False" IsReadOnly="True" GridLinesVisibility="Horizontal" HeadersVisibility="Column" Background="Transparent" BorderThickness="0" RowHeight="38" ScrollViewer.HorizontalScrollBarVisibility="Auto">
                            <DataGrid.Columns>
                                <DataGridTextColumn Header="Invoice #" Binding="{Binding InvoiceNumber}" Width="120" FontWeight="SemiBold"/>
                                <DataGridTextColumn Header="Time (IST)" Binding="{Binding CreatedAtIst, StringFormat='yyyy-MM-dd HH:mm'}" Width="125"/>
                                <DataGridTextColumn Header="Document" Binding="{Binding DocumentType}" Width="110"/>
                                <DataGridTextColumn Header="Total" Binding="{Binding NetTotalRupees, StringFormat='₹ {0:N2}'}" Width="75"/>
                                <DataGridTextColumn Header="Paid" Binding="{Binding PaidRupees, StringFormat='₹ {0:N2}'}" Width="75"/>
                                <DataGridTextColumn Header="Balance" Binding="{Binding BalanceRupees, StringFormat='₹ {0:N2}'}" Width="75"/>
                                <DataGridTemplateColumn Header="Status" Width="75">
                                    <DataGridTemplateColumn.CellTemplate>
                                        <DataTemplate>
                                            <Border CornerRadius="{StaticResource RadiusSmall}" Padding="6,2" HorizontalAlignment="Center">
                                                <TextBlock Text="{Binding Status}" FontWeight="Bold" FontSize="10"/>
                                            </Border>
                                        </DataTemplate>
                                    </DataGridTemplateColumn.CellTemplate>
                                </DataGridTemplateColumn>
                                <DataGridTextColumn Header="Customer" Binding="{Binding CustomerName}" Width="*" MinWidth="110"/>
                            </DataGrid.Columns>
                        </DataGrid>

                        <!-- Clean Fluent Empty State -->
                        <Border Visibility="{Binding HasNoTransactions, Converter={StaticResource BooleanToVisibilityConverter}}"
                                Background="{DynamicResource CardBackgroundBrush}"
                                VerticalAlignment="Center" HorizontalAlignment="Center" Padding="24">
                            <StackPanel HorizontalAlignment="Center">
                                <ui:SymbolIcon Symbol="Receipt24" FontSize="36" Foreground="{DynamicResource TextMutedBrush}" HorizontalAlignment="Center" Margin="0,0,0,12"/>
                                <TextBlock Text="No Transactions Recorded" FontWeight="SemiBold" FontSize="14" Foreground="{DynamicResource TextSecondaryBrush}" HorizontalAlignment="Center"/>
                                <TextBlock Text="Transactions spooled from Production Studio or entered manually will appear here." FontSize="11" Foreground="{DynamicResource TextMutedBrush}" HorizontalAlignment="Center" Margin="0,4,0,0"/>
                            </StackPanel>
                        </Border>
                    </Grid>
                </Grid>
            </Border>

            <!-- Right: Transaction Details, Receipts, and Audit Log -->
            <Border Grid.Column="1" Style="{DynamicResource SurfaceCardStyle}">
                <Grid>
                    <Grid.RowDefinitions>
                        <RowDefinition Height="Auto"/>
                        <RowDefinition Height="Auto"/>
                        <RowDefinition Height="*"/>
                        <RowDefinition Height="Auto"/>
                    </Grid.RowDefinitions>

                    <!-- Selected Invoice Header -->
                    <Border Grid.Row="0" Background="{DynamicResource NeutralSurfaceBrush}" CornerRadius="{StaticResource RadiusMedium}" Padding="14" Margin="0,0,0,12">
                        <StackPanel>
                            <Grid>
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="*"/>
                                    <ColumnDefinition Width="Auto"/>
                                </Grid.ColumnDefinitions>
                                <TextBlock Grid.Column="0" Text="{Binding SelectedTransaction.InvoiceNumber, FallbackValue='No Transaction Selected'}" FontWeight="Bold" FontSize="14" Foreground="{DynamicResource TextPrimaryBrush}"/>
                                <TextBlock Grid.Column="1" Text="{Binding SelectedTransaction.Status, FallbackValue='—'}" FontWeight="Bold" FontSize="12" Foreground="{DynamicResource AccentPrimaryBrush}"/>
                            </Grid>
                            <TextBlock Text="{Binding SelectedTransaction.CustomerName, FallbackValue='Walk-in Customer', StringFormat='Customer: {0}'}" FontSize="11" Foreground="{DynamicResource TextSecondaryBrush}" Margin="0,4,0,0"/>
                            <TextBlock Text="{Binding SelectedTransaction.DocumentType, FallbackValue='—', StringFormat='Item: {0}'}" FontSize="11" Foreground="{DynamicResource TextSecondaryBrush}"/>
                            <Grid Margin="0,8,0,0">
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="*"/>
                                    <ColumnDefinition Width="*"/>
                                    <ColumnDefinition Width="*"/>
                                </Grid.ColumnDefinitions>
                                <StackPanel Grid.Column="0">
                                    <TextBlock Text="Total" FontSize="10" Foreground="{DynamicResource TextSecondaryBrush}"/>
                                    <TextBlock Text="{Binding SelectedTransaction.NetTotalRupees, FallbackValue=0.00, StringFormat='₹ {0:N2}'}" FontWeight="Bold" FontSize="12"/>
                                </StackPanel>
                                <StackPanel Grid.Column="1">
                                    <TextBlock Text="Paid" FontSize="10" Foreground="{DynamicResource TextSecondaryBrush}"/>
                                    <TextBlock Text="{Binding SelectedTransaction.PaidRupees, FallbackValue=0.00, StringFormat='₹ {0:N2}'}" FontWeight="Bold" FontSize="12" Foreground="{DynamicResource AccentSuccessBrush}"/>
                                </StackPanel>
                                <StackPanel Grid.Column="2">
                                    <TextBlock Text="Balance" FontSize="10" Foreground="{DynamicResource TextSecondaryBrush}"/>
                                    <TextBlock Text="{Binding SelectedTransaction.BalanceRupees, FallbackValue=0.00, StringFormat='₹ {0:N2}'}" FontWeight="Bold" FontSize="12" Foreground="{DynamicResource AccentDangerBrush}"/>
                                </StackPanel>
                            </Grid>
                        </StackPanel>
                    </Border>

                    <!-- Action Buttons -->
                    <Grid Grid.Row="1" Margin="0,0,0,12">
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="*"/>
                            <ColumnDefinition Width="*"/>
                            <ColumnDefinition Width="*"/>
                        </Grid.ColumnDefinitions>
                        <ui:Button Grid.Column="0" Command="{Binding OpenPaymentDialogCommand}" Content="+ Payment" MinHeight="32" Margin="0,0,4,0" Background="{DynamicResource AccentPrimaryBrush}" Foreground="{DynamicResource AccentTextBrush}" FontWeight="SemiBold" FontSize="11"/>
                        <ui:Button Grid.Column="1" Command="{Binding OpenRefundDialogCommand}" Content="Refund" MinHeight="32" Margin="4,0,4,0" Background="{DynamicResource NeutralSurfaceBrush}" Foreground="{DynamicResource TextPrimaryBrush}" BorderBrush="{DynamicResource BorderSubtleBrush}" BorderThickness="1" FontWeight="SemiBold" FontSize="11"/>
                        <ui:Button Grid.Column="2" Command="{Binding OpenVoidDialogCommand}" Content="Void" MinHeight="32" Margin="4,0,0,0" Background="{DynamicResource StatusErrorBgBrush}" Foreground="{DynamicResource StatusErrorFgBrush}" BorderBrush="{DynamicResource AccentDangerBrush}" BorderThickness="1" FontWeight="SemiBold" FontSize="11"/>
                    </Grid>

                    <!-- Payment History & Audit Log -->
                    <TabControl Grid.Row="2" Background="Transparent" BorderThickness="0">
                        <TabItem Header="Receipts &amp; Refunds" FontSize="11">
                            <ListBox ItemsSource="{Binding SelectedPayments}" Background="Transparent" BorderThickness="0" Margin="0,8,0,0">
                                <ListBox.ItemTemplate>
                                    <DataTemplate>
                                        <Border BorderBrush="{DynamicResource BorderSubtleBrush}" BorderThickness="0,0,0,1" Padding="4,8">
                                            <Grid>
                                                <Grid.ColumnDefinitions>
                                                    <ColumnDefinition Width="*"/>
                                                    <ColumnDefinition Width="Auto"/>
                                                </Grid.ColumnDefinitions>
                                                <StackPanel Grid.Column="0">
                                                    <TextBlock Text="{Binding PaymentMethod, StringFormat='Method: {0}'}" FontWeight="SemiBold" FontSize="11"/>
                                                    <TextBlock Text="{Binding ReferenceNumber, FallbackValue='No Reference', StringFormat='Ref: {0}'}" FontSize="10" Foreground="{DynamicResource TextSecondaryBrush}"/>
                                                    <TextBlock Text="{Binding CollectedAt, StringFormat='yyyy-MM-dd HH:mm'}" FontSize="10" Foreground="{DynamicResource TextSecondaryBrush}"/>
                                                </StackPanel>
                                                <TextBlock Grid.Column="1" Text="{Binding AmountRupees, StringFormat='₹ {0:N2}'}" FontWeight="Bold" FontSize="12" Foreground="{DynamicResource AccentSuccessBrush}" VerticalAlignment="Center"/>
                                            </Grid>
                                        </Border>
                                    </DataTemplate>
                                </ListBox.ItemTemplate>
                            </ListBox>
                        </TabItem>
                    </TabControl>
                </Grid>
            </Border>
        </Grid>

        <!-- Modals: Payment, Refund, Void -->
        <!-- 1. Add Payment Modal -->
        <Border Grid.Row="0" Grid.RowSpan="5" Background="{DynamicResource ModalBackdropBrush}" Visibility="{Binding IsPaymentDialogVisible, Converter={StaticResource BooleanToVisibilityConverter}}" Panel.ZIndex="100">
            <Border Style="{StaticResource SurfaceCardStyle}" Width="360" CornerRadius="{StaticResource RadiusMedium}" Padding="24" HorizontalAlignment="Center" VerticalAlignment="Center">
                <StackPanel>
                    <TextBlock Text="Record Customer Payment" FontWeight="Bold" FontSize="15" Margin="0,0,0,12"/>
                    <TextBlock Text="Amount (₹):" FontSize="11" FontWeight="SemiBold" Margin="0,0,0,4"/>
                    <TextBox Text="{Binding PaymentInputAmount, StringFormat=F2, UpdateSourceTrigger=PropertyChanged}" MinHeight="36" VerticalContentAlignment="Center" Margin="0,0,0,12"/>

                    <TextBlock Text="Payment Mode:" FontSize="11" FontWeight="SemiBold" Margin="0,0,0,4"/>
                    <ComboBox SelectedValue="{Binding PaymentInputMethod}" SelectedValuePath="Content" MinHeight="36" Margin="0,0,0,12">
                        <ComboBoxItem Content="CASH" IsSelected="True"/>
                        <ComboBoxItem Content="UPI"/>
                        <ComboBoxItem Content="CARD"/>
                    </ComboBox>

                    <TextBlock Text="Reference # (Optional for UPI/Card):" FontSize="11" FontWeight="SemiBold" Margin="0,0,0,4"/>
                    <TextBox Text="{Binding PaymentInputReference, UpdateSourceTrigger=PropertyChanged}" MinHeight="36" VerticalContentAlignment="Center" Margin="0,0,0,16"/>

                    <Grid>
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="*"/>
                            <ColumnDefinition Width="*"/>
                        </Grid.ColumnDefinitions>
                        <ui:Button Grid.Column="0" Command="{Binding ClosePaymentDialogCommand}" Content="Cancel" MinHeight="36" Margin="0,0,4,0" Background="{DynamicResource NeutralSurfaceBrush}"/>
                        <ui:Button Grid.Column="1" Command="{Binding SubmitPaymentCommand}" Content="Record" MinHeight="36" Margin="4,0,0,0" Style="{DynamicResource PrimaryActionButtonStyle}"/>
                    </Grid>
                </StackPanel>
            </Border>
        </Border>

        <!-- 2. Refund Modal -->
        <Border Grid.Row="0" Grid.RowSpan="5" Background="{DynamicResource ModalBackdropBrush}" Visibility="{Binding IsRefundDialogVisible, Converter={StaticResource BooleanToVisibilityConverter}}" Panel.ZIndex="100">
            <Border Style="{StaticResource SurfaceCardStyle}" Width="360" CornerRadius="{StaticResource RadiusMedium}" Padding="24" HorizontalAlignment="Center" VerticalAlignment="Center">
                <StackPanel>
                    <TextBlock Text="Issue Customer Refund" FontWeight="Bold" FontSize="15" Margin="0,0,0,12"/>
                    <TextBlock Text="Refund Amount (₹):" FontSize="11" FontWeight="SemiBold" Margin="0,0,0,4"/>
                    <TextBox Text="{Binding RefundInputAmount, StringFormat=F2, UpdateSourceTrigger=PropertyChanged}" MinHeight="36" VerticalContentAlignment="Center" Margin="0,0,0,12"/>

                    <TextBlock Text="Mandatory Audit Reason:" FontSize="11" FontWeight="SemiBold" Margin="0,0,0,4"/>
                    <TextBox Text="{Binding RefundInputReason, UpdateSourceTrigger=PropertyChanged}" Height="60" TextWrapping="Wrap" AcceptsReturn="True" Margin="0,0,0,16"/>

                    <Grid>
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="*"/>
                            <ColumnDefinition Width="*"/>
                        </Grid.ColumnDefinitions>
                        <ui:Button Grid.Column="0" Command="{Binding CloseRefundDialogCommand}" Content="Cancel" MinHeight="36" Margin="0,0,4,0" Background="{DynamicResource NeutralSurfaceBrush}"/>
                        <ui:Button Grid.Column="1" Command="{Binding SubmitRefundCommand}" Content="Issue Refund" MinHeight="36" Margin="4,0,0,0" Background="{DynamicResource AccentDangerBrush}" Foreground="{DynamicResource AccentTextBrush}" FontWeight="Bold"/>
                    </Grid>
                </StackPanel>
            </Border>
        </Border>

        <!-- 3. Void Modal -->
        <Border Grid.Row="0" Grid.RowSpan="5" Background="{DynamicResource ModalBackdropBrush}" Visibility="{Binding IsVoidDialogVisible, Converter={StaticResource BooleanToVisibilityConverter}}" Panel.ZIndex="100">
            <Border Style="{StaticResource SurfaceCardStyle}" Width="360" CornerRadius="{StaticResource RadiusMedium}" Padding="24" HorizontalAlignment="Center" VerticalAlignment="Center">
                <StackPanel>
                    <TextBlock Text="Void Invoice &amp; Refund" FontWeight="Bold" FontSize="15" Margin="0,0,0,8"/>
                    <TextBlock Text="Voiding this invoice will cancel the transaction and automatically issue a full refund for all collected amounts." Foreground="{DynamicResource AccentDangerBrush}" FontSize="11" TextWrapping="Wrap" Margin="0,0,0,12"/>

                    <TextBlock Text="Mandatory Cancellation Reason:" FontSize="11" FontWeight="SemiBold" Margin="0,0,0,4"/>
                    <TextBox Text="{Binding VoidInputReason, UpdateSourceTrigger=PropertyChanged}" Height="60" TextWrapping="Wrap" AcceptsReturn="True" Margin="0,0,0,16"/>

                    <Grid>
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="*"/>
                            <ColumnDefinition Width="*"/>
                        </Grid.ColumnDefinitions>
                        <ui:Button Grid.Column="0" Command="{Binding CloseVoidDialogCommand}" Content="Cancel" MinHeight="36" Margin="0,0,4,0" Background="{DynamicResource NeutralSurfaceBrush}"/>
                        <ui:Button Grid.Column="1" Command="{Binding SubmitVoidCommand}" Content="Confirm Void" MinHeight="36" Margin="4,0,0,0" Background="{DynamicResource AccentDangerBrush}" Foreground="{DynamicResource AccentTextBrush}" FontWeight="Bold"/>
                    </Grid>
                </StackPanel>
            </Border>
        </Border>

        <!-- Status -->
        <Border Grid.Row="4" Style="{DynamicResource SurfaceCardStyle}" Padding="16,10" Margin="0,16,0,0">
            <Grid>
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="*"/>
                    <ColumnDefinition Width="Auto"/>
                </Grid.ColumnDefinitions>
                <TextBlock Grid.Column="0" Text="{Binding StatusMessage}" Foreground="{DynamicResource TextPrimaryBrush}" FontWeight="Medium" VerticalAlignment="Center"/>
                <ProgressBar Grid.Column="1" IsIndeterminate="True" Width="100" Height="6" Visibility="{Binding IsBusy, Converter={StaticResource BooleanToVisibilityConverter}}" VerticalAlignment="Center"/>
            </Grid>
        </Border>
    </Grid>
</UserControl>