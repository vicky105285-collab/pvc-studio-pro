<UserControl x:Class="PVCStudioPro.App.Views.CalibrationView"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006" 
             xmlns:d="http://schemas.microsoft.com/expression/blend/2008" 
             xmlns:ui="http://schemas.lepo.co/wpfui/2022/xaml"
             mc:Ignorable="d" 
             d:DesignHeight="760" d:DesignWidth="1180">
    <Grid Margin="24">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="*"/>
            <RowDefinition Height="Auto"/>
        </Grid.RowDefinitions>

        <!-- Header -->
        <Border Grid.Row="0" Style="{DynamicResource SurfaceCardStyle}" Margin="0,0,0,16">
            <Grid>
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="*"/>
                    <ColumnDefinition Width="Auto"/>
                </Grid.ColumnDefinitions>
                <StackPanel Grid.Column="0">
                    <TextBlock Text="{DynamicResource CalibHeader}" FontSize="18" FontWeight="Bold" Foreground="{DynamicResource TextPrimaryBrush}"/>
                    <TextBlock Text="{DynamicResource CalibInstructions}" Foreground="{DynamicResource TextSecondaryBrush}" Margin="0,4,0,0" TextWrapping="Wrap"/>
                </StackPanel>
                <Border Grid.Column="1" Background="{DynamicResource NeutralSurfaceBrush}" CornerRadius="6" Padding="12,6" VerticalAlignment="Center">
                    <StackPanel Orientation="Horizontal">
                        <ui:SymbolIcon Symbol="ShieldCheckmark24" Foreground="{DynamicResource BrandSuccessBrush}" Margin="0,0,6,0"/>
                        <TextBlock Text="Precision: ±0.05 mm" FontWeight="SemiBold" Foreground="{DynamicResource TextPrimaryBrush}" VerticalAlignment="Center"/>
                    </StackPanel>
                </Border>
            </Grid>
        </Border>

        <!-- Main Workspace -->
        <Grid Grid.Row="1">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="*"/>
                <ColumnDefinition Width="420"/>
            </Grid.ColumnDefinitions>

            <!-- Left: Caliper Guide & Dynamic Card Alignment Simulator -->
            <Border Grid.Column="0" Style="{DynamicResource SurfaceCardStyle}" Margin="0,0,16,0">
                <Grid>
                    <Grid.RowDefinitions>
                        <RowDefinition Height="Auto"/>
                        <RowDefinition Height="280"/>
                        <RowDefinition Height="*"/>
                    </Grid.RowDefinitions>

                    <TextBlock Grid.Row="0" Text="PHYSICAL REGISTRATION STAGE (CR80 TRAY HOLDER)" FontWeight="Bold" Foreground="{DynamicResource BrandPrimaryBrush}" Margin="0,0,0,12"/>

                    <!-- Visual Card Shift Simulator -->
                    <Border Grid.Row="1" Background="{DynamicResource CanvasBackgroundBrush}" BorderBrush="{DynamicResource SurfaceBorderBrush}" BorderThickness="1" CornerRadius="8" Padding="16">
                        <Grid>
                            <!-- Tray Pocket Outline (Simulated CR80: 85.60 x 53.98 mm) -->
                            <Rectangle Width="260" Height="164" RadiusX="8" RadiusY="8" Stroke="#94A3B8" StrokeThickness="2" StrokeDashArray="4 2" Fill="#F1F5F9" HorizontalAlignment="Center" VerticalAlignment="Center"/>
                            <TextBlock Text="Physical Tray Pocket" Foreground="#94A3B8" FontSize="10" HorizontalAlignment="Center" VerticalAlignment="Bottom" Margin="0,0,0,38"/>

                            <!-- Shifted Printed Card Contour (Reacts to Offset) -->
                            <Rectangle Width="260" Height="164" RadiusX="8" RadiusY="8" Stroke="#0067B8" StrokeThickness="2" Fill="#FFFFFF" Opacity="0.85" HorizontalAlignment="Center" VerticalAlignment="Center">
                                <Rectangle.RenderTransform>
                                    <!-- Scale mm to screen pixels: 1mm ~ 3px -->
                                    <TranslateTransform X="{Binding OffsetX}" Y="{Binding OffsetY}"/>
                                </Rectangle.RenderTransform>
                            </Rectangle>

                            <!-- Center Crosshair -->
                            <Line X1="0" Y1="124" X2="500" Y2="124" Stroke="#EF4444" StrokeThickness="1" StrokeDashArray="3 3"/>
                            <Line X1="260" Y1="0" X2="260" Y2="250" Stroke="#EF4444" StrokeThickness="1" StrokeDashArray="3 3"/>

                            <Border Background="#FEF2F2" BorderBrush="#FECACA" BorderThickness="1" CornerRadius="4" Padding="6,2" HorizontalAlignment="Right" VerticalAlignment="Top">
                                <TextBlock Text="Red: Printable Beam Center | Blue: Offset Registration" Foreground="#991B1B" FontSize="10"/>
                            </Border>
                        </Grid>
                    </Border>

                    <!-- Calibration Step Instructions -->
                    <StackPanel Grid.Row="2" Margin="0,16,0,0">
                        <TextBlock Text="HOW TO CALIBRATE WITH A VERNIER CALIPER:" FontWeight="Bold" Foreground="{DynamicResource TextPrimaryBrush}" Margin="0,0,0,8"/>

                        <Border Background="{DynamicResource NeutralSurfaceBrush}" CornerRadius="6" Padding="12" Margin="0,0,0,8">
                            <StackPanel>
                                <TextBlock Text="1. Spool Calibration Sheet" FontWeight="SemiBold" Foreground="{DynamicResource TextPrimaryBrush}"/>
                                <TextBlock Text="Insert your 2-card PVC tray loaded with blank test cards. Click 'Print Calibration Sheet'." Foreground="{DynamicResource TextSecondaryBrush}" FontSize="11" Margin="0,2,0,0"/>
                            </StackPanel>
                        </Border>

                        <Border Background="{DynamicResource NeutralSurfaceBrush}" CornerRadius="6" Padding="12" Margin="0,0,0,8">
                            <StackPanel>
                                <TextBlock Text="2. Measure Edge Borders with Caliper" FontWeight="SemiBold" Foreground="{DynamicResource TextPrimaryBrush}"/>
                                <TextBlock Text="Measure the white margin between the printed outer border and physical card edge on Left vs Right, and Top vs Bottom." Foreground="{DynamicResource TextSecondaryBrush}" FontSize="11" Margin="0,2,0,0"/>
                            </StackPanel>
                        </Border>

                        <Border Background="{DynamicResource NeutralSurfaceBrush}" CornerRadius="6" Padding="12">
                            <StackPanel>
                                <TextBlock Text="3. Adjust &amp; Persist" FontWeight="SemiBold" Foreground="{DynamicResource TextPrimaryBrush}"/>
                                <TextBlock Text="If print is 0.4 mm too far to the left, add +0.40 mm to Offset X. Check 'Physically Verified' and click Save." Foreground="{DynamicResource TextSecondaryBrush}" FontSize="11" Margin="0,2,0,0"/>
                            </StackPanel>
                        </Border>
                    </StackPanel>
                </Grid>
            </Border>

            <!-- Right: Calibration Controls & Nudging -->
            <Border Grid.Column="1" Style="{DynamicResource SurfaceCardStyle}">
                <ScrollViewer VerticalScrollBarVisibility="Auto">
                    <StackPanel>
                        <TextBlock Text="PRINTER &amp; TRAY HARDWARE PROFILE" FontWeight="Bold" Foreground="{DynamicResource TextPrimaryBrush}" Margin="0,0,0,16"/>

                        <!-- Printer Selection -->
                        <TextBlock Text="{DynamicResource LblPrinterDevice}" Style="{DynamicResource FormLabelStyle}"/>
                        <ComboBox ItemsSource="{Binding PrinterList}" SelectedItem="{Binding SelectedPrinter}" Height="38" Margin="0,0,0,12"/>

                        <!-- Tray Selection -->
                        <TextBlock Text="{DynamicResource LblMediaTray}" Style="{DynamicResource FormLabelStyle}"/>
                        <ComboBox ItemsSource="{Binding TrayList}" SelectedItem="{Binding SelectedTray}" Height="38" Margin="0,0,0,20"/>

                        <!-- Horizontal Offset X Section -->
                        <Border Background="{DynamicResource NeutralSurfaceBrush}" CornerRadius="6" Padding="12" Margin="0,0,0,14">
                            <StackPanel>
                                <Grid>
                                    <Grid.ColumnDefinitions>
                                        <ColumnDefinition Width="*"/>
                                        <ColumnDefinition Width="Auto"/>
                                    </Grid.ColumnDefinitions>
                                    <TextBlock Grid.Column="0" Text="{DynamicResource LblOffsetX}" FontWeight="SemiBold" Foreground="{DynamicResource TextPrimaryBrush}"/>
                                    <TextBlock Grid.Column="1" Text="{Binding OffsetX, StringFormat='{}{0:F2} mm'}" FontWeight="Bold" Foreground="{DynamicResource BrandPrimaryBrush}"/>
                                </Grid>

                                <Slider Minimum="-10.0" Maximum="10.0" Value="{Binding OffsetX}" TickFrequency="0.1" IsSnapToTickEnabled="True" Margin="0,8,0,8"/>

                                <!-- Nudge Buttons -->
                                <UniformGrid Columns="4" Margin="0,2,0,0">
                                    <ui:Button Command="{Binding NudgeOffsetCommand}" CommandParameter="LEFT" Content="-0.10" Height="28" Margin="0,0,2,0"/>
                                    <ui:Button Command="{Binding NudgeOffsetCommand}" CommandParameter="RIGHT" Content="+0.10" Height="28" Margin="2,0,2,0"/>
                                    <ui:Button Command="{Binding NudgeOffsetCommand}" CommandParameter="RESET" Content="Zero" Height="28" Margin="2,0,2,0"/>
                                    <TextBox Text="{Binding OffsetX, StringFormat=F2, UpdateSourceTrigger=PropertyChanged}" Height="28" VerticalContentAlignment="Center" HorizontalContentAlignment="Center" Margin="2,0,0,0"/>
                                </UniformGrid>
                            </StackPanel>
                        </Border>

                        <!-- Vertical Offset Y Section -->
                        <Border Background="{DynamicResource NeutralSurfaceBrush}" CornerRadius="6" Padding="12" Margin="0,0,0,16">
                            <StackPanel>
                                <Grid>
                                    <Grid.ColumnDefinitions>
                                        <ColumnDefinition Width="*"/>
                                        <ColumnDefinition Width="Auto"/>
                                    </Grid.ColumnDefinitions>
                                    <TextBlock Grid.Column="0" Text="{DynamicResource LblOffsetY}" FontWeight="SemiBold" Foreground="{DynamicResource TextPrimaryBrush}"/>
                                    <TextBlock Grid.Column="1" Text="{Binding OffsetY, StringFormat='{}{0:F2} mm'}" FontWeight="Bold" Foreground="{DynamicResource BrandPrimaryBrush}"/>
                                </Grid>

                                <Slider Minimum="-10.0" Maximum="10.0" Value="{Binding OffsetY}" TickFrequency="0.1" IsSnapToTickEnabled="True" Margin="0,8,0,8"/>

                                <!-- Nudge Buttons -->
                                <UniformGrid Columns="4" Margin="0,2,0,0">
                                    <ui:Button Command="{Binding NudgeOffsetCommand}" CommandParameter="UP" Content="-0.10" Height="28" Margin="0,0,2,0"/>
                                    <ui:Button Command="{Binding NudgeOffsetCommand}" CommandParameter="DOWN" Content="+0.10" Height="28" Margin="2,0,2,0"/>
                                    <ui:Button Command="{Binding NudgeOffsetCommand}" CommandParameter="RESET" Content="Zero" Height="28" Margin="2,0,2,0"/>
                                    <TextBox Text="{Binding OffsetY, StringFormat=F2, UpdateSourceTrigger=PropertyChanged}" Height="28" VerticalContentAlignment="Center" HorizontalContentAlignment="Center" Margin="2,0,0,0"/>
                                </UniformGrid>
                            </StackPanel>
                        </Border>

                        <!-- Physical Verification Gate Checkbox -->
                        <CheckBox IsChecked="{Binding IsPhysicallyVerified}" Margin="0,0,0,20">
                            <TextBlock Text="Physically verified with test print &amp; caliper (Production Ready)" TextWrapping="Wrap" FontWeight="SemiBold"/>
                        </CheckBox>

                        <!-- Print Test Sheet Action -->
                        <ui:Button Command="{Binding PrintTestSheetCommand}" Height="44" Style="{DynamicResource PrimaryActionButtonStyle}" Margin="0,0,0,10">
                            <StackPanel Orientation="Horizontal">
                                <ui:SymbolIcon Symbol="Print24" Margin="0,0,8,0"/>
                                <TextBlock Text="{DynamicResource BtnPrintCalibSheet}" VerticalAlignment="Center" FontWeight="Bold"/>
                            </StackPanel>
                        </ui:Button>

                        <!-- Save Calibration Action -->
                        <ui:Button Command="{Binding SaveCalibrationCommand}" Height="40" Background="{DynamicResource NeutralSurfaceBrush}">
                            <StackPanel Orientation="Horizontal">
                                <ui:SymbolIcon Symbol="Save24" Margin="0,0,8,0"/>
                                <TextBlock Text="{DynamicResource BtnSaveCalibration}" VerticalAlignment="Center" FontWeight="SemiBold"/>
                            </StackPanel>
                        </ui:Button>
                    </StackPanel>
                </ScrollViewer>
            </Border>
        </Grid>

        <!-- Status Bar -->
        <Border Grid.Row="2" Style="{DynamicResource SurfaceCardStyle}" Padding="12,8" Margin="0,16,0,0">
            <Grid>
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="*"/>
                    <ColumnDefinition Width="Auto"/>
                </Grid.ColumnDefinitions>
                <TextBlock Grid.Column="0" Text="{Binding StatusMessage}" Foreground="{DynamicResource TextPrimaryBrush}" FontWeight="Medium" VerticalAlignment="Center"/>
                <ProgressBar Grid.Column="1" IsIndeterminate="True" Width="100" Height="6" Visibility="{Binding IsBusy, Converter={StaticResource BooleanToVisibilityConverter}}" VerticalAlignment="Center"/>
            </Grid>
        </Border>
    </Grid>
</UserControl>
