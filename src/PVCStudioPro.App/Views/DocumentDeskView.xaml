<UserControl x:Class="PVCStudioPro.App.Views.DocumentDeskView"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
             xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
             xmlns:ui="http://schemas.lepo.co/wpfui/2022/xaml"
             xmlns:vm="clr-namespace:PVCStudioPro.App.ViewModels"
             mc:Ignorable="d" 
             d:DataContext="{d:DesignInstance Type=vm:DocumentDeskViewModel}"
             d:DesignHeight="850" d:DesignWidth="1200"
             AllowDrop="True"
             Drop="UserControl_Drop"
             DragOver="UserControl_DragOver">

    <Grid Margin="16,8,16,16">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto"/> <!-- Header & Action Bar -->
            <RowDefinition Height="Auto"/> <!-- Sniffed Document Strip -->
            <RowDefinition Height="Auto"/> <!-- Password Prompt (Conditional) -->
            <RowDefinition Height="*"/>    <!-- Main Visualizer & Cards Split View -->
            <RowDefinition Height="Auto"/> <!-- Status Bar -->
        </Grid.RowDefinitions>

        <!-- ROW 0: Workspace Header & Primary File Action Bar -->
        <Border Grid.Row="0" Background="{DynamicResource NeutralSurfaceBrush}" BorderBrush="{DynamicResource NeutralBorderBrush}" BorderThickness="1" CornerRadius="8" Padding="16,12" Margin="0,0,0,12">
            <Grid>
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="*"/>
                    <ColumnDefinition Width="Auto"/>
                </Grid.ColumnDefinitions>

                <StackPanel Grid.Column="0" VerticalAlignment="Center">
                    <StackPanel Orientation="Horizontal" Margin="0,0,0,4">
                        <TextBlock Text="Universal Document Desk" FontSize="20" FontWeight="Bold" Foreground="{DynamicResource TextPrimaryBrush}" Margin="0,0,12,0"/>
                        <Border Background="{DynamicResource StatusInfoBgBrush}" BorderBrush="{DynamicResource NeutralBorderBrush}" BorderThickness="1" CornerRadius="4" Padding="8,2">
                            <TextBlock Text="{Binding MagicFormatBadge}" FontSize="11" FontWeight="Bold" Foreground="{DynamicResource StatusInfoFgBrush}"/>
                        </Border>
                    </StackPanel>
                    <TextBlock Text="Import official citizen PDFs, mobile camera photos, scanned certificates &amp; office documents (Zero-Citizen-PII Pipeline)" FontSize="12" Foreground="{DynamicResource TextSecondaryBrush}"/>
                </StackPanel>

                <!-- Action Buttons -->
                <StackPanel Grid.Column="1" Orientation="Horizontal" VerticalAlignment="Center">
                    <ui:Button Command="{Binding BrowseFileCommand}" Content="Browse Document (Ctrl+O)" Height="36" Padding="14,0" FontWeight="SemiBold" CornerRadius="4" Margin="0,0,8,0">
                        <ui:Button.Icon>
                            <ui:SymbolIcon Symbol="FolderOpen24"/>
                        </ui:Button.Icon>
                    </ui:Button>

                    <ui:Button Command="{Binding PasteFromClipboardCommand}" Content="Paste Image (Ctrl+V)" Height="36" Padding="14,0" FontWeight="SemiBold" CornerRadius="4" Margin="0,0,8,0">
                        <ui:Button.Icon>
                            <ui:SymbolIcon Symbol="ClipboardPaste24"/>
                        </ui:Button.Icon>
                    </ui:Button>

                    <ui:Button Command="{Binding OpenCropStudioCommand}" Content="Crop Studio" Height="36" Padding="14,0" FontWeight="SemiBold" CornerRadius="4" Background="{DynamicResource CardSurfaceBrush}" BorderBrush="{DynamicResource NeutralBorderBrush}" BorderThickness="1" Margin="0,0,8,0">
                        <ui:Button.Icon>
                            <ui:SymbolIcon Symbol="Crop24"/>
                        </ui:Button.Icon>
                    </ui:Button>

                    <ui:Button Command="{Binding OpenPageDesignerCommand}" Content="Page Designer" Height="36" Padding="14,0" FontWeight="SemiBold" CornerRadius="4" Background="{DynamicResource CardSurfaceBrush}" BorderBrush="{DynamicResource NeutralBorderBrush}" BorderThickness="1">
                        <ui:Button.Icon>
                            <ui:SymbolIcon Symbol="DesignIdeas24"/>
                        </ui:Button.Icon>
                    </ui:Button>
                </StackPanel>
            </Grid>
        </Border>

        <!-- ROW 1: Document Sniff & Metadata Inspection Strip -->
        <Border Grid.Row="1" Background="{DynamicResource CardSurfaceBrush}" BorderBrush="{DynamicResource NeutralBorderBrush}" BorderThickness="1" CornerRadius="6" Padding="14,10" Margin="0,0,0,12" Visibility="{Binding IsFileLoaded, Converter={StaticResource BooleanToVisibilityConverter}}">
            <Grid>
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="Auto"/>
                    <ColumnDefinition Width="*"/>
                    <ColumnDefinition Width="Auto"/>
                </Grid.ColumnDefinitions>

                <StackPanel Grid.Column="0" Orientation="Horizontal" VerticalAlignment="Center" Margin="0,0,20,0">
                    <TextBlock Text="📄" FontSize="18" Margin="0,0,8,0" VerticalAlignment="Center"/>
                    <StackPanel>
                        <TextBlock Text="{Binding FileName}" FontWeight="Bold" FontSize="13" Foreground="{DynamicResource TextPrimaryBrush}"/>
                        <TextBlock Text="{Binding FileSizeText}" FontSize="11" Foreground="{DynamicResource TextSecondaryBrush}"/>
                    </StackPanel>
                </StackPanel>

                <StackPanel Grid.Column="1" VerticalAlignment="Center">
                    <StackPanel Orientation="Horizontal" Margin="0,0,0,2">
                        <TextBlock Text="Detected: " FontWeight="SemiBold" FontSize="12" Foreground="{DynamicResource TextSecondaryBrush}"/>
                        <TextBlock Text="{Binding DetectedDocumentTitle}" FontWeight="Bold" FontSize="12" Foreground="{DynamicResource PrimaryAccentBrush}" Margin="0,0,8,0"/>
                        <Border Background="{DynamicResource NeutralSurfaceBrush}" BorderBrush="{DynamicResource NeutralBorderBrush}" BorderThickness="1" CornerRadius="4" Padding="6,1">
                            <TextBlock Text="{Binding DetectionConfidenceText}" FontSize="10" FontWeight="Bold" Foreground="{DynamicResource TextPrimaryBrush}"/>
                        </Border>
                    </StackPanel>
                    <TextBlock Text="{Binding DetectionNotes}" FontSize="11" Foreground="{DynamicResource TextSecondaryBrush}"/>
                </StackPanel>

                <StackPanel Grid.Column="2" Orientation="Horizontal" VerticalAlignment="Center">
                    <ui:Button Command="{Binding AutoExtractCardsCommand}" Content="Re-Extract Cards" Height="30" Padding="10,0" FontSize="11" FontWeight="SemiBold" CornerRadius="4" Margin="0,0,8,0"/>
                    <ui:Button Command="{Binding RotateCardsCommand}" Content="Rotate 90°" Height="30" Padding="10,0" FontSize="11" FontWeight="SemiBold" CornerRadius="4"/>
                </StackPanel>
            </Grid>
        </Border>

        <!-- ROW 2: Decryption & Password Handling Bar -->
        <Border Grid.Row="2" Background="{DynamicResource StatusWarningBgBrush}" BorderBrush="{DynamicResource StatusWarningFgBrush}" BorderThickness="1" CornerRadius="6" Padding="14,10" Margin="0,0,0,12" Visibility="{Binding IsPasswordRequired, Converter={StaticResource BooleanToVisibilityConverter}}">
            <StackPanel>
                <Grid>
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="Auto"/>
                        <ColumnDefinition Width="*"/>
                        <ColumnDefinition Width="Auto"/>
                        <ColumnDefinition Width="Auto"/>
                    </Grid.ColumnDefinitions>

                    <StackPanel Grid.Column="0" Orientation="Horizontal" VerticalAlignment="Center" Margin="0,0,14,0">
                        <TextBlock Text="🔒" FontSize="16" Margin="0,0,6,0" VerticalAlignment="Center"/>
                        <TextBlock Text="Document is Password Protected:" FontWeight="Bold" Foreground="{DynamicResource StatusWarningFgBrush}" VerticalAlignment="Center"/>
                    </StackPanel>

                    <!-- Password input -->
                    <TextBox Grid.Column="1" Text="{Binding PasswordInput, UpdateSourceTrigger=PropertyChanged}" Height="34" VerticalContentAlignment="Center" Padding="8,0" Margin="0,0,8,0" FontFamily="Consolas" FontSize="13"/>

                    <ui:Button Grid.Column="2" Command="{Binding TogglePasswordMaskCommand}" Content="Show/Hide" Height="34" Padding="10,0" CornerRadius="4" Margin="0,0,8,0" Background="{DynamicResource NeutralSurfaceBrush}" Foreground="{DynamicResource TextPrimaryBrush}"/>
                    <ui:Button Grid.Column="3" Command="{Binding UnlockPasswordCommand}" Content="Unlock Document" Height="34" Padding="16,0" FontWeight="Bold" CornerRadius="4" Background="{DynamicResource PrimaryAccentBrush}" Foreground="{DynamicResource AccentTextBrush}"/>
                </Grid>

                <TextBlock Text="💡 UIDAI e-Aadhaar Standard Format: First 4 letters of Name in CAPITAL LETTERS + Year of Birth (YYYY), e.g. SURE1985" FontSize="11" Foreground="{DynamicResource StatusWarningFgBrush}" Margin="32,4,0,0"/>

                <TextBlock Text="{Binding PasswordErrorMessage}" FontWeight="SemiBold" FontSize="11" Foreground="{DynamicResource StatusErrorFgBrush}" Margin="32,2,0,0" Visibility="{Binding HasPasswordError, Converter={StaticResource BooleanToVisibilityConverter}}"/>
            </StackPanel>
        </Border>

        <!-- ROW 3: Main Workspace Split View (Full Document Visualizer + Extracted Cards Production) -->
        <Grid Grid.Row="3">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="5*"/> <!-- Left: Document Page Inspector -->
                <ColumnDefinition Width="12"/> <!-- Splitter -->
                <ColumnDefinition Width="6*"/> <!-- Right: Extracted Cards Production -->
            </Grid.ColumnDefinitions>

            <!-- LEFT: Document Page Inspector -->
            <Border Grid.Column="0" Background="{DynamicResource CardSurfaceBrush}" BorderBrush="{DynamicResource NeutralBorderBrush}" BorderThickness="1" CornerRadius="8" Padding="14">
                <Grid>
                    <Grid.RowDefinitions>
                        <RowDefinition Height="Auto"/>
                        <RowDefinition Height="*"/>
                    </Grid.RowDefinitions>

                    <Grid Grid.Row="0" Margin="0,0,0,10">
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="*"/>
                            <ColumnDefinition Width="Auto"/>
                        </Grid.ColumnDefinitions>
                        <TextBlock Grid.Column="0" Text="Document Page Visualizer" FontWeight="Bold" FontSize="13" Foreground="{DynamicResource TextPrimaryBrush}"/>
                        <TextBlock Grid.Column="1" Text="Vector 300 DPI Inspection" FontSize="11" Foreground="{DynamicResource TextSecondaryBrush}"/>
                    </Grid>

                    <!-- Image Display or Empty Drag/Drop Zone -->
                    <Border Grid.Row="1" Background="{DynamicResource PreviewCanvasBgBrush}" BorderBrush="{DynamicResource NeutralBorderBrush}" BorderThickness="1" CornerRadius="6" ClipToBounds="True">
                        <Grid>
                            <!-- Empty State Callout -->
                            <StackPanel HorizontalAlignment="Center" VerticalAlignment="Center" Visibility="{Binding IsFileLoaded, Converter={StaticResource BooleanToVisibilityConverter}, ConverterParameter=Inverse}">
                                <TextBlock Text="📥" FontSize="48" HorizontalAlignment="Center" Margin="0,0,0,12"/>
                                <TextBlock Text="Drag and Drop Any Document Here" FontSize="16" FontWeight="Bold" Foreground="{DynamicResource TextPrimaryBrush}" HorizontalAlignment="Center" Margin="0,0,0,6"/>
                                <TextBlock Text="Supports PDF, DOCX, DOC, RTF, TXT, JPG, PNG, WEBP, BMP" FontSize="12" Foreground="{DynamicResource TextSecondaryBrush}" HorizontalAlignment="Center" Margin="0,0,0,16"/>
                                <ui:Button Command="{Binding BrowseFileCommand}" Content="Browse Local Files" HorizontalAlignment="Center" Padding="16,8" FontWeight="SemiBold"/>
                            </StackPanel>

                            <!-- Loaded Document Image Viewer -->
                            <ScrollViewer HorizontalScrollBarVisibility="Auto" VerticalScrollBarVisibility="Auto" Visibility="{Binding IsFileLoaded, Converter={StaticResource BooleanToVisibilityConverter}}">
                                <Image Source="{Binding RawPageImage}" Stretch="Uniform" Margin="8"/>
                            </ScrollViewer>
                        </Grid>
                    </Border>
                </Grid>
            </Border>

            <!-- GridSplitter -->
            <GridSplitter Grid.Column="1" Width="4" HorizontalAlignment="Center" VerticalAlignment="Stretch" Background="Transparent"/>

            <!-- RIGHT: Extracted Cards & Print Bridge -->
            <Border Grid.Column="2" Background="{DynamicResource CardSurfaceBrush}" BorderBrush="{DynamicResource NeutralBorderBrush}" BorderThickness="1" CornerRadius="8" Padding="14">
                <Grid>
                    <Grid.RowDefinitions>
                        <RowDefinition Height="Auto"/>
                        <RowDefinition Height="*"/>
                        <RowDefinition Height="Auto"/>
                        <RowDefinition Height="Auto"/>
                    </Grid.RowDefinitions>

                    <!-- Extracted Cards Header -->
                    <Grid Grid.Row="0" Margin="0,0,0,10">
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="*"/>
                            <ColumnDefinition Width="Auto"/>
                        </Grid.ColumnDefinitions>
                        <TextBlock Grid.Column="0" Text="Extracted Identity Cards (Standard CR80 85.60 × 53.98 mm)" FontWeight="Bold" FontSize="13" Foreground="{DynamicResource TextPrimaryBrush}"/>
                        <StackPanel Grid.Column="1" Orientation="Horizontal">
                            <ui:Button Command="{Binding SwapFacesCommand}" Content="Swap Front/Back" Height="26" Padding="8,0" FontSize="11" CornerRadius="3" Margin="0,0,6,0" Visibility="{Binding HasBackCard, Converter={StaticResource BooleanToVisibilityConverter}}"/>
                            <ui:Button Command="{Binding ToggleMaskAadhaarCommand}" Content="Mask Aadhaar (UIDAI)" Height="26" Padding="8,0" FontSize="11" CornerRadius="3" Background="{DynamicResource StatusWarningBgBrush}" Foreground="{DynamicResource StatusWarningFgBrush}"/>
                        </StackPanel>
                    </Grid>

                    <!-- Extracted Cards Preview ScrollViewer -->
                    <ScrollViewer Grid.Row="1" VerticalScrollBarVisibility="Auto" Margin="0,0,0,10">
                        <StackPanel>
                            <!-- FRONT CARD -->
                            <Border Background="{DynamicResource NeutralSurfaceBrush}" BorderBrush="{DynamicResource NeutralBorderBrush}" BorderThickness="1" CornerRadius="6" Padding="10" Margin="0,0,0,12">
                                <StackPanel>
                                    <Grid Margin="0,0,0,6">
                                        <TextBlock Text="FRONT FACE (Slot 1)" FontWeight="Bold" FontSize="11" Foreground="{DynamicResource TextSecondaryBrush}"/>
                                        <TextBlock Text="CR80 • 2022 × 1275 px @ 600 DPI" FontSize="10" Foreground="{DynamicResource TextSecondaryBrush}" HorizontalAlignment="Right"/>
                                    </Grid>
                                    <Border BorderBrush="{DynamicResource PrimaryAccentBrush}" BorderThickness="2" CornerRadius="6" Background="White" ClipToBounds="True">
                                        <Image Source="{Binding FrontCardImage}" Height="165" Stretch="Uniform" Margin="4"/>
                                    </Border>
                                </StackPanel>
                            </Border>

                            <!-- BACK CARD (Conditional) -->
                            <Border Background="{DynamicResource NeutralSurfaceBrush}" BorderBrush="{DynamicResource NeutralBorderBrush}" BorderThickness="1" CornerRadius="6" Padding="10" Visibility="{Binding HasBackCard, Converter={StaticResource BooleanToVisibilityConverter}}">
                                <StackPanel>
                                    <Grid Margin="0,0,0,6">
                                        <TextBlock Text="BACK FACE (Slot 2)" FontWeight="Bold" FontSize="11" Foreground="{DynamicResource TextSecondaryBrush}"/>
                                        <TextBlock Text="CR80 • 2022 × 1275 px @ 600 DPI" FontSize="10" Foreground="{DynamicResource TextSecondaryBrush}" HorizontalAlignment="Right"/>
                                    </Grid>
                                    <Border BorderBrush="#8B5CF6" BorderThickness="2" CornerRadius="6" Background="White" ClipToBounds="True">
                                        <Image Source="{Binding BackCardImage}" Height="165" Stretch="Uniform" Margin="4"/>
                                    </Border>
                                </StackPanel>
                            </Border>
                        </StackPanel>
                    </ScrollViewer>

                    <!-- Manual Crop Studio Quick Trigger -->
                    <Border Grid.Row="2" Background="{DynamicResource StatusSuccessBgBrush}" BorderBrush="{DynamicResource NeutralBorderBrush}" BorderThickness="1" CornerRadius="6" Padding="12,8" Margin="0,0,0,10">
                        <Grid>
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="*"/>
                                <ColumnDefinition Width="Auto"/>
                            </Grid.ColumnDefinitions>
                            <StackPanel Grid.Column="0" VerticalAlignment="Center">
                                <TextBlock Text="Need custom crop, zoom/pan or camera deskew?" FontWeight="Bold" FontSize="12" Foreground="{DynamicResource StatusSuccessFgBrush}"/>
                                <TextBlock Text="Open Crop Studio to adjust zoom, drag crop handles, or apply image enhancements." FontSize="11" Foreground="{DynamicResource StatusSuccessFgBrush}"/>
                            </StackPanel>
                            <ui:Button Grid.Column="1" Command="{Binding OpenCropStudioCommand}" Content="Open Crop Studio" Height="30" Padding="12,0" FontWeight="SemiBold" CornerRadius="4" Background="{DynamicResource PrimaryAccentBrush}" Foreground="{DynamicResource AccentTextBrush}"/>
                        </Grid>
                    </Border>

                    <!-- Dual Action Buttons: Page Designer + Hero Print Preview Gate -->
                    <Grid Grid.Row="3">
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="*"/>
                            <ColumnDefinition Width="8"/>
                            <ColumnDefinition Width="2*"/>
                        </Grid.ColumnDefinitions>
                        <ui:Button Grid.Column="0" Command="{Binding OpenPageDesignerCommand}" Style="{StaticResource SecondaryActionButtonStyle}" Height="48" IsEnabled="{Binding HasCardsExtracted}">
                            <StackPanel Orientation="Horizontal">
                                <ui:SymbolIcon Symbol="DesignIdeas24" Margin="0,0,8,0"/>
                                <TextBlock Text="PAGE DESIGNER"/>
                            </StackPanel>
                        </ui:Button>
                        <ui:Button Grid.Column="2" Command="{Binding ApproveAndPrintCommand}" Style="{StaticResource PrimaryActionButtonStyle}" Height="48" FontWeight="Bold" FontSize="13" IsEnabled="{Binding HasCardsExtracted}">
                            <StackPanel Orientation="Horizontal">
                                <ui:SymbolIcon Symbol="Print24" Margin="0,0,8,0"/>
                                <TextBlock Text="PRINT PREVIEW &amp; APPROVAL GATE"/>
                            </StackPanel>
                        </ui:Button>
                    </Grid>
                </Grid>
            </Border>
        </Grid>

        <!-- ROW 4: Status Bar -->
        <Border Grid.Row="4" Background="{DynamicResource NeutralSurfaceBrush}" CornerRadius="4" Padding="10,6" Margin="0,10,0,0">
            <Grid>
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="*"/>
                    <ColumnDefinition Width="Auto"/>
                </Grid.ColumnDefinitions>
                <TextBlock Grid.Column="0" Text="{Binding StatusMessage}" FontSize="11" Foreground="{DynamicResource TextSecondaryBrush}" VerticalAlignment="Center"/>
                <TextBlock Grid.Column="1" Text="Local Processing • Zero Citizen PII Retention" FontSize="11" FontWeight="SemiBold" Foreground="{DynamicResource StatusSuccessFgBrush}" VerticalAlignment="Center"/>
            </Grid>
        </Border>
    </Grid>
</UserControl>
